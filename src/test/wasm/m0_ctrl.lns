// M0: 論理演算・比較・制御構文
fn check( n:int ):str {
   if n < 0 {
      return "neg";
   }
   elseif n == 0 {
      return "zero";
   }
   elseif n < 10 and n ~= 5 {
      return "small";
   }
   else {
      return "other";
   }
}
print( check( -3 ), check( 0 ), check( 3 ), check( 5 ), check( 30 ) );
let t = check( 1 ) == "small";
let f = check( 0 ) == "small";
print( t and f, t or f, not t, t == f, t ~= f, f or not f );
let one = 1;
print( one == 1, one ~= 1 );
let mut count = 0;
while true {
   count = count + 1;
   if count >= 5 {
      break;
   }
}
print( "while", count );
let mut n = 0;
repeat {
   n = n + 3;
} n > 10;
print( "repeat", n );
for i = 10, 1, -3 {
   print( "for", i );
}
for i = 1, 3 {
   for j = 1, 3 {
      if j == 2 {
         break;
      }
      print( "nest", i, j );
   }
}
let mut k = 0;
while k < 3 {
   k = k + 1;
}
print( "k", k );
// 条件に and を使った while (到達不能と誤判定されないこと)
fn countUp( limit:int ):int {
   let mut num = 0;
   while num < 100 and num < limit {
      num = num + 1;
   }
   return num;
}
print( "countUp", countUp( 7 ) );
