// M0: 整数演算と関数
fn fib( n:int ):int {
   if n < 2 {
      return n;
   }
   return fib( n - 1 ) + fib( n - 2 );
}
print( "fib", fib( 20 ) );
print( 7 / 2, -7 / 2, 7 / -2, -7 / -2 );
print( 7 % 3, -7 % 3, 7 % -3, -7 % -3 );
print( 6 & 3, 6 | 3, 6 ~ 3, 1 |<< 10, 1024 |>> 3, ~0 );
print( 9223372036854775807, -9223372036854775807 - 1 );
print( 1 + 2 * 3 - 4, ( 1 + 2 ) * ( 3 - 4 ), -( 5 ) );
let mut total = 0;
for i = 1, 100 {
   total = total + i;
}
print( "sum", total );
