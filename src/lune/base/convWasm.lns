/*
LuneScript の AST を wasm (WasmGC) に変換する。

値の表現とランタイムは WasmRt.lns を参照。

- モジュールレベルの文は "main" 関数 (export) にする。
- モジュールレベルの変数は wasm のグローバル変数にする。
- 関数は、第 1 引数にクロージャ (Rt.tClo の部分型) を受け取る。
  クロージャから参照される変数 ($hasAccessFromClosure) はセルに入れ、
  クロージャはセルへの参照を環境として持つ。
- メソッドは、第 1 引数に self (Rt.tObj の部分型) を受け取る。
  呼び出しは vtable (インタフェースは itable) を経由する。
- 対応していないノードはエラーにする。
*/

_lune_control default_async_all;
_lune_control default_strict_generics;

import lune.base.Ast;
import lune.base.Nodes;
import lune.base.Util;
import lune.base.AstInfo;
import lune.base.Builtin;
import lune.base.WasmBin as W;
import lune.base.WasmRt as Rt;

pub class Opt {
   pub let parent:&Nodes.Node;
   pub fn __init( parent:&Nodes.Node ) {
      self.parent = parent;
   }
}

pub class Option {
   pub fn __init() {
   }
}

/** 比較演算子 → 文字列比較の結果 (i32) と 0 を比べる命令 */
let strCmpOpMap = {
   "~=": W.opI32Ne, "<": W.opI32LtS, "<=": W.opI32LeS, ">": W.opI32GtS, ">=": W.opI32GeS };
let i64CmpOpMap = {
   "==": W.opI64Eq, "~=": W.opI64Ne, "<": W.opI64LtS, "<=": W.opI64LeS,
   ">": W.opI64GtS, ">=": W.opI64GeS };
let f64CmpOpMap = {
   "==": W.opF64Eq, "~=": W.opF64Ne, "<": W.opF64Lt, "<=": W.opF64Le,
   ">": W.opF64Gt, ">=": W.opF64Ge };

fn lg( index:int ) : &W.Ins {
   return W.localGet( index );
}
fn ls( index:int, val:&W.Ins ) : &W.Ins {
   return W.localSet( index, val );
}
fn p( code:int, args:&List<&W.Ins> ) : &W.Ins {
   return W.plain( code, args );
}

/** 変数の格納場所 */
alge VarLoc {
   /** wasm の局所変数 */
   Local( index:int ),
   /** セル (クロージャから参照される変数) を持つ局所変数 */
   CellLocal( index:int ),
   /** クロージャの環境のフィールドにあるセル */
   Captured( field:int ),
   /** wasm のグローバル変数 */
   Global( index:int ),
}

/** 式を評価した値 */
class Val {
   pri let ins:&W.Ins {pub};
   pri let rep:&W.ValType {pub};
   pri let typeInfo:&Ast.TypeInfo {pub};
}

/** メソッドのスロット (vtable のフィールド) */
class SlotInfo {
   pri let name:str {pub};
   /** wasm の関数型 (self + 引数 → 戻り値) */
   pri let funcType:int {pub};
   /** 最初に宣言したメソッドの型 */
   pri let methodType:&Ast.TypeInfo {pub};
   /** 実装の関数インデックス。抽象メソッドは -1 */
   pri let mut impl:int {pub,pub};
}

/** advertise で委譲するメソッド */
class AdvertiseMethod {
   /** 委譲先のメンバの名前と型 */
   pri let memberName:str {pub};
   pri let memberType:&Ast.TypeInfo {pub};
   /** 委譲先のメソッドの名前 */
   pri let methodName:str {pub};
   /** このクラスのメソッドの型と、生成する関数 */
   pri let methodType:&Ast.TypeInfo {pub};
   pri let impl:int {pub};
}

/** クラスの情報 */
class ClassInfo {
   pri let typeInfo:&Ast.TypeInfo {pub};
   pri let structType:int {pub};
   pri let vtType:int {pub};
   pri let vtGlobal:int {pub};
   pri let parent:&ClassInfo! {pub};
   /** インスタンスのメンバ (親クラスのメンバを含む) */
   pri let mut fieldNames:List<str> {pub};
   pri let mut fieldReps:List<&W.ValType> {pub};
   pri let mut fieldTypes:List<&Ast.TypeInfo> {pub};
   /** メンバ名 → struct のフィールドインデックス */
   pri let mut name2field:Map<str,int> {pub};
   pri let mut slotList:List<SlotInfo> {pub};
   /** メソッド名 → slotList のインデックス (1 始まり) */
   pri let mut name2slot:Map<str,int> {pub};
   /** 実装しているインタフェース (親クラスの分を含む) */
   pri let mut ifList:List<&Ast.TypeInfo> {pub};
   /** コンストラクタの関数インデックス */
   pri let mut ctorFunc:int {pub,pub};
   /** advertise で生成するメソッド (本体は compileAdvertise で生成する) */
   pri let mut advertiseList:List<AdvertiseMethod> {pub};
   pri let mut ctorFuncType:int {pub,pub};

   pub fn __init( typeInfo:&Ast.TypeInfo, structType:int, vtType:int, vtGlobal:int,
                  parent:&ClassInfo! )
   {
      self.typeInfo = typeInfo;
      self.structType = structType;
      self.vtType = vtType;
      self.vtGlobal = vtGlobal;
      self.parent = parent;
      self.fieldNames = [];
      self.fieldReps = [];
      self.fieldTypes = [];
      self.name2field = {};
      self.slotList = [];
      self.name2slot = {};
      self.ifList = [];
      self.ctorFunc = -1;
      self.advertiseList = [];
      self.ctorFuncType = -1;
      when! parent {
         foreach name in parent.$fieldNames {
            self.fieldNames.insert( name );
         }
         foreach rep in parent.$fieldReps {
            self.fieldReps.insert( rep );
         }
         foreach fieldType in parent.$fieldTypes {
            self.fieldTypes.insert( fieldType );
         }
         foreach index, name in parent.$name2field {
            self.name2field[ name ] = index;
         }
         foreach slot in parent.$slotList {
            self.slotList.insert( new SlotInfo( slot.$name, slot.$funcType, slot.$methodType,
                                                slot.$impl ) );
         }
         foreach index, name in parent.$name2slot {
            self.name2slot[ name ] = index;
         }
         foreach ifType in parent.$ifList {
            self.ifList.insert( ifType );
         }
      }
   }
}

/** インタフェースの情報 */
class IfInfo {
   pri let typeInfo:&Ast.TypeInfo {pub};
   pri let ifId:int {pub};
   /** itable の struct 型 */
   pri let itType:int {pub};
   pri let methodNames:&List<str> {pub};
   pri let methodFuncTypes:&List<int> {pub};
   pri let name2index:&Map<str,int> {pub};
}

/** alge の情報 */
class AlgeInfo {
   pri let typeInfo:&Ast.TypeInfo {pub};
   pri let baseType:int {pub};
   /** 値の名前 (tag 順) */
   pri let valNames:&List<str> {pub};
   pri let name2tag:&Map<str,int> {pub};
   /** 値ごとの struct 型 */
   pri let name2type:&Map<str,int> {pub};
   /** パラメータの無い値のシングルトン (グローバル変数) */
   pri let name2global:&Map<str,int> {pub};
   /** 値の名前の配列 (グローバル変数) */
   pri let namesGlobal:int {pub};
}

/** 関数の変換コンテキスト */
class FuncCtx {
   pri let mut func:W.Func {pub};
   pri let mut sym2loc:Map<&Ast.SymbolInfo,VarLoc> {pub};
   pri let retReps:&List<&W.ValType> {pub};
   pri let retTypes:&List<&Ast.TypeInfo> {pub};
   pri let mut depth:int {pub,pub};
   pri let mut breakDepthList:List<int> {pub};
   /** 自身のクロージャを環境の型に cast したものを持つ局所変数。無い場合は -1 */
   pri let mut envLocal:int {pub,pub};
   pri let mut envType:int {pub,pub};
   /** メソッドの self (cast 済み) の局所変数。無い場合は -1 */
   pri let mut selfLocal:int {pub,pub};
   pri let mut selfClass:&ClassInfo! {pub,pub};

   pub fn __init( func:W.Func, retReps:&List<&W.ValType>, retTypes:&List<&Ast.TypeInfo> ) {
      self.func = func;
      self.sym2loc = {};
      self.retReps = retReps;
      self.retTypes = retTypes;
      self.depth = 0;
      self.breakDepthList = [];
      self.envLocal = -1;
      self.envType = -1;
      self.selfLocal = -1;
      self.selfClass = nil;
   }
   pub fn addLocal( valType:&W.ValType ) mut : int {
      return self.func.addLocal( valType );
   }
}

/**
wasm に埋め込む Lua のモジュール (lnsc 自身を変換する場合の、Lua 版の lnsc)。

Go 版 (runtime_go/binding51.go) と同じく、Lua の package.preload に登録して require で読み込めるようにする。
*/
pub class EmbedLua {
   /** モジュール名 (lune.base.Util など) */
   let mod:str {pub};
   /** Lua の chunkname (@lune/base/Util.lua など) */
   let chunkname:str {pub};
   let code:str {pub};
}

class convFilter extend Nodes.Filter<Opt> {
   let streamName:str;
   /** wasm に埋め込む Lua のモジュール */
   let embedLuaList:&List<&EmbedLua>;
   /** Depend.getBindLns で返す LuneScript のソース (モジュール名 → ソース) */
   let bindLnsMap:&Map<str,str>;
   /** 埋め込んだ Lua のモジュールを登録済みかどうかのグローバル変数 (登録する場合だけ生成する) */
   let mut embedLuaGlobal:int;
   let mut stream:oStream;
   let processInfo:Ast.ProcessInfo;
   let builtinFuncs:&Builtin.BuiltinFuncType;
   /** 変換中のモジュールのスコープと型 (import したモジュールの変換中は、そのモジュール) */
   let mut moduleScope:&Ast.Scope;
   let mut moduleTypeInfo:&Ast.TypeInfo;
   /** import したモジュールの AST (依存される側が先) */
   let importAstList:&List<&AstInfo.ASTInfo>;
   /** 全てのモジュールのスコープ (モジュールレベルの変数の判定に使う) */
   let mut moduleScopeSet:Set<&Ast.Scope>;
   /** import したモジュールの名前 → モジュールの初期化 (トップレベルの処理) の関数 */
   let mut module2init:Map<str,int>;
   /** provide しているモジュールの名前 → provide しているシンボル */
   let mut module2provide:Map<str,&Ast.SymbolInfo>;
   /** import したモジュールのシンボル → provide しているシンボル */
   let mut symAlias:Map<&Ast.SymbolInfo,&Ast.SymbolInfo>;
   /** import.l で遅延ロードするモジュールのシンボル → モジュールの名前 */
   let mut lazySym2module:Map<&Ast.SymbolInfo,str>;

   let mut mod:W.Module;
   let mut rt:Rt.Runtime;

   let mut ctx:FuncCtx;
   let mut globalSym2loc:Map<&Ast.SymbolInfo,VarLoc>;
   /** 関数・メソッドの型 → 関数インデックス */
   let mut func2index:Map<&Ast.TypeInfo,int>;
   /** 関数の型 → 宣言ノード */
   let mut func2decl:Map<&Ast.TypeInfo,&Nodes.DeclFuncInfo>;
   let mut classType2decl:Map<&Ast.TypeInfo,&Nodes.DeclClassNode>;
   let mut class2info:Map<&Ast.TypeInfo,&ClassInfo>;
   let mut classInfoList:List<&ClassInfo>;
   /** __serr で生成するエラーのクラスの情報 (使う場合だけ生成する) */
   let mut serrInfo:&ClassInfo!;
   let mut if2info:Map<&Ast.TypeInfo,&IfInfo>;
   let mut ifInfoList:List<&IfInfo>;
   let mut algeType2decl:Map<&Ast.TypeInfo,&Nodes.DeclAlgeNode>;
   let mut alge2info:Map<&Ast.TypeInfo,&AlgeInfo>;
   let mut algeInfoList:List<&AlgeInfo>;
   let mut enumType2decl:Map<&Ast.TypeInfo,&Nodes.DeclEnumNode>;
   /** 宣言があるメソッド (自動生成されるメソッドを除く) */
   let mut declaredMethodSet:Set<&Ast.TypeInfo>;
   /** advertise で生成したメソッド */
   let mut advertiseMethodSet:Set<&Ast.TypeInfo>;
   /**
   メソッドとして宣言・委譲 (advertise) している getter の名前 (全モジュール)。
   これらの名前の自動生成の getter は、派生クラスで置き換わっている可能性があるので、
   メンバを直接参照せずに vtable で呼び出す。
   */
   let mut dynGetterNameSet:Set<str>;
   /** 実行時の型で _toMap を呼び分ける関数 (使う場合だけ生成する。本体は finalizeClasses で生成) */
   let mut toMapDynIndex:int;
   /** 最初に _toMap を呼んだノード (変換のエラーの位置に使う) */
   let mut toMapDynNode:&Nodes.Node!;
   /** 関数を関数型のクロージャに変換するアダプタ (キー → 関数インデックス) */
   let mut adapterMap:Map<str,int>;
   /** Lua のモジュール (module ... require) の型 → その値を持つグローバル変数 */
   let mut extModule2global:Map<&Ast.TypeInfo,int>;
   /** 情報を生成中の alge → base の型 (値に自身を持つ alge の、getRep の再帰を止める) */
   let mut algeBuildingMap:Map<&Ast.TypeInfo,int>;
   /** 評価済みの値で置き換えるノード ($. などで、評価済みの prefix を使う) */
   let mut node2val:Map<&Nodes.Node,&Val>;
   /** nil の判定を処理済みの $. などのノード */
   let mut nilAccDoneSet:Set<&Nodes.Node>;
   /**
関数の __func__ シンボル → 関数の宣言の名前。
let f = fn () {} の場合、__func__ を持つ関数の型と宣言の型が別になるので、シンボルで対応付ける。
*/
   let mut funcSym2name:Map<&Ast.SymbolInfo,str>;
   /** main の先頭で実行する初期化処理 */
   let mut prologue:List<&W.Ins>;
   /** 標準出力のオブジェクト (グローバル変数) */
   let mut stdoutGlobal:int;
   let mut stderrGlobal:int;
   let mut stdinGlobal:int;
   let mainIndex:int;
   /** 本体を変換済みの関数 */
   let mut compiledFuncSet:Set<int>;

   pub fn __init( streamName:str, stream:oStream, ast:&AstInfo.ASTInfo,
                  importAstList:&List<&AstInfo.ASTInfo>,
                  embedLuaList:&List<&EmbedLua>, bindLnsMap:&Map<str,str> )
   {
      super( true, ast.$exportInfo.$moduleTypeInfo,
             ast.$exportInfo.$moduleTypeInfo.$scope );

      self.streamName = streamName;
      self.embedLuaList = embedLuaList;
      self.bindLnsMap = bindLnsMap;
      self.embedLuaGlobal = -1;
      self.stream = stream;
      self.processInfo = ast.$exportInfo.$processInfo.clone();
      self.builtinFuncs = ast.$builtinFunc;
      self.moduleTypeInfo = ast.$exportInfo.$moduleTypeInfo;
      self.moduleScope = unwrap ast.$exportInfo.$moduleTypeInfo.$scope;
      self.importAstList = importAstList;
      self.moduleScopeSet = (@);
      self.moduleScopeSet.add( self.moduleScope );
      self.module2init = {};
      self.module2provide = {};
      self.symAlias = {};
      self.lazySym2module = {};

      let mut mod = new W.Module();
      self.rt = new Rt.Runtime( mod );
      self.mod = mod;
      let mainIndex, mut mainFunc = self.mod.addFunc( [], [] );
      self.mainIndex = mainIndex;
      self.mod.setFuncName( mainIndex, "main" );
      self.ctx = new FuncCtx( mainFunc, [], [] );
      self.compiledFuncSet = (@);
      self.globalSym2loc = {};
      self.func2index = {};
      self.func2decl = {};
      self.classType2decl = {};
      self.class2info = {};
      self.classInfoList = [];
      self.serrInfo = nil;
      self.if2info = {};
      self.ifInfoList = [];
      self.algeType2decl = {};
      self.alge2info = {};
      self.algeInfoList = [];
      self.enumType2decl = {};
      self.declaredMethodSet = (@);
      self.advertiseMethodSet = (@);
      self.dynGetterNameSet = (@);
      self.toMapDynIndex = -1;
      self.toMapDynNode = nil;
      self.adapterMap = {};
      self.extModule2global = {};
      self.algeBuildingMap = {};
      self.node2val = {};
      self.nilAccDoneSet = (@);
      self.funcSym2name = {};
      self.prologue = [];
      self.stdoutGlobal = -1;
      self.stderrGlobal = -1;
      self.stdinGlobal = -1;
   }
}

/** node の位置を付けてエラーを出す。 */
fn convFilter.error( node:&Nodes.Node, mess:str ) : __ {
   // import したモジュールのノードもあるので、ノードの位置のファイル名を使う
   Util.err( "%s: wasm: %s" ( node.$pos.getDisplayTxt(), mess ) );
}

fn convFilter.notSupport( node:&Nodes.Node ) : __ {
   self.error( node, "not support -- %s" ( Nodes.getNodeKindName( node.$kind ) ) );
}

// ======== 型 ========

/** 修飾 (immutable、alias) を取り除いた型 */
fn convFilter.normType( typeInfo:&Ast.TypeInfo ) : &Ast.TypeInfo {
   let mut work = typeInfo.$aliasSrc.$srcTypeInfo;
   if work.$nilable {
      work = work.$nonnilableType.$aliasSrc.$srcTypeInfo;
   }
   if work.$kind == .Ext {
      // Luaval<T>。Lua の値 ($LuaVal) か、Lua の値に変換しない値 (数値・文字列など) なので
      // stem と同じに扱う。Luaval<T> の値の操作は、isLuaval() で判定して Lua で行う
      return Ast.builtinTypeStem;
   }
   return work;
}

/** Lua のモジュール (module ... require) の型。それ以外は nil */
fn convFilter.getExtModuleType( typeInfo:&Ast.TypeInfo ) : &Ast.TypeInfo! {
   let work = typeInfo.$aliasSrc.$srcTypeInfo.$nonnilableType;
   if work.$kind == .ExtModule {
      return work;
   }
   return nil;
}

/**
Lua のモジュールの値 (Lua の require の結果)。

Lua 版の require と同じく、最初の参照時に .lua ファイルを読み込んで実行する。
module.l (遅延ロード) でない場合は、宣言の位置でも参照して読み込む。
*/
fn convFilter.lowerExtModuleVal( node:&Nodes.Node, modType:&Ast.TypeInfo ) mut : &W.Ins {
   let modGlobal;
   if! let work = self.extModule2global[ modType ] {
      modGlobal = work;
   } else {
      modGlobal = self.mod.addGlobal( W.typeAnyRef, W.refNull( W.htAny ) );
      self.extModule2global[ modType ] = modGlobal;
   }
   let! normalType = modType@@@Ast.NormalTypeInfo {
      self.error( node, "not support module -- %s" (modType.getTxt( ## )) );
   };
   let args = self.tempLocal( self.rt.$listType );
   return W.seq( [
      W.ifElse( W.refIsNull( W.globalGet( modGlobal ) ), [
         ls( args, W.call( self.rt.fnListNew(), [ W.i32Const( 1 ) ] ) ),
         W.call( self.rt.fnListPush(), [ lg( args ), self.rt.strLiteral( normalType.$requirePath ) ] ),
         W.globalSet( modGlobal, self.rt.listItem(
            W.call( self.rt.fnLuaCall(), [ W.i32Const( Rt.luaRequire ), lg( args ) ] ), 0 ) ) ],
                nil, nil ),
      W.globalGet( modGlobal ) ] );
}

/** Luaval<T> (Lua の値) の型かどうか */
fn convFilter.isLuaval( typeInfo:&Ast.TypeInfo ) : bool {
   let mut work = typeInfo.$aliasSrc.$srcTypeInfo;
   if work.$nilable {
      work = work.$nonnilableType.$aliasSrc.$srcTypeInfo;
   }
   return work.$kind == .Ext;
}

/** generics の型の場合は、元の型 (クラスなど) を返す */
fn convFilter.getGenSrc( typeInfo:&Ast.TypeInfo ) : &Ast.TypeInfo {
   let mut work = self.normType( typeInfo );
   // クラスの中の自身の型 (AltBase<T> の中の AltBase<T>) は、
   // 型パラメータで生成した型なので、元の型になるまでたどる
   for _ = 1, 10 {
      let src = work.$genSrcTypeInfo.$aliasSrc.$srcTypeInfo;
      if src == work {
         break;
      }
      work = src;
   }
   return work;
}

fn convFilter.isType( typeInfo:&Ast.TypeInfo, builtin:&Ast.TypeInfo ) : bool {
   return self.normType( typeInfo ).equals( self.processInfo, builtin ## );
}

/** スカラー (i64 / f64 / i32) の表現かどうか */
fn isScalar( rep:&W.ValType ) : bool {
   return not rep.isRef();
}

/** 型の wasm での表現 */
fn convFilter.getRep( typeInfo:&Ast.TypeInfo ) mut : &W.ValType {
   let orgType = typeInfo.$aliasSrc.$srcTypeInfo;
   if orgType.$nilable and orgType ~= Ast.builtinTypeNil and
      orgType.$nonnilableType ~= orgType
   {
      let rep = self.getRep( orgType.$nonnilableType );
      if isScalar( rep ) {
         return W.typeAnyRef;
      }
      return rep;
   }
   let work = self.normType( orgType );
   // str は Class なので、種類で判断する前に確認する
   if work.equals( self.processInfo, Ast.builtinTypeString ## ) {
      return self.rt.$strType;
   }
   switch work.$kind {
      case .Prim {
         if work.equals( self.processInfo, Ast.builtinTypeInt ## ) or
            work.equals( self.processInfo, Ast.builtinTypeChar ## )
         {
            return W.typeI64;
         }
         if work.equals( self.processInfo, Ast.builtinTypeReal ## ) {
            return W.typeF64;
         }
         if work.equals( self.processInfo, Ast.builtinTypeBool ## ) {
            return W.typeI32;
         }
         return W.typeAnyRef;
      }
      case .Enum {
         if! let enumType = work@@@Ast.EnumTypeInfo {
            return self.getRep( enumType.$valTypeInfo );
         }
      }
      // タプルは Lua 版と同じく、値のリストで表す
      // Nilable<T> の箱も、Lua 版と同じく要素が 1 つのリストで表す
      case .List, .Array, .DDD, .Tuple, .Box {
         return self.rt.$listType;
      }
      case .Map, .Set {
         return self.rt.$mapType;
      }
      case .Class {
         if! let info = self.getClassInfo( work ) {
            return W.refType( info.$structType );
         }
         return self.rt.$objType;
      }
      case .IF {
         return self.rt.$objType;
      }
      case .Func, .Form, .FormFunc {
         return W.refType( self.getFuncCloInfo( work ).$cloType );
      }
      case .Alge {
         if! let baseType = self.algeBuildingMap[ self.getGenSrc( work ) ] {
            return W.refType( baseType );
         }
         if! let info = self.getAlgeInfo( self.getGenSrc( work ) ) {
            return W.refType( info.$baseType );
         }
      }
   }
   return W.typeAnyRef;
}

fn convFilter.getRepList( typeList:&List<&Ast.TypeInfo> ) mut : &List<&W.ValType> {
   let mut list:List<&W.ValType> = [];
   foreach typeInfo in typeList {
      list.insert( self.getRep( typeInfo ) );
   }
   return list;
}

/** 関数型 (Func / Form / FormFunc) のクロージャの型 */
fn convFilter.getFuncCloInfo( funcType:&Ast.TypeInfo ) mut : &Rt.CloInfo {
   let work = self.normType( funcType );
   return self.rt.getCloInfo( self.getRepList( work.$argTypeInfoList ),
                              self.getRepList( work.$retTypeInfoList ) );
}

/** メソッドの wasm の関数型 (self + 引数 → 戻り値) */
fn convFilter.getMethodFuncType( methodType:&Ast.TypeInfo ) mut : int {
   let mut params:List<&W.ValType> = [ self.rt.$objType ];
   foreach param in self.getRepList( methodType.$argTypeInfoList ) {
      params.insert( param );
   }
   return self.mod.getFuncType( params, self.getRepList( methodType.$retTypeInfoList ) );
}

/** 型の既定値 */
fn convFilter.getDefaultVal( rep:&W.ValType ) : &W.Ins {
   _switch rep.$kind {
      case .I64 {
         return W.i64Const( 0 );
      }
      case .F64 {
         return W.f64Const( 0.0 );
      }
      case .I32 {
         return W.i32Const( 0 );
      }
      case .Ref {
         return W.refNull( rep.$heapType );
      }
   }
}

// ======== クラス ========

/** メソッドとして扱うシンボルかどうか */
fn isMethodSym( symbol:&Ast.SymbolInfo ) : bool {
   return symbol.$kind == .Mtd and not symbol.$staticFlag and symbol.$name ~= "__init" and
       symbol.$name ~= "__free";
}

/** Mapping のメソッド (呼び出し側で処理する) */
let mappingMethodSet = (@ "_toMap", "_fromMap", "_fromStem" );

fn convFilter.getClassInfo( typeInfo:&Ast.TypeInfo ) mut : &ClassInfo! {
   let classType = self.getGenSrc( typeInfo );
   if! let info = self.class2info[ classType ] {
      return info;
   }
   let! declNode = self.classType2decl[ classType ] {
      return nil;
   };
   return self.registerClass( declNode );
}

/** クラスの型・vtable・メソッドの関数インデックスを登録する。 */
fn convFilter.registerClass( declNode:&Nodes.DeclClassNode ) mut : &ClassInfo {
   let classType = self.getGenSrc( declNode.$expType );
   if! let info = self.class2info[ classType ] {
      return info;
   }
   let mut parent:&ClassInfo! = nil;
   let mut superStruct = self.rt.$tObj;
   let mut superVt = self.rt.$tVT;
   if classType.hasBase() {
      let! parentInfo = self.getClassInfo( classType.$baseTypeInfo ) {
         self.error( declNode, "not found base class -- %s"
                     ( classType.$baseTypeInfo.getTxt( ## ) ) );
      };
      parent = parentInfo;
      superStruct = parentInfo.$structType;
      superVt = parentInfo.$vtType;
   }
   let structType = self.mod.reserveType();
   let vtType = self.mod.reserveType();
   let vtGlobal = self.mod.addGlobal( W.refType( vtType ), W.refNull( vtType ) );
   let mut info = new ClassInfo( classType, structType, vtType, vtGlobal, parent );
   self.class2info[ classType ] = info;
   self.classInfoList.insert( info );

   // メンバ
   foreach memberNode in declNode.$memberList {
      if memberNode.$staticFlag {
         let symbol = memberNode.$symbolInfo.getOrg();
         let rep = self.getRep( symbol.$typeInfo );
         self.globalSym2loc[ symbol ] =
            VarLoc.Global( self.mod.addGlobal( rep, self.getDefaultVal( rep ) ) );
      } else {
         let name = memberNode.$name.txt;
         info.$fieldNames.insert( name );
         info.$fieldReps.insert( self.getRep( memberNode.$symbolInfo.$typeInfo ) );
         info.$fieldTypes.insert( memberNode.$symbolInfo.$typeInfo );
         info.$name2field[ name ] = #info.$fieldNames + 1;
      }
   }

   // メンバの宣言から自動生成されるアクセッサ
   let mut autoMethodSet:Set<str> = (@);
   foreach memberNode in declNode.$memberList {
      if not memberNode.$staticFlag {
         if memberNode.$getterMode ~= .None {
            autoMethodSet.add( "get_" .. memberNode.$name.txt );
         }
         if memberNode.$setterMode ~= .None {
            autoMethodSet.add( "set_" .. memberNode.$name.txt );
         }
      }
   }

   // メソッド (名前順に処理して、スロットの順序を決める)
   let scope = unwrap classType.$scope;
   forsort symbol, name in scope.$symbol2SymbolInfoMap {
      let methodType = symbol.$typeInfo;
      if ( not self.declaredMethodSet.has( methodType ) and not autoMethodSet.has( name ) ) or
         mappingMethodSet.has( name )
      {
         // _toMap などの builtin のメソッドは、呼び出し側で処理する
      } elseif isMethodSym( symbol ) {
         let mut impl = -1;
         let mut slotImpl = -1;
         if not methodType.$abstractFlag {
            let funcType = self.getMethodFuncType( methodType );
            let work, _ = self.mod.addFuncWithType( funcType, 1 + #methodType.$argTypeInfoList );
            impl = work;
            slotImpl = work;
            self.mod.setFuncName( impl, "%s.%s" ( classType.getTxt( ## ), name ) );
            self.func2index[ methodType ] = impl;
            if! let slotIndex = info.$name2slot[ name ] {
               let slot = info.$slotList[ slotIndex ];
               if slot.$funcType ~= funcType {
                  // generics の親クラスの型パラメータ (anyref) を、具体的な型 (i64 など) で
                  // オーバーライドした場合は、変換するアダプタを vtable に登録する
                  slotImpl = self.makeIfAdapter( slot.$methodType, methodType, impl );
               }
            }
         }
         if! let slotIndex = info.$name2slot[ name ] {
            info.$slotList[ slotIndex ].set_impl( slotImpl );
         } else {
            info.$slotList.insert(
               new SlotInfo( name, self.getMethodFuncType( methodType ), methodType, impl ) );
            info.$name2slot[ name ] = #info.$slotList;
         }
      } elseif symbol.$kind == .Mtd and symbol.$staticFlag {
         // static メソッドは関数として扱う
         let index, _ = self.mod.addFuncWithType( self.getFuncCloInfo( methodType ).$funcType,
                                                  1 + #methodType.$argTypeInfoList );
         self.func2index[ methodType ] = index;
         self.mod.setFuncName( index, "%s.%s" ( classType.getTxt( ## ), name ) );
      }
   }

   // advertise (メンバへの委譲)
   foreach advertiseInfo in declNode.$advertiseList {
      let memberType = advertiseInfo.$member.$expType;
      let mbrScope = unwrap self.getGenSrc( memberType ).$scope;
      foreach mtdName in Ast.getAllMethodName( self.getGenSrc( memberType ), .Object ).$list {
         let child = unwrap mbrScope.getTypeInfoField( mtdName, true, mbrScope, .Normal );
         if child.$accessMode == .Pri {
            continue;
         }
         let name = advertiseInfo.$prefix .. mtdName;
         let mut methodType = child;
         if! let symbol = scope.$symbol2SymbolInfoMap[ name ] {
            let ownMethod = self.getGenSrc( symbol.$typeInfo.$parentInfo ) == classType;
            if ownMethod and self.declaredMethodSet.has( symbol.$typeInfo ) or
               autoMethodSet.has( name )
            {
               // このクラスで定義しているメソッドは委譲しない
               // (親クラスから継承したメソッドは委譲する)
               continue;
            }
            methodType = symbol.$typeInfo;
         }
         let funcType;
         if! let slotIndex = info.$name2slot[ name ] {
            funcType = info.$slotList[ slotIndex ].$funcType;
         } else {
            funcType = self.getMethodFuncType( methodType );
         }
         let impl, _ = self.mod.addFuncWithType( funcType, 1 + #methodType.$argTypeInfoList );
         self.mod.setFuncName( impl, "%s.%s" ( classType.getTxt( ## ), name ) );
         if! let slotIndex = info.$name2slot[ name ] {
            info.$slotList[ slotIndex ].set_impl( impl );
         } else {
            info.$slotList.insert( new SlotInfo( name, funcType, methodType, impl ) );
            info.$name2slot[ name ] = #info.$slotList;
         }
         info.$advertiseList.insert(
            new AdvertiseMethod( advertiseInfo.$member.$name.txt, memberType, mtdName,
                                 methodType, impl ) );
         self.advertiseMethodSet.add( methodType );
      }
   }

   // コンストラクタ
   if! let initSym = scope.$symbol2SymbolInfoMap[ "__init" ] {
      let ctorType = self.getMethodFuncType( initSym.$typeInfo );
      let ctor, _ = self.mod.addFuncWithType( ctorType, 1 + #initSym.$typeInfo.$argTypeInfoList );
      self.func2index[ initSym.$typeInfo ] = ctor;
      self.mod.setFuncName( ctor, "%s.__init" ( classType.getTxt( ## ) ) );
      info.set_ctorFunc( ctor );
      info.set_ctorFuncType( ctorType );
   }

   // インタフェース
   foreach ifType in classType.$interfaceList {
      self.addInterface( info, ifType );
   }

   // 型の定義
   let mut fields:List<&W.FieldType> = [ W.field( W.typeI32, true ),
                                         W.field( W.refType( vtType ), false ) ];
   foreach rep in info.$fieldReps {
      fields.insert( W.field( rep, true ) );
   }
   self.mod.defineStructType( structType, superStruct, fields );
   let mut vtFields:List<&W.FieldType> = [ W.field( self.rt.$anyArrType, false ) ];
   foreach slot in info.$slotList {
      vtFields.insert( W.field( W.refType( slot.$funcType ), false ) );
   }
   self.mod.defineStructType( vtType, superVt, vtFields );
   return info;
}

/**
__serr で生成するエラーのクラス。

Lua 版のランタイムの LnsErr と同じく、__Er を実装し、メッセージ (txt) を持つ。
*/
fn convFilter.getSerrInfo() mut : &ClassInfo {
   if! let info = self.serrInfo {
      return info;
   }
   let erType = self.getGenSrc( self.builtinFuncs.lns___serr.$retTypeInfoList[ 1 ] );
   let structType = self.mod.reserveType();
   let vtType = self.mod.reserveType();
   let vtGlobal = self.mod.addGlobal( W.refType( vtType ), W.refNull( vtType ) );
   let mut info = new ClassInfo( erType, structType, vtType, vtGlobal, nil );
   info.$fieldNames.insert( "txt" );
   info.$fieldReps.insert( self.rt.$strType );
   info.$fieldTypes.insert( Ast.builtinTypeString );
   info.$name2field[ "txt" ] = 2;

   let methodType = unwrap self.getIfMethodType( erType, "get_txt" );
   let funcType = self.getMethodFuncType( methodType );
   let impl, mut func = self.mod.addFuncWithType( funcType, 1 );
   self.mod.setFuncName( impl, "LnsErr.get_txt" );
   func.setBody( [ W.structGet( structType, 2, W.refCast( structType, lg( 0 ) ) ) ] );
   info.$slotList.insert( new SlotInfo( "get_txt", funcType, methodType, impl ) );
   info.$name2slot[ "get_txt" ] = 1;
   self.addInterface( info, erType );

   self.mod.defineStructType( structType, self.rt.$tObj,
                              [ W.field( W.typeI32, true ),
                                W.field( W.refType( vtType ), false ),
                                W.field( self.rt.$strType, true ) ] );
   self.mod.defineStructType( vtType, self.rt.$tVT,
                              [ W.field( self.rt.$anyArrType, false ),
                                W.field( W.refType( funcType ), false ) ] );
   self.classInfoList.insert( info );
   self.serrInfo = info;
   return info;
}

fn convFilter.addInterface( mut info:ClassInfo, ifType:&Ast.TypeInfo ) mut {
   let work = self.getGenSrc( ifType );
   foreach registered in info.$ifList {
      if registered == work {
         return;
      }
   }
   info.$ifList.insert( work );
   foreach parentIf in work.$interfaceList {
      self.addInterface( info, parentIf );
   }
}

/** インタフェースのメソッドを集める (継承しているインタフェースを含む) */
fn convFilter.collectIfMethods( ifType:&Ast.TypeInfo, mut map:Map<str,&Ast.TypeInfo> ) {
   foreach parentIf in ifType.$interfaceList {
      self.collectIfMethods( self.getGenSrc( parentIf ), map );
   }
   if! let scope = ifType.$scope {
      foreach symbol, name in scope.$symbol2SymbolInfoMap {
         if isMethodSym( symbol ) {
            map[ name ] = symbol.$typeInfo;
         }
      }
   }
}

fn convFilter.getIfInfo( ifType:&Ast.TypeInfo ) mut : &IfInfo {
   let work = self.getGenSrc( ifType );
   if! let info = self.if2info[ work ] {
      return info;
   }
   let mut methodMap:Map<str,&Ast.TypeInfo> = {};
   self.collectIfMethods( work, methodMap );
   let mut names:List<str> = [];
   let mut funcTypes:List<int> = [];
   let mut name2index:Map<str,int> = {};
   let mut fields:List<&W.FieldType> = [];
   forsort methodType, name in methodMap {
      names.insert( name );
      let funcType = self.getMethodFuncType( methodType );
      funcTypes.insert( funcType );
      name2index[ name ] = #names - 1;
      fields.insert( W.field( W.refType( funcType ), false ) );
   }
   let itType = self.mod.addStructType( nil, fields );
   let info = new IfInfo( work, #self.ifInfoList, itType, names, funcTypes, name2index );
   self.if2info[ work ] = info;
   self.ifInfoList.insert( info );
   return info;
}

/** クラスのメンバのフィールドインデックス */
fn convFilter.getFieldIndex( node:&Nodes.Node, info:&ClassInfo, name:str ) : int {
   let! index = info.$name2field[ name ] {
      self.error( node, "not found member -- %s" (name) );
   };
   return index;
}

// ======== alge ========

fn convFilter.getAlgeInfo( algeType:&Ast.TypeInfo ) mut : &AlgeInfo! {
   if! let info = self.alge2info[ algeType ] {
      return info;
   }
   let! work = algeType@@@Ast.AlgeTypeInfo {
      return nil;
   };
   // 値の順序は宣言順にする。宣言が無い場合は名前順
   let mut valNames:List<str> = [];
   if! let declNode = self.algeType2decl[ algeType ] {
      foreach valInfo in declNode.$algeValList {
         valNames.insert( valInfo.$valSym.$name );
      }
   } else {
      forsort _, name in work.$valInfoMap {
         valNames.insert( name );
      }
   }
   let baseType = self.mod.addStructType(
      self.rt.$tBase, [ W.field( W.typeI32, true ), W.field( W.typeI32, false ) ] );
   self.algeBuildingMap[ algeType ] = baseType;
   let mut name2tag:Map<str,int> = {};
   let mut name2type:Map<str,int> = {};
   let mut name2global:Map<str,int> = {};
   let mut nameInsList:List<&W.Ins> = [];
   foreach name, index in valNames {
      name2tag[ name ] = index - 1;
      let valInfo = unwrap work.$valInfoMap[ name ];
      if #valInfo.$typeList == 0 {
         name2type[ name ] = baseType;
         let globalIdx = self.mod.addGlobal( W.refType( baseType ), W.refNull( baseType ) );
         name2global[ name ] = globalIdx;
         self.prologue.insert(
            W.globalSet( globalIdx, W.structNew( baseType, [ W.i32Const( 0 ),
                                                          W.i32Const( index - 1 ) ] ) ) );
      } else {
         let mut fields:List<&W.FieldType> = [ W.field( W.typeI32, true ),
                                               W.field( W.typeI32, false ) ];
         foreach paramType in valInfo.$typeList {
            fields.insert( W.field( self.getRep( paramType ), false ) );
         }
         name2type[ name ] = self.mod.addStructType( baseType, fields );
      }
      nameInsList.insert( self.rt.strLiteral( "%s.%s" ( work.$rawTxt, name ) ) );
   }
   let namesGlobal = self.mod.addGlobal( self.rt.$anyArrType, W.refNull( self.rt.$tAnyArr ) );
   self.prologue.insert(
      W.globalSet( namesGlobal, W.arrayNewFixed( self.rt.$tAnyArr, nameInsList ) ) );
   let info = new AlgeInfo( algeType, baseType, valNames, name2tag, name2type, name2global,
                            namesGlobal );
   self.algeBuildingMap[ algeType ] = nil;
   self.alge2info[ algeType ] = info;
   self.algeInfoList.insert( info );
   return info;
}

// ======== 変数 ========

/** モジュールレベルの変数 (グローバル変数にする) かどうか */
fn convFilter.isGlobalSym( symbol:&Ast.SymbolInfo ) : bool {
   return self.moduleScopeSet.has( symbol.$scope );
}

/** セルから値を読む */
fn convFilter.cellGet( rep:&W.ValType, cell:&W.Ins ) : &W.Ins {
   let cellType = self.rt.getCellType( rep );
   let val = W.structGet( cellType, 0, cell );
   if rep.isRef() and rep.$heapType ~= W.htAny {
      return W.refCast( rep.$heapType, val );
   }
   return val;
}

/**
変数を宣言する。

@param init 初期値。nil の場合は既定値
@return 初期化の命令
*/
fn convFilter.declareVar( symbol:&Ast.SymbolInfo, init:&W.Ins! ) mut : &W.Ins {
   let orgSym = symbol.getOrg();
   let rep = self.getRep( orgSym.$typeInfo );
   let val;
   when! init {
      val = init;
   } else {
      val = self.getDefaultVal( rep );
   }
   if self.isGlobalSym( orgSym ) {
      let globalIdx;
      if! let loc = self.globalSym2loc[ orgSym ] {
         match loc {
            case .Global( index ) {
               globalIdx = index;
            }
            default {
               globalIdx = self.mod.addGlobal( rep, self.getDefaultVal( rep ) );
            }
         }
      } else {
         globalIdx = self.mod.addGlobal( rep, self.getDefaultVal( rep ) );
         self.globalSym2loc[ orgSym ] = VarLoc.Global( globalIdx );
      }
      return W.globalSet( globalIdx, val );
   }
   if orgSym.$hasAccessFromClosure {
      let cellType = self.rt.getCellType( rep );
      let index = self.ctx.addLocal( W.refType( cellType ) );
      self.ctx.$sym2loc[ orgSym ] = VarLoc.CellLocal( index );
      return ls( index, W.structNew( cellType, [ val ] ) );
   }
   let index = self.ctx.addLocal( rep );
   self.ctx.$sym2loc[ orgSym ] = VarLoc.Local( index );
   return ls( index, val );
}

fn convFilter.findLoc( symbol:&Ast.SymbolInfo ) : VarLoc! {
   let orgSym = symbol.getOrg();
   if! let loc = self.ctx.$sym2loc[ orgSym ] {
      return loc;
   }
   return self.globalSym2loc[ orgSym ];
}

fn convFilter.envGet( field:int ) : &W.Ins {
   return W.structGet( self.ctx.$envType, field, lg( self.ctx.$envLocal ) );
}

/** 変数の値を読む */
fn convFilter.readSym( node:&Nodes.Node, symbol:&Ast.SymbolInfo ) mut : &W.Ins {
   if! let initIns = self.getLazyInit( node ) {
      // provide している遅延ロードのモジュールの値
      return W.seq( [ initIns, self.readSymSub( node, symbol ) ] );
   }
   return self.readSymSub( node, symbol );
}
fn convFilter.readSymSub( node:&Nodes.Node, symbol:&Ast.SymbolInfo ) mut : &W.Ins {
   let orgSym = self.resolveSym( symbol.getOrg() );
   let rep = self.getRep( orgSym.$typeInfo );
   if! let loc = self.findLoc( orgSym ) {
      _match loc {
         case .Local( index ) {
            return lg( index );
         }
         case .CellLocal( index ) {
            return self.cellGet( rep, lg( index ) );
         }
         case .Captured( field ) {
            return self.cellGet( rep, self.envGet( field ) );
         }
         case .Global( index ) {
            return W.globalGet( index );
         }
      }
   }
   if orgSym.$kind == .Fun {
      // モジュールレベルの関数を値として使う場合はクロージャを生成する
      if! let funcIndex = self.func2index[ orgSym.$typeInfo ] {
         let info = self.getFuncCloInfo( orgSym.$typeInfo );
         return W.structNew( info.$cloType, [ W.i32Const( 0 ), self.mod.refFunc( funcIndex ) ] );
      }
   }
   switch orgSym.$name {
      case "_G", "_ENV" {
         // Lua のグローバル変数の表 (Lua 専用のモジュールで使う)。
         // Lua の _G を Map にする (値は Lua の値のまま)
         return W.call( self.rt.fnLuaToMap(),
                        [ self.rt.listItem(
                           W.call( self.rt.fnLuaCall(),
                                   [ W.i32Const( Rt.luaGlobals ),
                                     W.call( self.rt.fnListNew(), [ W.i32Const( 0 ) ] ) ] ), 0 ),
                          W.i32Const( 0 ) ] );
      }
      case "__mod__" {
         return self.rt.strLiteral(
            self.moduleTypeInfo.getFullName( self.$typeNameCtrl, self.$moduleInfoManager, false ) );
      }
      case "__func__" {
         // Lua 版と同じく、関数の完全な名前 (親の名前.関数名)
         let funcType = orgSym.$namespaceTypeInfo;
         let nameSpace = funcType.$parentInfo.getFullName(
            self.$typeNameCtrl, self.$moduleInfoManager, false ).gsub( "&", "" );
         let mut funcName = self.funcSym2name[ orgSym ] or "";
         if funcName == "" {
            funcName = "<anonymous>";
         }
         return self.rt.strLiteral( "%s.%s" ( nameSpace, funcName ) );
      }
   }
   self.error( node, "not support symbol -- %s" ( orgSym.$name ) );
}

/** 変数に値を書く */
fn convFilter.writeSym( node:&Nodes.Node, symbol:&Ast.SymbolInfo, val:&W.Ins ) mut : &W.Ins {
   let orgSym = symbol.getOrg();
   if orgSym.$name == "_" {
      // _ への代入は、値を捨てる
      return W.drop( val );
   }
   let rep = self.getRep( orgSym.$typeInfo );
   let! loc = self.findLoc( orgSym ) {
      self.error( node, "not support symbol -- %s" ( orgSym.$name ) );
   };
   _match loc {
      case .Local( index ) {
         return ls( index, val );
      }
      case .CellLocal( index ) {
         return W.structSet( self.rt.getCellType( rep ), 0, lg( index ), val );
      }
      case .Captured( field ) {
         return W.structSet( self.rt.getCellType( rep ), 0, self.envGet( field ), val );
      }
      case .Global( index ) {
         return W.globalSet( index, val );
      }
   }
}

// ======== 値の変換 ========

fn convFilter.isFuncType( typeInfo:&Ast.TypeInfo ) : bool {
   switch self.normType( typeInfo ).$kind {
      case .Func, .Form, .FormFunc {
         return true;
      }
   }
   return false;
}

/** 表現 (rep) だけで値を変換する */
fn convFilter.coerceRep( ins:&W.Ins, fromRep:&W.ValType, toRep:&W.ValType ) mut : &W.Ins {
   if fromRep.equalsType( toRep ) {
      return ins;
   }
   if isScalar( fromRep ) {
      if isScalar( toRep ) {
         if fromRep.$kind == .I64 and toRep.$kind == .F64 {
            return p( W.opF64ConvertI64S, [ ins ] );
         }
         if fromRep.$kind == .F64 and toRep.$kind == .I64 {
            return p( W.opI64TruncF64S, [ ins ] );
         }
         return ins;
      }
      let boxed;
      _switch fromRep.$kind {
         case .I64 {
            boxed = self.rt.boxI64( ins );
         }
         case .F64 {
            boxed = self.rt.boxF64( ins );
         }
         case .I32, .Ref {
            boxed = self.rt.boxBool( ins );
         }
      }
      return boxed;
   }
   if isScalar( toRep ) {
      _switch toRep.$kind {
         case .I64 {
            return self.rt.unboxI64( ins );
         }
         case .F64 {
            return self.rt.unboxF64( ins );
         }
         case .I32, .Ref {
            return self.rt.unboxBool( ins );
         }
      }
   }
   if toRep.$heapType == W.htAny {
      return ins;
   }
   if fromRep.$heapType == W.htAny and toRep.equalsType( self.rt.$mapType ) {
      // Lua の table と同じく、List も Map として扱えるようにする
      return W.call( self.fnAnyToMap(), [ ins ] );
   }
   return W.refCast( toRep.$heapType, ins );
}

/**
anyref を Map にする。

List の場合は、Lua の table と同じく、添字 (1 始まり) をキーにした Map を生成する。
Lua では数値のキーも .. で文字列につなげられるが、wasm では str の型の値として扱うので、
キーは添字の文字列 ("1", "2", ...) にする (Lua とは整列の順番が異なる場合がある)。
*/
fn convFilter.fnAnyToMap() mut : int {
   if! let index = self.adapterMap[ "anyToMap" ] {
      return index;
   }
   let index, mut func = self.mod.addFunc( [ W.typeAnyRef ], [ self.rt.$mapType ] );
   self.adapterMap[ "anyToMap" ] = index;
   self.mod.setFuncName( index, "anyToMap" );
   let list = func.addLocal( self.rt.$listType );
   let map = func.addLocal( self.rt.$mapType );
   let pos = func.addLocal( W.typeI32 );
   let item = func.addLocal( W.typeAnyRef );
   func.setBody( [
      W.ifElse( p( W.opI32Eqz, [ W.refTest( self.rt.$tList, lg( 0 ) ) ] ),
                [ W.ret( [ W.refCast( self.rt.$tMap, lg( 0 ) ) ] ) ], nil, nil ),
      ls( list, W.refCast( self.rt.$tList, lg( 0 ) ) ),
      ls( map, self.rt.newMap() ),
      W.block( [ W.loop( [
         W.brIf( 1, p( W.opI32GeS, [ lg( pos ),
                                     W.structGet( self.rt.$tList, Rt.fListLen, lg( list ) ) ] ) ),
         ls( item, W.arrayGet( self.rt.$tAnyArr,
                               W.structGet( self.rt.$tList, Rt.fListItems, lg( list ) ),
                               lg( pos ) ) ),
         ls( pos, p( W.opI32Add, [ lg( pos ), W.i32Const( 1 ) ] ) ),
         // Lua と同じく nil の要素は Map に入れない
         W.ifElse( p( W.opI32Eqz, [ W.refIsNull( lg( item ) ) ] ), [
            W.call( self.rt.fnMapSet(),
                    [ lg( map ), W.call( self.rt.fnI64ToStr(),
                                         [ p( W.opI64ExtendI32S, [ lg( pos ) ] ) ] ),
                      lg( item ) ] ) ], nil, nil ),
         W.br( 0 ) ], nil ) ], nil ),
      lg( map ) ] );
   return index;
}

/** Map の 1 からの連続した整数のキーの値を List にする (Lua の ipairs と同じ範囲) */
fn convFilter.fnMapToList() mut : int {
   if! let index = self.adapterMap[ "mapToList" ] {
      return index;
   }
   let index, mut func = self.mod.addFunc( [ self.rt.$mapType ], [ self.rt.$listType ] );
   self.adapterMap[ "mapToList" ] = index;
   self.mod.setFuncName( index, "mapToList" );
   let list = func.addLocal( self.rt.$listType );
   let pos = func.addLocal( W.typeI64 );
   let item = func.addLocal( W.typeAnyRef );
   func.setBody( [
      ls( list, W.call( self.rt.fnListNew(), [ W.i32Const( 4 ) ] ) ),
      W.block( [ W.loop( [
         ls( pos, p( W.opI64Add, [ lg( pos ), W.i64Const( 1 ) ] ) ),
         ls( item, W.call( self.rt.fnMapGet(), [ lg( 0 ), self.rt.boxI64( lg( pos ) ) ] ) ),
         W.brIf( 1, W.refIsNull( lg( item ) ) ),
         W.call( self.rt.fnListPush(), [ lg( list ), lg( item ) ] ),
         W.br( 0 ) ], nil ) ], nil ),
      lg( list ) ] );
   return index;
}

/** 型を変換する */
fn convFilter.coerce( ins:&W.Ins, fromType:&Ast.TypeInfo, toType:&Ast.TypeInfo ) mut : &W.Ins {
   let fromRep = self.getRep( fromType );
   let toRep = self.getRep( toType );
   if fromRep.equalsType( toRep ) {
      return ins;
   }
   if self.isFuncType( fromType ) and self.isFuncType( toType ) {
      return self.adaptClosure( ins, fromType, toType );
   }
   if self.isLuaval( fromType ) and not self.isLuaval( toType ) and self.isFuncType( toType ) {
      return self.luaFuncToClosure( ins, toType );
   }
   if self.isType( fromType, Ast.builtinTypeStem ) and self.isFuncType( toType ) {
      // stem の値が Lua の関数 (_G の値など) の場合は、それを呼び出すクロージャにする
      let work = self.tempLocal( W.typeAnyRef );
      return W.seq( [
         ls( work, ins ),
         W.ifElse( W.refTest( self.rt.$tLuaVal, lg( work ) ),
                   [ self.luaFuncToClosure( lg( work ), toType ) ],
                   [ self.coerceRep( lg( work ), fromRep, toRep ) ], toRep ) ] );
   }
   return self.coerceRep( ins, fromRep, toRep );
}

/**
Lua の関数の値 (Luaval) を、それを呼び出すクロージャに変換する。

例えば、Luaval<form> を form にキャストする場合など。nil は nil のまま。
*/
fn convFilter.luaFuncToClosure( ins:&W.Ins, toType:&Ast.TypeInfo ) mut : &W.Ins {
   let toInfo = self.getFuncCloInfo( toType );
   let key = "luaFunc:%d" ( toInfo.$funcType );
   let adaptType;
   if! let work = self.adapterMap[ key ] {
      adaptType = work;
   } else {
      adaptType = self.mod.addStructType(
         toInfo.$cloType, [ W.field( W.typeI32, true ),
                            W.field( W.refType( toInfo.$funcType ), false ),
                            W.field( W.typeAnyRef, false ) ] );
      self.adapterMap[ key ] = adaptType;
      let funcIndex, mut func = self.mod.addFuncWithType( toInfo.$funcType, 1 + #toInfo.$params );
      self.adapterMap[ key .. ":func" ] = funcIndex;
      let args = func.addLocal( self.rt.$listType );
      let result = func.addLocal( self.rt.$listType );
      let mut body:List<&W.Ins> = [
         ls( args, W.call( self.rt.fnListNew(), [ W.i32Const( #toInfo.$params ) ] ) ) ];
      let toArgs = self.normType( toType ).$argTypeInfoList;
      foreach rep, index in toInfo.$params {
         if self.normType( toArgs[ index ] ).$kind == .DDD {
            body.insert( W.call( self.rt.fnListAppend(), [ lg( args ), lg( index ) ] ) );
         } else {
            body.insert( W.call( self.rt.fnListPush(),
                                 [ lg( args ), self.coerceRep( lg( index ), rep, W.typeAnyRef ) ] ) );
         }
      }
      body.insert( ls( result, W.call( self.rt.fnLuaCallValLazy(),
                                       [ W.structGet( adaptType, 2, W.refCast( adaptType, lg( 0 ) ) ),
                                         lg( args ) ] ) ) );
      let toRetTypes = self.normType( toType ).$retTypeInfoList;
      foreach rep, index in toInfo.$results {
         if self.normType( toRetTypes[ index ] ).$kind == .DDD {
            if index ~= 1 {
               Util.err( "wasm: not support the luaval form -- %s" (toType.getTxt( ## )) );
            }
            body.insert( lg( result ) );
         } else {
            body.insert( self.coerceRep(
               W.call( self.rt.fnListGet(), [ lg( result ), W.i64Const( index ) ] ),
               W.typeAnyRef, rep ) );
         }
      }
      func.setBody( body );
   }
   let funcIndex = unwrap self.adapterMap[ key .. ":func" ];
   let work = self.tempLocal( W.typeAnyRef );
   return W.seq( [
      ls( work, ins ),
      W.ifElse( W.refIsNull( lg( work ) ),
                [ W.refNull( toInfo.$cloType ) ],
                [ W.structNew( adaptType, [ W.i32Const( 0 ), self.mod.refFunc( funcIndex ),
                                            lg( work ) ] ) ],
                W.refType( toInfo.$cloType ) ) ] );
}

fn convFilter.coerceVal( val:&Val, toType:&Ast.TypeInfo ) mut : &W.Ins {
   return self.coerce( val.$ins, val.$typeInfo, toType );
}

/**
クロージャを、別の関数型のクロージャに変換する (アダプタで包む)。

例えば、fn (val:int):int を form として渡す場合など。
*/
fn convFilter.adaptClosure( ins:&W.Ins, fromType:&Ast.TypeInfo, toType:&Ast.TypeInfo ) mut : &W.Ins
{
   let fromInfo = self.getFuncCloInfo( fromType );
   let toInfo = self.getFuncCloInfo( toType );
   let key = "%d:%d" ( fromInfo.$funcType, toInfo.$funcType );
   let adaptType;
   if! let work = self.adapterMap[ key ] {
      adaptType = work;
   } else {
      adaptType = self.mod.addStructType(
         toInfo.$cloType, [ W.field( W.typeI32, true ),
                            W.field( W.refType( toInfo.$funcType ), false ),
                            W.field( W.refType( fromInfo.$cloType ), false ) ] );
      self.adapterMap[ key ] = adaptType;
      let funcIndex, mut func = self.mod.addFuncWithType( toInfo.$funcType, 1 + #toInfo.$params );
      self.adapterMap[ key .. ":func" ] = funcIndex;
      let inner = func.addLocal( W.refType( fromInfo.$cloType ) );
      let mut body:List<&W.Ins> = [
         ls( inner, W.structGet( adaptType, 2, W.refCast( adaptType, lg( 0 ) ) ) ) ];
      // 引数
      let fromArgs = self.normType( fromType ).$argTypeInfoList;
      let toArgs = self.normType( toType ).$argTypeInfoList;
      let toHasDDD = #toArgs > 0 and
          self.normType( toArgs[ #toArgs ] ).$kind == .DDD;
      let mut args:List<&W.Ins> = [ lg( inner ) ];
      foreach fromArg, index in fromArgs {
         let fromRep = self.getRep( fromArg );
         if self.normType( fromArg ).$kind == .DDD {
            if toHasDDD and index == #toArgs {
               args.insert( lg( #toArgs ) );
            } else {
               args.insert( W.call( self.rt.fnListNew(), [ W.i32Const( 0 ) ] ) );
            }
         } elseif toHasDDD and index >= #toArgs {
            // ... の index 番目の要素
            args.insert( self.coerceRep(
               W.call( self.rt.fnListGet(),
                       [ lg( #toArgs ), W.i64Const( index - #toArgs + 1 ) ] ),
               W.typeAnyRef, fromRep ) );
         } elseif index <= #toArgs {
            args.insert( self.coerceRep( lg( index ), self.getRep( toArgs[ index ] ), fromRep ) );
         } else {
            args.insert( self.getDefaultVal( fromRep ) );
         }
      }
      args.insert( W.structGet( fromInfo.$cloType, Rt.fCloCode, lg( inner ) ) );
      body.insert( W.callRef( fromInfo.$funcType, args ) );
      // 戻り値
      let fromRets = fromInfo.$results;
      let toRets = toInfo.$results;
      let mut retLocals:List<int> = [];
      foreach rep in fromRets {
         retLocals.insert( func.addLocal( rep ) );
      }
      for index = #fromRets, 1, -1 {
         body.insert( ls( retLocals[ index ], W.nop() ) );
      }
      let mut rets:List<&W.Ins> = [];
      let toRetTypes = self.normType( toType ).$retTypeInfoList;
      foreach toRep, index in toRets {
         let isDDD = self.normType( toRetTypes[ index ] ).$kind == .DDD;
         if isDDD and index == #toRets {
            // 残りの戻り値をリストにする
            let list = func.addLocal( self.rt.$listType );
            body.insert( ls( list, W.call( self.rt.fnListNew(), [ W.i32Const( 0 ) ] ) ) );
            for work = index, #fromRets {
               body.insert( W.call( self.rt.fnListPush(),
                                    [ lg( list ),
                                      self.coerceRep( lg( retLocals[ work ] ), fromRets[ work ],
                                                      W.typeAnyRef ) ] ) );
            }
            rets.insert( lg( list ) );
         } elseif index <= #fromRets {
            rets.insert( self.coerceRep( lg( retLocals[ index ] ), fromRets[ index ], toRep ) );
         } else {
            rets.insert( self.getDefaultVal( toRep ) );
         }
      }
      body.insert( W.seq( rets ) );
      func.setBody( body );
   }
   let funcIndex = unwrap self.adapterMap[ key .. ":func" ];
   return W.structNew( adaptType, [ W.i32Const( 0 ), self.mod.refFunc( funcIndex ),
                                    W.refCast( fromInfo.$cloType, ins ) ] );
}

/** 値を anyref にする */
fn convFilter.toAny( val:&Val ) mut : &W.Ins {
   return self.coerceRep( val.$ins, val.$rep, W.typeAnyRef );
}

/** Lua の真偽 (nil と false 以外は真) */
fn convFilter.fnTruthy() mut : int {
   if! let index = self.adapterMap[ "truthy" ] {
      return index;
   }
   let index, mut func = self.mod.addFunc( [ W.typeAnyRef ], [ W.typeI32 ] );
   self.adapterMap[ "truthy" ] = index;
   self.mod.setFuncName( index, "truthy" );
   func.setBody( [
      W.ifElse( W.refIsNull( lg( 0 ) ), [ W.ret( [ W.i32Const( 0 ) ] ) ], nil, nil ),
      W.ifElse( W.refTest( self.rt.$tBoxBool, lg( 0 ) ),
                [ W.ret( [ self.rt.unboxBool( lg( 0 ) ) ] ) ], nil, nil ),
      W.i32Const( 1 ) ] );
   return index;
}

/** 値を条件 (i32) にする */
fn convFilter.toCond( val:&Val ) mut : &W.Ins {
   _switch val.$rep.$kind {
      case .I32 {
         return val.$ins;
      }
      case .I64, .F64 {
         return W.seq( [ W.drop( val.$ins ), W.i32Const( 1 ) ] );
      }
      case .Ref {
         if val.$rep.$heapType == W.htAny {
            return W.call( self.fnTruthy(), [ val.$ins ] );
         }
         return p( W.opI32Eqz, [ W.refIsNull( val.$ins ) ] );
      }
   }
}

fn convFilter.lowerCond( node:&Nodes.Node ) mut : &W.Ins {
   return self.toCond( self.lowerVal( node ) );
}

// ======== 式 ========

/** 式の型 (ExpCast は cast 後の型) */
fn convFilter.expTypeOf( node:&Nodes.Node ) : &Ast.TypeInfo {
   if! let castNode = node@@@Nodes.ExpCastNode {
      return castNode.$castType;
   }
   return node.$expType;
}

fn convFilter.newVal( ins:&W.Ins, typeInfo:&Ast.TypeInfo ) mut : &Val {
   return new Val( ins, self.getRep( typeInfo ), typeInfo );
}

/** 式を、その式の型の表現で評価する */
fn convFilter.lowerExp( node:&Nodes.Node ) mut : &W.Ins {
   return self.coerceVal( self.lowerVal( node ), self.expTypeOf( node ) );
}

/** 式を、指定の型の表現で評価する */
fn convFilter.lowerExpAs( node:&Nodes.Node, typeInfo:&Ast.TypeInfo ) mut : &W.Ins {
   return self.coerceVal( self.lowerVal( node ), typeInfo );
}

/** 一時的な局所変数を確保する */
fn convFilter.tempLocal( rep:&W.ValType ) mut : int {
   return self.ctx.addLocal( rep );
}

/** 値のリストから List を生成する。... (DDD) の値は展開する */
fn convFilter.buildList( vals:&List<&Val> ) mut : &W.Ins {
   let list = self.tempLocal( self.rt.$listType );
   let mut body:List<&W.Ins> = [
      ls( list, W.call( self.rt.fnListNew(), [ W.i32Const( #vals ) ] ) ) ];
   foreach val in vals {
      if self.normType( val.$typeInfo ).$kind == .DDD {
         body.insert( W.call( self.rt.fnListAppend(), [ lg( list ), val.$ins ] ) );
      } else {
         body.insert( W.call( self.rt.fnListPush(), [ lg( list ), self.toAny( val ) ] ) );
      }
   }
   body.insert( lg( list ) );
   return W.seq( body );
}

/**
式のリストを評価し、値のリストにする。多値は展開する。

多値がある場合、評価順序を保つために全ての値を局所変数に入れる。その命令は pre に追加する。
*/
fn convFilter.lowerValList( expList:&Nodes.ExpListNode, mut pre:List<&W.Ins> ) mut : &List<&Val> {
   return self.lowerValListSub( expList, pre, false );
}
/**
@param raw true の場合、多値の式の暗黙の cast をしない (nil の判定の前の値として使う場合)
*/
fn convFilter.lowerValListSub( expList:&Nodes.ExpListNode, mut pre:List<&W.Ins>, raw:bool )
   mut : &List<&Val>
{
   let mut vals:List<&Val> = [];
   let mRetIndex;
   if! let mRetExp = expList.$mRetExp {
      mRetIndex = mRetExp.$index;
   } else {
      mRetIndex = 0;
   }
   // 暗黙の cast で包まれた多値 (a, b = f(); の各値)。同じ多値の式を値ごとに cast している
   let mut castMRet:&Nodes.Node! = nil;
   let mut castMRetVals:&List<&Val> = [];
   let mut castMRetPos = 0;
   foreach exp, index in expList.$expList {
      let mut mretInCast:&Nodes.Node! = nil;
      let mut castType = exp.$expType;
      // 多値の式そのもの (cast していない値)。後ろの値が同じ式を cast している場合に使う
      let mut isRawMRet = false;
      if! let castNode = exp@@@Nodes.ExpCastNode {
         if castNode.$castKind == .Implicit and
            castNode.$exp.$kind == Nodes.NodeKind.$ExpMRet
         {
            mretInCast = castNode.$exp;
            // Implicit の cast の expType は cast 前の型なので、cast 後の型を使う
            castType = castNode.$castType;
         }
      } elseif exp.$kind == Nodes.NodeKind.$ExpMRet {
         foreach other in expList.$expList {
            if! let otherCast = other@@@Nodes.ExpCastNode {
               if otherCast.$exp == exp {
                  mretInCast = exp;
                  isRawMRet = true;
               }
            }
         }
      }
      if mretInCast {
         let mret = unwrap mretInCast;
         if castMRet ~= mret {
            castMRet = mret;
            // 同じ多値の式を参照している cast と ExpAccessMRet の数だけ値を取り出す
            let mut num = 0;
            foreach other in expList.$expList {
               if! let otherCast = other@@@Nodes.ExpCastNode {
                  if otherCast.$exp == mret {
                     num = num + 1;
                  }
               } elseif other == mret or self.isAccessOf( other, mret ) {
                  num = num + 1;
               }
            }
            castMRetVals = self.expandDDD( self.lowerMulti( mret, pre ), num, pre );
            castMRetPos = 0;
         }
         castMRetPos = castMRetPos + 1;
         let val;
         if castMRetPos <= #castMRetVals {
            val = castMRetVals[ castMRetPos ];
         } else {
            val = new Val( W.refNull( W.htAny ), W.typeAnyRef, Ast.builtinTypeNil );
         }
         if isRawMRet or raw {
            vals.insert( val );
         } else {
            vals.insert( new Val( self.coerceVal( val, castType ),
                                  self.getRep( castType ), castType ) );
         }
      } elseif castMRet and self.isAccessOf( exp, unwrap castMRet ) {
         // cast した多値の式の残りの値 (a, b = f(); で a だけを cast する場合)
         castMRetPos = castMRetPos + 1;
         if castMRetPos <= #castMRetVals {
            vals.insert( castMRetVals[ castMRetPos ] );
         } else {
            vals.insert( new Val( W.refNull( W.htAny ), W.typeAnyRef, Ast.builtinTypeNil ) );
         }
      } elseif exp.$kind == Nodes.NodeKind.$ExpAccessMRet {
         // 多値の 2 番目以降の値は、lowerMulti で展開済み
      } elseif index == mRetIndex or
         ( index == #expList.$expList and exp.$kind == Nodes.NodeKind.$ExpMRet )
      {
         foreach val in self.lowerMulti( exp, pre ) {
            vals.insert( val );
         }
      } elseif mRetIndex > 0 {
         let val = self.lowerVal( exp );
         let work = self.tempLocal( val.$rep );
         pre.insert( ls( work, val.$ins ) );
         vals.insert( new Val( lg( work ), val.$rep, val.$typeInfo ) );
      } else {
         vals.insert( self.lowerVal( exp ) );
      }
   }
   return vals;
}

/** node が、多値の式 mret (ExpMRetNode) の値を参照する ExpAccessMRet かどうか */
fn convFilter.isAccessOf( node:&Nodes.Node, mret:&Nodes.Node ) : bool {
   let! accessNode = node@@@Nodes.ExpAccessMRetNode {
      return false;
   };
   if accessNode.$mRet == mret {
      return true;
   }
   if! let mretNode = mret@@@Nodes.ExpMRetNode {
      return accessNode.$mRet == mretNode.$mRet;
   }
   return false;
}

/** 多値の式を評価し、各値を局所変数に入れる */
fn convFilter.lowerMulti( node:&Nodes.Node, mut pre:List<&W.Ins> ) mut : &List<&Val> {
   let mut work = node;
   if! let mretNode = node@@@Nodes.ExpMRetNode {
      work = mretNode.$mRet;
   }
   // 多値を返すマクロ (: __exps) は、展開した式を使う
   while true {
      let! macroNode = work@@@Nodes.ExpMacroExpNode {
         break;
      };
      if #macroNode.$stmtList ~= 1 {
         break;
      }
      let stmt = macroNode.$stmtList[ 1 ];
      if! let stmtExp = stmt@@@Nodes.StmtExpNode {
         work = stmtExp.$exp;
      } else {
         work = stmt;
      }
   }
   let! callNode = work@@@Nodes.ExpCallNode {
      let val = self.lowerVal( work );
      let tmp = self.tempLocal( val.$rep );
      pre.insert( ls( tmp, val.$ins ) );
      return [ new Val( lg( tmp ), val.$rep, val.$typeInfo ) ];
   };
   let ins, retTypes = self.lowerCall( callNode );
   pre.insert( ins );
   let mut locals:List<int> = [];
   foreach retType in retTypes {
      locals.insert( self.tempLocal( self.getRep( retType ) ) );
   }
   for index = #locals, 1, -1 {
      pre.insert( ls( locals[ index ], W.nop() ) );
   }
   let mut vals:List<&Val> = [];
   foreach retType, index in retTypes {
      vals.insert( new Val( lg( locals[ index ] ), self.getRep( retType ), retType ) );
   }
   return vals;
}

/** 文字列リテラルのトークンを、バイト列に変換する。 */
fn convFilter.decodeString( node:&Nodes.Node, txt:str ) : str {
   let quote = txt.sub( 1, 1 );
   if quote == "`" {
      // ```...``` 形式。Lua の長括弧の文字列と同じく、先頭の改行は除く
      let body = txt.sub( 4, #txt - 3 );
      if body.sub( 1, 2 ) == "\r\n" {
         return body.sub( 3 ## );
      }
      if body.sub( 1, 1 ) == "\n" or body.sub( 1, 1 ) == "\r" {
         return body.sub( 2 ## );
      }
      return body;
   }
   let body = txt.sub( 2, #txt - 1 );
   let mut result = "";
   let mut pos = 1;
   while pos <= #body {
      let ch = body.sub( pos, pos );
      if ch ~= "\\" {
         result = result .. ch;
         pos = pos + 1;
      } else {
         let next = body.sub( pos + 1, pos + 1 );
         pos = pos + 2;
         switch next {
            case "n" {
               result = result .. "\n";
            }
            case "t" {
               result = result .. "\t";
            }
            case "r" {
               result = result .. "\r";
            }
            case "a" {
               result = result .. W.byte( 7 );
            }
            case "b" {
               result = result .. W.byte( 8 );
            }
            case "f" {
               result = result .. W.byte( 12 );
            }
            case "v" {
               result = result .. W.byte( 11 );
            }
            case "\\", "\"", "'" {
               result = result .. next;
            }
            case "x" {
               let hex = body.sub( pos, pos + 1 );
               let! val = tonumber( hex, 16 ) {
                  self.error( node, "illegal escape -- %s" (txt) );
               };
               result = result .. W.byte( val@@int );
               pos = pos + 2;
            }
            default {
               // \ddd (10 進数、最大 3 桁)
               let mut val = 0;
               let mut count = 0;
               pos = pos - 1;
               while count < 3 {
                  let! code = body.byte( pos ## ) {
                     break;
                  };
                  if code < 0x30 or code > 0x39 {
                     break;
                  }
                  val = val * 10 + code - 0x30;
                  count = count + 1;
                  pos = pos + 1;
               }
               if count == 0 {
                  self.error( node, "illegal escape -- %s" (txt) );
               }
               result = result .. W.byte( val );
            }
         }
      }
   }
   return result;
}

fn convFilter.lowerLiteralString( node:&Nodes.LiteralStringNode ) mut : &W.Ins {
   let data = self.decodeString( node, node.$token.txt );
   let fmt = self.rt.strLiteral( data );
   if! let param = node.$orgParam {
      let mut pre:List<&W.Ins> = [];
      let vals = self.lowerValList( param, pre );
      pre.insert( W.call( self.rt.fnFormat(), [ fmt, self.buildList( vals ) ] ) );
      return W.seq( pre );
   }
   return fmt;
}

/** 等価比較 (結果は i32) */
fn convFilter.lowerEqVals( val1:&Val, val2:&Val ) mut : &W.Ins {
   let rep1 = val1.$rep;
   let rep2 = val2.$rep;
   if isScalar( rep1 ) and isScalar( rep2 ) {
      if rep1.$kind == .I32 or rep2.$kind == .I32 {
         return p( W.opI32Eq, [ val1.$ins, val2.$ins ] );
      }
      if rep1.$kind == .I64 and rep2.$kind == .I64 {
         return p( W.opI64Eq, [ val1.$ins, val2.$ins ] );
      }
      return p( W.opF64Eq, [ self.coerceRep( val1.$ins, rep1, W.typeF64 ),
                             self.coerceRep( val2.$ins, rep2, W.typeF64 ) ] );
   }
   if val1.$typeInfo == Ast.builtinTypeNil and rep2.isRef() {
      return W.refIsNull( val2.$ins );
   }
   if val2.$typeInfo == Ast.builtinTypeNil and rep1.isRef() {
      return W.refIsNull( val1.$ins );
   }
   if rep1.equalsType( self.rt.$strType ) and rep2.equalsType( self.rt.$strType ) {
      return W.call( self.rt.fnStrEq(), [ val1.$ins, val2.$ins ] );
   }
   return W.call( self.rt.fnEqAny(), [ self.toAny( val1 ), self.toAny( val2 ) ] );
}

/** 大小比較 (結果は i32) */
fn convFilter.lowerCompare( node:&Nodes.Node, opTxt:str, val1:&Val, val2:&Val ) mut : &W.Ins {
   let rep1 = val1.$rep;
   let rep2 = val2.$rep;
   if ( rep1.$kind == .I64 or rep1.$kind == .F64 ) and ( rep2.$kind == .I64 or rep2.$kind == .F64 )
   {
      if rep1.$kind == .I64 and rep2.$kind == .I64 {
         return p( unwrap i64CmpOpMap[ opTxt ], [ val1.$ins, val2.$ins ] );
      }
      return p( unwrap f64CmpOpMap[ opTxt ],
                [ self.coerceRep( val1.$ins, rep1, W.typeF64 ),
                  self.coerceRep( val2.$ins, rep2, W.typeF64 ) ] );
   }
   if rep1.equalsType( self.rt.$strType ) and rep2.equalsType( self.rt.$strType ) {
      return p( unwrap strCmpOpMap[ opTxt ],
                [ W.call( self.rt.fnStrCmp(), [ val1.$ins, val2.$ins ] ), W.i32Const( 0 ) ] );
   }
   let any1 = self.toAny( val1 );
   let any2 = self.toAny( val2 );
   let less = self.rt.fnLessAny();
   switch opTxt {
      case "<" {
         return W.call( less, [ any1, any2 ] );
      }
      case ">" {
         return W.call( less, [ any2, any1 ] );
      }
      case "<=" {
         return p( W.opI32Eqz, [ W.call( less, [ any2, any1 ] ) ] );
      }
      case ">=" {
         return p( W.opI32Eqz, [ W.call( less, [ any1, any2 ] ) ] );
      }
   }
   self.error( node, "illegal op -- %s" (opTxt) );
}

/** and / or */
fn convFilter.lowerAndOr( node:&Nodes.ExpOp2Node ) mut : &Val {
   let opTxt = node.$op.txt;
   let resultType = node.$expType;
   let resultRep = self.getRep( resultType );
   if resultRep.$kind == .I32 {
      let cond1 = self.lowerCond( node.$exp1 );
      let cond2 = self.lowerCond( node.$exp2 );
      if opTxt == "and" {
         return new Val( W.ifElse( cond1, [ cond2 ], [ W.i32Const( 0 ) ], W.typeI32 ),
                         W.typeI32, resultType );
      }
      return new Val( W.ifElse( cond1, [ W.i32Const( 1 ) ], [ cond2 ], W.typeI32 ),
                      W.typeI32, resultType );
   }
   // Lua と同じく、オペランドの値を返す
   let val1 = self.lowerVal( node.$exp1 );
   // オペランドを式の型の表現に変換できない場合 (1 and "2" or 3.0 など) は、stem にする
   let mut valType = resultType;
   let mut valRep = resultRep;
   foreach opType in [ val1.$typeInfo, node.$exp2.$expType ] {
      let opRep = self.getRep( opType );
      if not opRep.equalsType( valRep ) and valRep.$kind ~= .Ref or
         valRep.$kind == .Ref and valRep.$heapType ~= W.htAny and isScalar( opRep )
      {
         valType = Ast.builtinTypeStem_;
         valRep = W.typeAnyRef;
      }
   }
   let work = self.tempLocal( val1.$rep );
   let cond = self.toCond( new Val( lg( work ), val1.$rep, val1.$typeInfo ) );
   let first = self.coerce( lg( work ), val1.$typeInfo, valType );
   let second = self.lowerExpAs( node.$exp2, valType );
   let ins;
   if opTxt == "and" {
      ins = W.ifElse( cond, [ second ], [ first ], valRep );
   } else {
      ins = W.ifElse( cond, [ first ], [ second ], valRep );
   }
   return new Val( W.seq( [ ls( work, val1.$ins ), ins ] ), valRep, valType );
}

/** 文字列にする */
fn convFilter.toStr( val:&Val ) mut : &W.Ins {
   if val.$rep.equalsType( self.rt.$strType ) {
      return val.$ins;
   }
   _switch val.$rep.$kind {
      case .I64 {
         return W.call( self.rt.fnI64ToStr(), [ val.$ins ] );
      }
      case .F64 {
         return W.call( self.rt.fnRealToStr(), [ val.$ins ] );
      }
      case .I32 {
         return W.ifElse( val.$ins, [ self.rt.strLiteral( "true" ) ],
                          [ self.rt.strLiteral( "false" ) ], self.rt.$strType );
      }
      case .Ref {
         return W.call( self.rt.fnToStr(), [ val.$ins ] );
      }
   }
}

/** 二項演算 */
fn convFilter.lowerOp2( node:&Nodes.ExpOp2Node ) mut : &Val {
   let opTxt = node.$op.txt;
   let resultType = node.$expType;
   switch opTxt {
      case "and", "or" {
         return self.lowerAndOr( node );
      }
      case ".." {
         return self.newVal(
            W.call( self.rt.fnStrConcat(), [ self.toStr( self.lowerVal( node.$exp1 ) ),
                                             self.toStr( self.lowerVal( node.$exp2 ) ) ] ),
            resultType );
      }
      case "==", "~=" {
         let eq = self.lowerEqVals( self.lowerVal( node.$exp1 ), self.lowerVal( node.$exp2 ) );
         if opTxt == "==" {
            return self.newVal( eq, resultType );
         }
         return self.newVal( p( W.opI32Eqz, [ eq ] ), resultType );
      }
      case "<", "<=", ">", ">=" {
         return self.newVal( self.lowerCompare( node, opTxt, self.lowerVal( node.$exp1 ),
                                                self.lowerVal( node.$exp2 ) ), resultType );
      }
   }

   // 算術演算・ビット演算
   let resultRep = self.getRep( resultType );
   if resultRep.$kind == .I64 {
      let exp1 = self.lowerExpAs( node.$exp1, Ast.builtinTypeInt );
      let exp2 = self.lowerExpAs( node.$exp2, Ast.builtinTypeInt );
      let mut ins:&W.Ins! = nil;
      switch opTxt {
         case "+" { ins = p( W.opI64Add, [ exp1, exp2 ] ); }
         case "-" { ins = p( W.opI64Sub, [ exp1, exp2 ] ); }
         case "*" { ins = p( W.opI64Mul, [ exp1, exp2 ] ); }
         case "/" { ins = W.call( self.fnDivI64(), [ exp1, exp2 ] ); }
         case "%" { ins = W.call( self.fnModI64(), [ exp1, exp2 ] ); }
         case "&" { ins = p( W.opI64And, [ exp1, exp2 ] ); }
         case "|" { ins = p( W.opI64Or, [ exp1, exp2 ] ); }
         case "~" { ins = p( W.opI64Xor, [ exp1, exp2 ] ); }
         // Lua と同じ動作にするため、ランタイムの関数で処理する
         case "|<<" { ins = W.call( self.fnShift( true ), [ exp1, exp2 ] ); }
         case "|>>" { ins = W.call( self.fnShift( false ), [ exp1, exp2 ] ); }
      }
      when! ins {
         return new Val( ins, resultRep, resultType );
      }
   }
   if resultRep.$kind == .F64 {
      let exp1 = self.lowerExpAs( node.$exp1, Ast.builtinTypeReal );
      let exp2 = self.lowerExpAs( node.$exp2, Ast.builtinTypeReal );
      let mut ins:&W.Ins! = nil;
      switch opTxt {
         case "+" { ins = p( W.opF64Add, [ exp1, exp2 ] ); }
         case "-" { ins = p( W.opF64Sub, [ exp1, exp2 ] ); }
         case "*" { ins = p( W.opF64Mul, [ exp1, exp2 ] ); }
         case "/" { ins = p( W.opF64Div, [ exp1, exp2 ] ); }
         case "%" { ins = W.call( self.fnModF64(), [ exp1, exp2 ] ); }
      }
      when! ins {
         return new Val( ins, resultRep, resultType );
      }
   }
   self.error( node, "not support op -- %s (%s)" ( opTxt, resultType.getTxt( ## ) ) );
}

/** 単項演算 */
fn convFilter.lowerOp1( node:&Nodes.ExpOp1Node ) mut : &Val {
   let opTxt = node.$op.txt;
   let resultType = node.$expType;
   let val = self.lowerVal( node.$exp );
   switch opTxt {
      case "-" {
         if val.$rep.$kind == .I64 {
            return self.newVal( p( W.opI64Sub, [ W.i64Const( 0 ), val.$ins ] ), resultType );
         }
         if val.$rep.$kind == .F64 {
            return self.newVal( p( W.opF64Neg, [ val.$ins ] ), resultType );
         }
      }
      case "not" {
         return self.newVal( p( W.opI32Eqz, [ self.toCond( val ) ] ), resultType );
      }
      case "#" {
         if self.isLuaval( node.$exp.$expType ) {
            return self.newVal( W.call( self.rt.fnLuaLen(), [ self.toAny( val ) ] ), resultType );
         }
         if val.$rep.equalsType( self.rt.$strType ) {
            return self.newVal( p( W.opI64ExtendI32U, [ W.arrayLen( val.$ins ) ] ), resultType );
         }
         if val.$rep.equalsType( self.rt.$listType ) {
            return self.newVal(
               p( W.opI64ExtendI32U, [ W.structGet( self.rt.$tList, Rt.fListLen, val.$ins ) ] ),
               resultType );
         }
         if val.$rep.equalsType( self.rt.$mapType ) {
            // Map の要素数
            return self.newVal(
               p( W.opI64ExtendI32U, [ W.structGet( self.rt.$tMap, Rt.fMapCount, val.$ins ) ] ),
               resultType );
         }
      }
      case "~" {
         if val.$rep.$kind == .I64 {
            return self.newVal( p( W.opI64Xor, [ val.$ins, W.i64Const( -1 ) ] ), resultType );
         }
      }
   }
   self.error( node, "not support op -- %s (%s)" ( opTxt, val.$typeInfo.getTxt( ## ) ) );
}

/** 整数の除算 (Lua と同じく、負の方向に丸める) */
fn convFilter.fnDivI64() mut : int {
   if! let index = self.adapterMap[ "divI64" ] {
      return index;
   }
   let index, mut func = self.mod.addFunc( [ W.typeI64, W.typeI64 ], [ W.typeI64 ] );
   self.adapterMap[ "divI64" ] = index;
   let q = func.addLocal( W.typeI64 );
   func.setBody( [
      ls( q, p( W.opI64DivS, [ lg( 0 ), lg( 1 ) ] ) ),
      W.ifElse(
         p( W.opI32And,
            [ p( W.opI64Ne, [ p( W.opI64RemS, [ lg( 0 ), lg( 1 ) ] ), W.i64Const( 0 ) ] ),
              p( W.opI32Ne, [ p( W.opI64LtS, [ lg( 0 ), W.i64Const( 0 ) ] ),
                              p( W.opI64LtS, [ lg( 1 ), W.i64Const( 0 ) ] ) ] ) ] ),
         [ ls( q, p( W.opI64Sub, [ lg( q ), W.i64Const( 1 ) ] ) ) ], nil, nil ),
      lg( q ) ] );
   return index;
}

/** 整数の剰余 (結果の符号は除数と同じ) */
fn convFilter.fnModI64() mut : int {
   if! let index = self.adapterMap[ "modI64" ] {
      return index;
   }
   let index, mut func = self.mod.addFunc( [ W.typeI64, W.typeI64 ], [ W.typeI64 ] );
   self.adapterMap[ "modI64" ] = index;
   let r = func.addLocal( W.typeI64 );
   func.setBody( [
      ls( r, p( W.opI64RemS, [ lg( 0 ), lg( 1 ) ] ) ),
      W.ifElse(
         p( W.opI32And,
            [ p( W.opI64Ne, [ lg( r ), W.i64Const( 0 ) ] ),
              p( W.opI32Ne, [ p( W.opI64LtS, [ lg( r ), W.i64Const( 0 ) ] ),
                              p( W.opI64LtS, [ lg( 1 ), W.i64Const( 0 ) ] ) ] ) ] ),
         [ ls( r, p( W.opI64Add, [ lg( r ), lg( 1 ) ] ) ) ], nil, nil ),
      lg( r ) ] );
   return index;
}

/** real の剰余 a - floor( a / b ) * b */
fn convFilter.fnModF64() mut : int {
   if! let index = self.adapterMap[ "modF64" ] {
      return index;
   }
   let index, mut func = self.mod.addFunc( [ W.typeF64, W.typeF64 ], [ W.typeF64 ] );
   self.adapterMap[ "modF64" ] = index;
   func.setBody( [
      p( W.opF64Sub,
         [ lg( 0 ), p( W.opF64Mul, [ p( W.opF64Floor, [ p( W.opF64Div, [ lg( 0 ), lg( 1 ) ] ) ] ),
                                     lg( 1 ) ] ) ] ) ] );
   return index;
}

/** シフト (Lua と同じ動作。論理シフトで、シフト量が 64 以上なら 0、負なら逆方向) */
fn convFilter.fnShift( left:bool ) mut : int {
   let name;
   let code;
   let revCode;
   if left {
      name = "shiftL";
      code = W.opI64Shl;
      revCode = W.opI64ShrU;
   } else {
      name = "shiftR";
      code = W.opI64ShrU;
      revCode = W.opI64Shl;
   }
   if! let index = self.adapterMap[ name ] {
      return index;
   }
   let index, mut func = self.mod.addFunc( [ W.typeI64, W.typeI64 ], [ W.typeI64 ] );
   self.adapterMap[ name ] = index;
   self.mod.setFuncName( index, name );
   func.setBody( [
      W.ifElse( p( W.opI32Or, [ p( W.opI64LeS, [ lg( 1 ), W.i64Const( -64 ) ] ),
                                p( W.opI64GeS, [ lg( 1 ), W.i64Const( 64 ) ] ) ] ),
                [ W.ret( [ W.i64Const( 0 ) ] ) ], nil, nil ),
      W.ifElse( p( W.opI64LtS, [ lg( 1 ), W.i64Const( 0 ) ] ),
                [ W.ret( [ p( revCode, [ lg( 0 ), p( W.opI64Sub, [ W.i64Const( 0 ),
                                                                  lg( 1 ) ] ) ] ) ] ) ],
                nil, nil ),
      p( code, [ lg( 0 ), lg( 1 ) ] ) ] );
   return index;
}

/** cast */
fn convFilter.lowerCast( node:&Nodes.ExpCastNode ) mut : &Val {
   let castType = node.$castType;
   let val = self.lowerVal( node.$exp );
   let castRep = self.getRep( castType );
   if node.$castKind == .Normal {
      // @@@: 型が一致しない場合は nil
      let work = self.tempLocal( W.typeAnyRef );
      let anyVal = self.toAny( val );
      let dstType = self.normType( castType );
      let test;
      if dstType.equals( self.processInfo, Ast.builtinTypeInt ## ) {
         // Lua と同じく、整数値の実数も int として扱う
         test = W.call( self.fnIsIntVal(), [ lg( work ) ] );
      } elseif dstType.equals( self.processInfo, Ast.builtinTypeReal ## ) {
         test = p( W.opI32Or, [ W.refTest( self.rt.$tBoxF64, lg( work ) ),
                                W.refTest( self.rt.$tBoxI64, lg( work ) ) ] );
      } elseif dstType.equals( self.processInfo, Ast.builtinTypeBool ## ) {
         test = W.refTest( self.rt.$tBoxBool, lg( work ) );
      } else {
         let dstRep = self.getRep( dstType );
         if dstRep.$heapType == W.htAny {
            test = p( W.opI32Eqz, [ W.refIsNull( lg( work ) ) ] );
         } else {
            test = W.refTest( dstRep.$heapType, lg( work ) );
         }
      }
      // 結果は nilable
      let resultType = castType.$nilableTypeInfo;
      let resultRep = self.getRep( resultType );
      let mut okVal = lg( work );
      if dstType.equals( self.processInfo, Ast.builtinTypeReal ## ) {
         okVal = self.rt.boxF64( self.rt.unboxF64( lg( work ) ) );
      } elseif dstType.equals( self.processInfo, Ast.builtinTypeInt ## ) {
         okVal = self.rt.boxI64( p( W.opI64TruncF64S, [ self.rt.unboxF64( lg( work ) ) ] ) );
      }
      return new Val(
         W.seq( [ ls( work, anyVal ),
                  W.ifElse( test, [ self.coerceRep( okVal, W.typeAnyRef, resultRep ) ],
                            [ W.refNull( resultRep.$heapType ) ], resultRep ) ] ),
         resultRep, resultType );
   }
   return new Val( self.coerce( val.$ins, val.$typeInfo, castType ), castRep, castType );
}

/** 整数値かどうか (整数値の実数を含む) */
fn convFilter.fnIsIntVal() mut : int {
   if! let index = self.adapterMap[ "isIntVal" ] {
      return index;
   }
   let index, mut func = self.mod.addFunc( [ W.typeAnyRef ], [ W.typeI32 ] );
   self.adapterMap[ "isIntVal" ] = index;
   self.mod.setFuncName( index, "isIntVal" );
   let fval = func.addLocal( W.typeF64 );
   func.setBody( [
      W.ifElse( W.refTest( self.rt.$tBoxI64, lg( 0 ) ), [ W.ret( [ W.i32Const( 1 ) ] ) ], nil, nil ),
      W.ifElse( p( W.opI32Eqz, [ W.refTest( self.rt.$tBoxF64, lg( 0 ) ) ] ),
                [ W.ret( [ W.i32Const( 0 ) ] ) ], nil, nil ),
      ls( fval, self.rt.unboxF64( lg( 0 ) ) ),
      p( W.opI32And, [ p( W.opF64Eq, [ p( W.opF64Trunc, [ lg( fval ) ] ), lg( fval ) ] ),
                       p( W.opF64Lt, [ p( W.opF64Abs, [ lg( fval ) ] ), W.f64Const( 9.2e18 ) ] ) ] ) ] );
   return index;
}

/** unwrap */
fn convFilter.lowerUnwrap( node:&Nodes.ExpUnwrapNode ) mut : &Val {
   let resultType = node.$expType;
   let resultRep = self.getRep( resultType );
   let val = self.lowerVal( node.$exp );
   let work = self.tempLocal( val.$rep );
   let elseBody;
   if! let defNode = node.$default {
      elseBody = self.lowerExpAs( defNode, resultType );
   } else {
      elseBody = self.rt.error( self.rt.strLiteral( "unwrap nil" ) );
   }
   return new Val(
      W.seq( [ ls( work, val.$ins ),
               W.ifElse( W.refIsNull( lg( work ) ),
                         [ elseBody ],
                         [ self.coerce( lg( work ), val.$typeInfo, resultType ) ],
                         resultRep ) ] ),
      resultRep, resultType );
}

/** List / Array / Set / Map のリテラル */
fn convFilter.lowerLiteralColl( node:&Nodes.Node, expList:&Nodes.ExpListNode!,
                                isSet:bool ) mut : &Val
{
   let mut pre:List<&W.Ins> = [];
   let mut vals:&List<&Val> = [];
   when! expList {
      vals = self.lowerValList( expList, pre );
   }
   if isSet {
      let set = self.tempLocal( self.rt.$mapType );
      pre.insert( ls( set, self.rt.newMap() ) );
      foreach val in vals {
         let work = self.tempLocal( W.typeAnyRef );
         pre.insert( ls( work, self.toAny( val ) ) );
         pre.insert( W.call( self.rt.fnMapSet(), [ lg( set ), lg( work ), lg( work ) ] ) );
      }
      pre.insert( lg( set ) );
   } else {
      pre.insert( self.buildList( vals ) );
   }
   return self.newVal( W.seq( pre ), node.$expType );
}

fn convFilter.lowerLiteralMap( node:&Nodes.LiteralMapNode ) mut : &Val {
   let map = self.tempLocal( self.rt.$mapType );
   let mut body:List<&W.Ins> = [ ls( map, self.rt.newMap() ) ];
   foreach pair in node.$pairList {
      body.insert( W.call( self.rt.fnMapSet(),
                           [ lg( map ), self.toAny( self.lowerVal( pair.$key ) ),
                             self.toAny( self.lowerVal( pair.$val ) ) ] ) );
   }
   body.insert( lg( map ) );
   return self.newVal( W.seq( body ), node.$expType );
}

/** オブジェクトの型 (generics の型パラメータは制約の型) */
fn convFilter.getObjType( typeInfo:&Ast.TypeInfo ) : &Ast.TypeInfo {
   let work = self.normType( typeInfo );
   if work.$kind == .Alternate {
      if work.hasBase() {
         return self.getObjType( work.$baseTypeInfo );
      }
      // インタフェースの制約を持つ型パラメータ (T:(IF)) は、そのインタフェースとして扱う
      if #work.$interfaceList > 0 {
         return self.getObjType( work.$interfaceList[ 1 ] );
      }
   }
   return work;
}

/**
メソッド name を呼び出すオブジェクトの型。

複数のインタフェースの制約を持つ型パラメータ (T:(IF1,IF2)) の場合は、name を持つインタフェースを返す。
*/
fn convFilter.getObjTypeForMethod( typeInfo:&Ast.TypeInfo, name:str ) : &Ast.TypeInfo {
   let work = self.normType( typeInfo );
   if work.$kind == .Alternate and not work.hasBase() {
      foreach ifType in work.$interfaceList {
         if self.getIfMethodType( ifType, name ) {
            return self.getObjType( ifType );
         }
      }
   }
   return self.getObjType( typeInfo );
}

/** オブジェクトのメンバを参照する */
fn convFilter.lowerMemberRef( node:&Nodes.Node, prefix:&Nodes.Node, name:str ) mut : &Val {
   let objType = self.getObjType( prefix.$expType );
   let! info = self.getClassInfo( objType ) {
      self.error( node, "not found class -- %s" ( objType.getTxt( ## ) ) );
   };
   let fieldIndex = self.getFieldIndex( node, info, name );
   let rep = info.$fieldReps[ fieldIndex - 1 ];
   let obj = self.lowerExpAs( prefix, info.$typeInfo );
   let memberType = self.getMemberType( info, name );
   return new Val( W.structGet( info.$structType, fieldIndex,
                                W.refCast( info.$structType, obj ) ), rep, memberType );
}

/** クラスのメンバの型 (宣言時の型) */
fn convFilter.getMemberType( info:&ClassInfo, name:str ) : &Ast.TypeInfo {
   let mut work:&ClassInfo! = info;
   while true {
      let! classInfo = work {
         break;
      };
      if! let scope = classInfo.$typeInfo.$scope {
         if! let symbol = scope.$symbol2SymbolInfoMap[ name ] {
            return symbol.$typeInfo;
         }
      }
      work = classInfo.$parent;
   }
   return Ast.builtinTypeStem_;
}

/** RefField (prefix.field) */
fn convFilter.lowerRefField( node:&Nodes.RefFieldNode ) mut : &Val {
   if! let initIns = self.getLazyInit( node.$prefix ) {
      let val = self.lowerRefFieldSub( node );
      return new Val( W.seq( [ initIns, val.$ins ] ), val.$rep, val.$typeInfo );
   }
   return self.lowerRefFieldSub( node );
}
fn convFilter.lowerRefFieldSub( node:&Nodes.RefFieldNode ) mut : &Val {
   let prefix = node.$prefix;
   let fieldName = node.$field.txt;
   let prefixType = self.normType( prefix.$expType );
   if! let modType = self.getExtModuleType( prefix.$expType ) {
      // Lua のモジュールのメンバ
      return new Val( W.call( self.rt.fnLuaGetAt(),
                              [ self.lowerExtModuleVal( node, modType ),
                                self.rt.strLiteral( fieldName ) ] ),
                      W.typeAnyRef, Ast.builtinTypeStem_ );
   }
   if self.isLuaval( prefix.$expType ) {
      // Lua の値のメンバ (Lua の obj.name)
      return new Val( W.call( self.rt.fnLuaGetAt(),
                              [ self.lowerExpAs( prefix, Ast.builtinTypeStem_ ),
                                self.rt.strLiteral( fieldName ) ] ),
                      W.typeAnyRef, Ast.builtinTypeStem_ );
   }
   if! let symbol = node.$symbolInfo {
      // static メンバ、enum の値など
      let orgSym = symbol.getOrg();
      // __lns.runMode などの builtin の定数 (convLua の builtinSym2code と同じ)
      let builtin = self.builtinFuncs;
      let builtinConstMap:&Map<&Ast.SymbolInfo,int> = {
         builtin.__lns_runmode_Sync_sym: __lns.runMode.Sync,
         builtin.__lns_runmode_Queue_sym: __lns.runMode.Queue,
         builtin.__lns_runmode_Skip_sym: __lns.runMode.Skip,
      };
      if! let val = builtinConstMap[ orgSym ] {
         return self.newVal( W.i64Const( val ), Ast.builtinTypeInt );
      }
      if orgSym == builtin.__lns_capability_async_sym {
         // wasm は 1 スレッドなので、非同期処理はできない
         return self.newVal( W.i32Const( 0 ), Ast.builtinTypeBool );
      }
      if! self.globalSym2loc[ orgSym ] {
         return new Val( self.readSym( node, orgSym ), self.getRep( orgSym.$typeInfo ),
                         orgSym.$typeInfo );
      }
      if orgSym.$typeInfo.$kind == .Enum or prefixType.$kind == .Enum {
         if! let enumType = self.normType( orgSym.$typeInfo )@@@Ast.EnumTypeInfo {
            if! let valInfo = enumType.$name2EnumValInfo[ fieldName ] {
               return self.lowerEnumVal( enumType, valInfo );
            }
         }
      }
      if orgSym.$name == "stdout" or orgSym.$name == "stderr" {
         if prefix.$kind == Nodes.NodeKind.$ExpRef {
            return new Val( W.globalGet( self.getStdStream( orgSym.$name == "stdout" ) ),
                            self.rt.$objType, orgSym.$typeInfo );
         }
      }
   }
   if prefix.$kind == Nodes.NodeKind.$ExpRef and prefixType.$kind == .Module {
      // builtin のモジュール (io、package) の変数 (io.stdout と同じく名前で判定する)。
      // builtin のモジュールの型の名前は "@io" のように @ が付いている
      let modName = prefixType.$rawTxt.gsub( "^@", "" );
      if modName == "io" and fieldName == "stdin" {
         return new Val( W.globalGet( self.getStdinGlobal() ), self.rt.$objType,
                         node.$expType );
      }
      if modName == "package" and fieldName == "path" {
         // Lua の package.path (環境変数 LUA_PATH で変更できる)
         return new Val( W.refCast( self.rt.$tStr,
                                    self.rt.listItem(
                                       W.call( self.rt.fnLuaCall(),
                                               [ W.i32Const( Rt.luaPackagePath ),
                                                 W.call( self.rt.fnListNew(),
                                                         [ W.i32Const( 0 ) ] ) ] ), 0 ) ),
                         self.rt.$strType, Ast.builtinTypeString );
      }
   }
   switch prefixType.$kind {
      case .Map {
         return new Val( W.call( self.rt.fnMapGet(),
                                 [ self.lowerExp( prefix ),
                                   self.rt.strLiteral( fieldName ) ] ),
                         W.typeAnyRef, Ast.builtinTypeStem_ );
      }
      case .Class, .Alternate {
         return self.lowerMemberRef( node, prefix, fieldName );
      }
   }
   self.error( node, "not support field -- %s.%s" ( prefixType.getTxt( ## ), fieldName ) );
}

/** enum の値 */
fn convFilter.lowerEnumVal( enumType:&Ast.EnumTypeInfo, valInfo:&Ast.EnumValInfo ) mut : &Val {
   _match valInfo.$val {
      case .Int( val ) {
         return new Val( W.i64Const( val ), W.typeI64, enumType );
      }
      case .Real( val ) {
         return new Val( W.f64Const( val ), W.typeF64, enumType );
      }
      case .Str( val ) {
         return new Val( self.rt.strLiteral( val ), self.rt.$strType, enumType );
      }
   }
}

/** 標準入力のオブジェクト (グローバル変数) */
fn convFilter.getStdinGlobal() mut : int {
   if self.stdinGlobal < 0 {
      self.stdinGlobal = self.mod.addGlobal( self.rt.$objType, W.refNull( self.rt.$tObj ) );
      self.prologue.insert( W.globalSet( self.stdinGlobal, W.call( self.rt.fnIoStdin(), [] ) ) );
   }
   return self.stdinGlobal;
}

/** 標準出力・標準エラー出力のオブジェクト */
fn convFilter.getStdStream( isStdout:bool ) mut : int {
   if self.stdoutGlobal < 0 {
      self.stdoutGlobal = self.mod.addGlobal( self.rt.$objType, W.refNull( self.rt.$tObj ) );
      self.stderrGlobal = self.mod.addGlobal( self.rt.$objType, W.refNull( self.rt.$tObj ) );
      let vt = W.structNew( self.rt.$tVT, [ W.refNull( self.rt.$tAnyArr ) ] );
      self.prologue.insert(
         W.globalSet( self.stdoutGlobal, W.structNew( self.rt.$tObj, [ W.i32Const( 0 ), vt ] ) ) );
      self.prologue.insert(
         W.globalSet( self.stderrGlobal, W.structNew( self.rt.$tObj, [ W.i32Const( 0 ), vt ] ) ) );
   }
   if isStdout {
      return self.stdoutGlobal;
   }
   return self.stderrGlobal;
}

/** ExpRefItem (val[index]) */
fn convFilter.lowerRefItem( node:&Nodes.ExpRefItemNode ) mut : &Val {
   let valType = self.normType( node.$val.$expType );
   if self.isLuaval( node.$val.$expType ) {
      // Lua の値の要素 (Lua の obj[key])
      let keyIns;
      if! let index = node.$index {
         keyIns = self.lowerExpAs( index, Ast.builtinTypeStem_ );
      } else {
         keyIns = self.rt.strLiteral( unwrap node.$symbol );
      }
      return new Val( W.call( self.rt.fnLuaGetAt(),
                              [ self.lowerExpAs( node.$val, Ast.builtinTypeStem_ ), keyIns ] ),
                      W.typeAnyRef, Ast.builtinTypeStem_ );
   }
   let! index = node.$index {
      if! let symbol = node.$symbol {
         if valType.$kind == .Map {
            return new Val( W.call( self.rt.fnMapGet(),
                                    [ self.lowerExp( node.$val ), self.rt.strLiteral( symbol ) ] ),
                            W.typeAnyRef, Ast.builtinTypeStem_ );
         }
         if self.isType( valType, Ast.builtinTypeStem ) {
            return new Val( W.call( self.fnStemIndex(),
                                    [ self.lowerExp( node.$val ), self.rt.strLiteral( symbol ) ] ),
                            W.typeAnyRef, Ast.builtinTypeStem_ );
         }
      }
      self.notSupport( node );
   };
   switch valType.$kind {
      case .List, .Array {
         return new Val( W.call( self.rt.fnListGet(),
                                 [ self.lowerExp( node.$val ),
                                   self.lowerExpAs( index, Ast.builtinTypeInt ) ] ),
                         W.typeAnyRef, Ast.builtinTypeStem_ );
      }
      case .Map {
         return new Val( W.call( self.rt.fnMapGet(),
                                 [ self.lowerExp( node.$val ), self.toAny( self.lowerVal( index ) ) ] ),
                         W.typeAnyRef, Ast.builtinTypeStem_ );
      }
   }
   if self.isType( valType, Ast.builtinTypeStem ) {
      // stem の値は、実行時の型 (List / Map) で処理を分ける
      return new Val( W.call( self.fnStemIndex(),
                              [ self.lowerExp( node.$val ), self.toAny( self.lowerVal( index ) ) ] ),
                      W.typeAnyRef, Ast.builtinTypeStem_ );
   }
   if self.isType( valType, Ast.builtinTypeString ) {
      // 文字列の 1 バイト
      let strVal = self.tempLocal( self.rt.$strType );
      return self.newVal(
         W.seq( [ ls( strVal, self.lowerExp( node.$val ) ),
                  p( W.opI64ExtendI32U,
                     [ W.arrayGetU( self.rt.$tStr, lg( strVal ),
                                    p( W.opI32WrapI64,
                                       [ p( W.opI64Sub,
                                            [ self.lowerExpAs( index, Ast.builtinTypeInt ),
                                              W.i64Const( 1 ) ] ) ] ) ) ] ) ] ),
         Ast.builtinTypeInt );
   }
   self.error( node, "not support index -- %s" ( valType.getTxt( ## ) ) );
}

/** alge の値の生成 */
fn convFilter.lowerNewAlgeVal( node:&Nodes.NewAlgeValNode ) mut : &Val {
   let algeType = self.getGenSrc( node.$valInfo.$algeType );
   let! info = self.getAlgeInfo( algeType ) {
      self.error( node, "not found alge -- %s" ( algeType.getTxt( ## ) ) );
   };
   let name = node.$valInfo.$name;
   if! let globalIdx = info.$name2global[ name ] {
      return new Val( W.globalGet( globalIdx ), W.refType( info.$baseType ), algeType );
   }
   let valType = unwrap info.$name2type[ name ];
   let mut args:List<&W.Ins> = [ W.i32Const( 0 ), W.i32Const( unwrap info.$name2tag[ name ] ) ];
   foreach param, index in node.$paramList {
      args.insert( self.lowerExpAs( param, node.$valInfo.$typeList[ index ] ) );
   }
   return new Val( W.structNew( valType, args ), W.refType( info.$baseType ), algeType );
}

/** 無名関数 */
fn convFilter.lowerAnonymousFunc( node:&Nodes.DeclFuncNode ) mut : &Val {
   let funcType = node.$expType;
   let funcIndex = self.registerFunc( node.$declInfo, funcType );
   return self.newVal( self.compileFunc( node, node.$declInfo, funcType, funcIndex ), funcType );
}

/** 式を評価する */
/**
$. / $[ などの nil の場合に nil になるアクセスの場合、nil かどうかを判定する対象 (prefix) を返す。
*/
fn convFilter.getNilAccPrefix( node:&Nodes.Node ) : &Nodes.Node! {
   if self.nilAccDoneSet.has( node ) {
      return nil;
   }
   if! let refNode = node@@@Nodes.RefFieldNode {
      if refNode.$nilAccess {
         return refNode.$prefix;
      }
   } elseif! let getNode = node@@@Nodes.GetFieldNode {
      if getNode.$nilAccess {
         return getNode.$prefix;
      }
   } elseif! let itemNode = node@@@Nodes.ExpRefItemNode {
      if itemNode.$nilAccess {
         return itemNode.$val;
      }
   } elseif! let callNode = node@@@Nodes.ExpCallNode {
      if callNode.$nilAccess {
         // obj$.func() は、func の RefField の prefix を判定する
         if! let funcNode = callNode.$func@@@Nodes.RefFieldNode {
            if funcNode.$nilAccess {
               return funcNode.$prefix;
            }
         }
         // func$() は、関数の値を判定する
         return callNode.$func;
      }
   }
   return nil;
}

/**
$. などのアクセス。prefix が nil なら nil、そうでなければ通常のアクセスをする。
*/
fn convFilter.lowerNilAcc( node:&Nodes.Node, prefix:&Nodes.Node ) mut : &Val {
   let prefixVal = self.lowerVal( prefix );
   let work = self.tempLocal( prefixVal.$rep );
   let mut pre:List<&W.Ins> = [ ls( work, prefixVal.$ins ) ];
   self.node2val[ prefix ] = new Val( lg( work ), prefixVal.$rep, prefixVal.$typeInfo );
   self.nilAccDoneSet.add( node );
   if! let callNode = node@@@Nodes.ExpCallNode {
      self.nilAccDoneSet.add( callNode.$func );
   }
   let resultType = node.$expType;
   let resultRep = self.getRep( resultType );
   let accessIns = self.coerceVal( self.lowerVal( node ), resultType );
   self.node2val[ prefix ] = nil;
   pre.insert( W.ifElse( W.refIsNull( lg( work ) ),
                         [ self.getDefaultVal( resultRep ) ], [ accessIns ], resultRep ) );
   return self.newVal( W.seq( pre ), resultType );
}

/**
obj$.func() / func$() の呼び出し。prefix が nil なら、全ての戻り値を nil にする。

多値を返す場合もあるので、戻り値は局所変数に入れる。
*/
fn convFilter.lowerNilAccCall( node:&Nodes.ExpCallNode, prefix:&Nodes.Node )
   mut : &W.Ins, &List<&Ast.TypeInfo>
{
   let prefixVal = self.lowerVal( prefix );
   let work = self.tempLocal( prefixVal.$rep );
   let mut pre:List<&W.Ins> = [ ls( work, prefixVal.$ins ) ];
   self.node2val[ prefix ] = new Val( lg( work ), prefixVal.$rep, prefixVal.$typeInfo );
   self.nilAccDoneSet.add( node );
   self.nilAccDoneSet.add( node.$func );
   let callIns, callRetTypes = self.lowerCall( node );
   self.node2val[ prefix ] = nil;

   let mut retTypes:List<&Ast.TypeInfo> = [];
   let mut callLocals:List<int> = [];
   let mut retLocals:List<int> = [];
   foreach retType in callRetTypes {
      let nilableType = retType.$nilableTypeInfo;
      retTypes.insert( nilableType );
      callLocals.insert( self.tempLocal( self.getRep( retType ) ) );
      retLocals.insert( self.tempLocal( self.getRep( nilableType ) ) );
   }
   let mut thenBody:List<&W.Ins> = [ callIns ];
   let mut elseBody:List<&W.Ins> = [];
   for index = #callLocals, 1, -1 {
      thenBody.insert( ls( callLocals[ index ], W.nop() ) );
   }
   foreach retType, index in callRetTypes {
      thenBody.insert( ls( retLocals[ index ],
                           self.coerce( lg( callLocals[ index ] ), retType, retTypes[ index ] ) ) );
      if self.normType( retType ).$kind == .DDD {
         // ... の場合は、Lua 版と同じく nil を 1 つ返す
         elseBody.insert( ls( retLocals[ index ],
                              W.call( self.rt.fnListNew(), [ W.i32Const( 1 ) ] ) ) );
         elseBody.insert( W.call( self.rt.fnListPush(),
                                  [ lg( retLocals[ index ] ), W.refNull( W.htAny ) ] ) );
      } else {
         elseBody.insert( ls( retLocals[ index ],
                              self.getDefaultVal( self.getRep( retTypes[ index ] ) ) ) );
      }
   }
   pre.insert( W.ifElse( W.refIsNull( lg( work ) ), elseBody, thenBody, nil ) );
   foreach retLocal in retLocals {
      pre.insert( lg( retLocal ) );
   }
   return W.seq( pre ), retTypes;
}

fn convFilter.lowerVal( node:&Nodes.Node ) mut : &Val {
   if! let val = self.node2val[ node ] {
      return val;
   }
   if! let prefix = self.getNilAccPrefix( node ) {
      return self.lowerNilAcc( node, prefix );
   }
   let expType = node.$expType;
   switch node.$kind {
      case Nodes.NodeKind.$TupleConst {
         let tupleNode = unwrap node@@@Nodes.TupleConstNode;
         let mut pre:List<&W.Ins> = [];
         let vals = self.lowerValList( tupleNode.$expList, pre );
         pre.insert( self.buildList( vals ) );
         return self.newVal( W.seq( pre ), expType );
      }
      case Nodes.NodeKind.$LuneKind {
         // _kind(): Lua 版と同じく、式の (暗黙の cast の前の) 型の種類の値
         let kindNode = unwrap node@@@Nodes.LuneKindNode;
         let mut exp = kindNode.$exp;
         if! let castNode = exp@@@Nodes.ExpCastNode {
            if castNode.$castKind == .Implicit {
               exp = castNode.$exp;
            }
         }
         return self.newVal( W.i64Const( exp.$expType.$kind ), Ast.builtinTypeInt );
      }
      case Nodes.NodeKind.$Boxing {
         let boxNode = unwrap node@@@Nodes.BoxingNode;
         let mut pre:List<&W.Ins> = [];
         pre.insert( self.buildList( [ self.lowerVal( boxNode.$src ) ] ) );
         return self.newVal( W.seq( pre ), expType );
      }
      case Nodes.NodeKind.$Unboxing {
         let unboxNode = unwrap node@@@Nodes.UnboxingNode;
         return new Val( W.call( self.rt.fnListGet(),
                                 [ self.lowerExpAs( unboxNode.$src, unboxNode.$src.$expType ),
                                   W.i64Const( 1 ) ] ),
                         W.typeAnyRef, Ast.builtinTypeStem_ );
      }
      case Nodes.NodeKind.$ExpExpandTuple {
         // タプルの値のリストを ... として扱う
         let expandNode = unwrap node@@@Nodes.ExpExpandTupleNode;
         return new Val( self.lowerExpAs( expandNode.$exp, expandNode.$exp.$expType ),
                         self.rt.$listType, Ast.builtinTypeDDD );
      }
      case Nodes.NodeKind.$LiteralInt {
         let literal = unwrap node@@@Nodes.LiteralIntNode;
         return self.newVal( W.i64Const( literal.$num ), Ast.builtinTypeInt );
      }
      case Nodes.NodeKind.$LiteralChar {
         let literal = unwrap node@@@Nodes.LiteralCharNode;
         return self.newVal( W.i64Const( literal.$num ), Ast.builtinTypeInt );
      }
      case Nodes.NodeKind.$LiteralReal {
         let literal = unwrap node@@@Nodes.LiteralRealNode;
         return self.newVal( W.f64Const( literal.$num ), Ast.builtinTypeReal );
      }
      case Nodes.NodeKind.$LiteralBool {
         let literal = unwrap node@@@Nodes.LiteralBoolNode;
         if literal.$token.txt == "true" {
            return self.newVal( W.i32Const( 1 ), Ast.builtinTypeBool );
         }
         return self.newVal( W.i32Const( 0 ), Ast.builtinTypeBool );
      }
      case Nodes.NodeKind.$LiteralNil, Nodes.NodeKind.$Abbr {
         return new Val( W.refNull( W.htAny ), W.typeAnyRef, Ast.builtinTypeNil );
      }
      case Nodes.NodeKind.$LiteralString {
         return self.newVal( self.lowerLiteralString( unwrap node@@@Nodes.LiteralStringNode ),
                             Ast.builtinTypeString );
      }
      case Nodes.NodeKind.$LiteralList {
         return self.lowerLiteralColl(
            node, (unwrap node@@@Nodes.LiteralListNode).$expList, false );
      }
      case Nodes.NodeKind.$LiteralArray {
         return self.lowerLiteralColl(
            node, (unwrap node@@@Nodes.LiteralArrayNode).$expList, false );
      }
      case Nodes.NodeKind.$LiteralSet {
         return self.lowerLiteralColl(
            node, (unwrap node@@@Nodes.LiteralSetNode).$expList, true );
      }
      case Nodes.NodeKind.$LiteralMap {
         return self.lowerLiteralMap( unwrap node@@@Nodes.LiteralMapNode );
      }
      case Nodes.NodeKind.$ExpRef {
         let refNode = unwrap node@@@Nodes.ExpRefNode;
         let symbol = refNode.$symbolInfo.getOrg();
         return new Val( self.readSym( node, symbol ), self.getRep( symbol.$typeInfo ),
                         symbol.$typeInfo );
      }
      case Nodes.NodeKind.$ExpParen {
         return self.lowerVal( (unwrap node@@@Nodes.ExpParenNode).$exp );
      }
      case Nodes.NodeKind.$ExpOp2 {
         return self.lowerOp2( unwrap node@@@Nodes.ExpOp2Node );
      }
      case Nodes.NodeKind.$ExpOp1 {
         return self.lowerOp1( unwrap node@@@Nodes.ExpOp1Node );
      }
      case Nodes.NodeKind.$ExpCast {
         return self.lowerCast( unwrap node@@@Nodes.ExpCastNode );
      }
      case Nodes.NodeKind.$ExpUnwrap {
         return self.lowerUnwrap( unwrap node@@@Nodes.ExpUnwrapNode );
      }
      case Nodes.NodeKind.$ExpCall {
         let ins, retTypes = self.lowerCall( unwrap node@@@Nodes.ExpCallNode );
         if #retTypes == 0 {
            return new Val( ins, W.typeI32, Ast.builtinTypeNone );
         }
         if #retTypes == 1 {
            if self.normType( retTypes[ 1 ] ).$kind == .DDD {
               // ... の値を 1 つの値として使う場合は、先頭の要素
               return new Val( W.call( self.rt.fnListGet(), [ ins, W.i64Const( 1 ) ] ),
                               W.typeAnyRef, Ast.builtinTypeStem_ );
            }
            return self.newVal( ins, retTypes[ 1 ] );
         }
         // 多値の先頭の値
         let mut pre:List<&W.Ins> = [];
         let vals = self.lowerMulti( node, pre );
         pre.insert( vals[ 1 ].$ins );
         return new Val( W.seq( pre ), vals[ 1 ].$rep, vals[ 1 ].$typeInfo );
      }
      case Nodes.NodeKind.$ExpMultiTo1 {
         let mut pre:List<&W.Ins> = [];
         let vals = self.lowerMulti( (unwrap node@@@Nodes.ExpMultiTo1Node).$exp, pre );
         if self.normType( vals[ 1 ].$typeInfo ).$kind == .DDD {
            // ... の値を 1 つの値として使う場合は、先頭の要素
            pre.insert( W.call( self.rt.fnListGet(), [ vals[ 1 ].$ins, W.i64Const( 1 ) ] ) );
            return new Val( W.seq( pre ), W.typeAnyRef, Ast.builtinTypeStem_ );
         }
         pre.insert( vals[ 1 ].$ins );
         return new Val( W.seq( pre ), vals[ 1 ].$rep, vals[ 1 ].$typeInfo );
      }
      case Nodes.NodeKind.$ExpToDDD {
         let dddNode = unwrap node@@@Nodes.ExpToDDDNode;
         let mut pre:List<&W.Ins> = [];
         let vals = self.lowerValList( dddNode.$expList, pre );
         pre.insert( self.buildList( vals ) );
         return new Val( W.seq( pre ), self.rt.$listType, expType );
      }
      case Nodes.NodeKind.$ExpNew {
         return self.lowerNew( unwrap node@@@Nodes.ExpNewNode );
      }
      case Nodes.NodeKind.$RefField {
         return self.lowerRefField( unwrap node@@@Nodes.RefFieldNode );
      }
      case Nodes.NodeKind.$GetField {
         return self.lowerGetField( unwrap node@@@Nodes.GetFieldNode );
      }
      case Nodes.NodeKind.$ExpRefItem {
         return self.lowerRefItem( unwrap node@@@Nodes.ExpRefItemNode );
      }
      case Nodes.NodeKind.$ExpOmitEnum {
         let omitNode = unwrap node@@@Nodes.ExpOmitEnumNode;
         return self.lowerEnumVal( omitNode.$enumTypeInfo, omitNode.$valInfo );
      }
      case Nodes.NodeKind.$NewAlgeVal {
         return self.lowerNewAlgeVal( unwrap node@@@Nodes.NewAlgeValNode );
      }
      case Nodes.NodeKind.$DeclFunc {
         return self.lowerAnonymousFunc( unwrap node@@@Nodes.DeclFuncNode );
      }
      case Nodes.NodeKind.$ExpCallSuper {
         let ins, retTypes = self.lowerCallSuper( unwrap node@@@Nodes.ExpCallSuperNode );
         if #retTypes == 0 {
            return new Val( ins, W.typeI32, Ast.builtinTypeNone );
         }
         return self.newVal( ins, retTypes[ 1 ] );
      }
      case Nodes.NodeKind.$ExpMacroExp {
         let macroNode = unwrap node@@@Nodes.ExpMacroExpNode;
         if #macroNode.$stmtList == 1 {
            let stmt = macroNode.$stmtList[ 1 ];
            if! let stmtExp = stmt@@@Nodes.StmtExpNode {
               return self.lowerVal( stmtExp.$exp );
            }
            return self.lowerVal( stmt );
         }
      }
   }
   self.notSupport( node );
}

// ======== 関数呼び出し ========

/**
実引数を評価し、仮引数の型に変換する。

@param paramTypes 仮引数の型 (宣言時の型)
*/
fn convFilter.lowerArgs( argList:&Nodes.ExpListNode!, paramTypes:&List<&Ast.TypeInfo>,
                         mut pre:List<&W.Ins> ) mut : &List<&W.Ins>
{
   let mut vals:&List<&Val> = [];
   when! argList {
      vals = self.lowerValList( argList, pre );
   }
   let mut args:List<&W.Ins> = [];
   foreach paramType, index in paramTypes {
      if self.normType( paramType ).$kind == .DDD {
         // 残りの実引数を ... にする
         if #vals == index and self.normType( vals[ index ].$typeInfo ).$kind == .DDD {
            args.insert( vals[ index ].$ins );
         } else {
            let mut rest:List<&Val> = [];
            for work = index, #vals {
               rest.insert( vals[ work ] );
            }
            args.insert( self.buildList( rest ) );
         }
         break;
      }
      if index <= #vals {
         args.insert( self.coerceVal( vals[ index ], paramType ) );
      } else {
         args.insert( self.getDefaultVal( self.getRep( paramType ) ) );
      }
   }
   return args;
}

fn append( mut list:List<&W.Ins>, items:&List<&W.Ins> ) {
   foreach item in items {
      list.insert( item );
   }
}

/** クロージャを呼び出す */
fn convFilter.callClosure( cloVal:&W.Ins, funcType:&Ast.TypeInfo, argList:&Nodes.ExpListNode!,
                           mut pre:List<&W.Ins> ) mut : &W.Ins
{
   let info = self.getFuncCloInfo( funcType );
   let work = self.tempLocal( W.refType( info.$cloType ) );
   pre.insert( ls( work, W.refCast( info.$cloType, cloVal ) ) );
   let mut args:List<&W.Ins> = [ lg( work ) ];
   append( args, self.lowerArgs( argList, self.normType( funcType ).$argTypeInfoList, pre ) );
   args.insert( W.structGet( info.$cloType, Rt.fCloCode, lg( work ) ) );
   return W.callRef( info.$funcType, args );
}

/** print */
fn convFilter.lowerPrint( node:&Nodes.ExpCallNode ) mut : &W.Ins {
   let mut pre:List<&W.Ins> = [];
   let mut vals:&List<&Val> = [];
   if! let argList = node.$argList {
      if #argList.$expList == 1 {
         if! let dddNode = argList.$expList[ 1 ]@@@Nodes.ExpToDDDNode {
            vals = self.lowerValList( dddNode.$expList, pre );
         } else {
            vals = self.lowerValList( argList, pre );
         }
      } else {
         vals = self.lowerValList( argList, pre );
      }
   }
   pre.insert( W.call( self.rt.fnPrintList(), [ self.buildList( vals ) ] ) );
   return W.seq( pre );
}

/** ExpRef の関数の呼び出し */
fn convFilter.lowerCallRef( node:&Nodes.ExpCallNode, refNode:&Nodes.ExpRefNode,
                            mut pre:List<&W.Ins> ) mut : &W.Ins, &List<&Ast.TypeInfo>
{
   let symbol = self.resolveSym( refNode.$symbolInfo.getOrg() );
   let funcType = symbol.$typeInfo;
   let builtin = self.builtinFuncs;
   if funcType.equals( self.processInfo, builtin.lns_print ## ) {
      return self.lowerPrint( node ), [];
   }
   if funcType.equals( self.processInfo, builtin.lns_error ## ) {
      let args = self.lowerArgs( node.$argList, funcType.$argTypeInfoList, pre );
      pre.insert( self.rt.error( args[ 1 ] ) );
      return W.seq( pre ), [];
   }
   if funcType.equals( self.processInfo, builtin.lns_tostring ## ) {
      let mut vals:&List<&Val> = [];
      if! let argList = node.$argList {
         vals = self.lowerValList( argList, pre );
      }
      pre.insert( self.toStr( vals[ 1 ] ) );
      return W.seq( pre ), [ Ast.builtinTypeString ];
   }
   if funcType.equals( self.processInfo, builtin.lns___run ## ) {
      // Lua 版と同じく、Skip でなければその場で run() を呼び出す (wasm は 1 スレッド)
      let argList = unwrap node.$argList;
      let mode = self.tempLocal( W.typeI64 );
      pre.insert( ls( mode, self.lowerExpAs( argList.$expList[ 2 ], Ast.builtinTypeInt ) ) );
      let mut callPre:List<&W.Ins> = [];
      let callIns, retTypes = self.lowerObjMethodCall(
         node, argList.$expList[ 1 ], "run", callPre, nil );
      let mut body:List<&W.Ins> = [ callIns ];
      foreach _ in retTypes {
         body.insert( W.drop( W.nop() ) );
      }
      body.insert( W.i32Const( 1 ) );
      pre.insert( W.ifElse( p( W.opI64Eq, [ lg( mode ), W.i64Const( __lns.runMode.Skip ) ] ),
                            [ W.i32Const( 0 ) ], body, W.typeI32 ) );
      return W.seq( pre ), [ Ast.builtinTypeBool ];
   }
   if funcType.equals( self.processInfo, builtin.lns___join ## ) {
      // run() はその場で終わっているので、待つ必要は無い
      return W.seq( pre ), [];
   }
   if funcType.equals( self.processInfo, builtin.lns___serr ## ) {
      let info = self.getSerrInfo();
      pre.insert( W.structNew( info.$structType,
                               [ W.i32Const( 0 ), W.globalGet( info.$vtGlobal ),
                                 self.lowerArgAs( node, 1, Ast.builtinTypeString ) ] ) );
      return W.seq( pre ), funcType.$retTypeInfoList;
   }
   if funcType.equals( self.processInfo, builtin.lns_collectgarbage ## ) {
      // GC はホスト (wasm の実行環境) が行う
      return W.seq( pre ), [];
   }
   if funcType.equals( self.processInfo, builtin.lns_tonumber ## ) {
      return self.lowerLuaCall( node, Rt.luaTonumber, [] )**;
   }
   if funcType.equals( self.processInfo, builtin.lns_require ## ) {
      return self.lowerLuaCall( node, Rt.luaRequire, [] )**;
   }
   if funcType.equals( self.processInfo, builtin.lns__load ## ) {
      return self.lowerLuaCall( node, Rt.luaLoad, [] )**;
   }
   if funcType.equals( self.processInfo, builtin.lns_loadfile ## ) {
      pre.insert( W.call( self.rt.fnLuaLoadfile(), [ self.lowerArgAs( node, 1, Ast.builtinTypeString ) ] ) );
      return W.seq( pre ), [ Ast.builtinTypeDDD ];
   }
   if funcType.equals( self.processInfo, builtin.lns_expandLuavalMap ## ) {
      pre.insert( W.call( self.rt.fnLuaExpand(), [ self.lowerArgAs( node, 1, Ast.builtinTypeStem_ ) ] ) );
      return W.seq( pre ), funcType.$retTypeInfoList;
   }
   if funcType.equals( self.processInfo, builtin.lns_type ## ) {
      pre.insert( W.call( self.fnLuaType(), [ self.lowerArgAs( node, 1, Ast.builtinTypeStem_ ) ] ) );
      return W.seq( pre ), [ Ast.builtinTypeString ];
   }
   if symbol.$kind == .Fun {
      if! let funcIndex = self.func2index[ funcType ] {
         let cloArg;
         if self.findLoc( symbol ) {
            cloArg = self.readSym( refNode, symbol );
         } else {
            cloArg = W.refNull( self.rt.$tClo );
         }
         let mut args:List<&W.Ins> = [ cloArg ];
         append( args, self.lowerArgs( node.$argList, funcType.$argTypeInfoList, pre ) );
         pre.insert( W.call( funcIndex, args ) );
         return W.seq( pre ), funcType.$retTypeInfoList;
      }
   }
   let cloIns;
   if! let val = self.node2val[ refNode ] {
      // func$() で評価済みの関数の値
      cloIns = val.$ins;
   } else {
      cloIns = self.readSym( refNode, symbol );
   }
   pre.insert( self.callClosure( cloIns, funcType, node.$argList, pre ) );
   return W.seq( pre ), self.normType( funcType ).$retTypeInfoList;
}

/** 引数を 1 つ評価する (anyref) */
fn convFilter.lowerArgAny( node:&Nodes.ExpCallNode, index:int ) mut : &W.Ins {
   let argList = unwrap node.$argList;
   return self.toAny( self.lowerVal( argList.$expList[ index ] ) );
}
fn convFilter.lowerArgAs( node:&Nodes.ExpCallNode, index:int, typeInfo:&Ast.TypeInfo ) mut
   : &W.Ins
{
   let! argList = node.$argList {
      return self.getDefaultVal( self.getRep( typeInfo ) );
   };
   if index > #argList.$expList {
      return self.getDefaultVal( self.getRep( typeInfo ) );
   }
   return self.lowerExpAs( argList.$expList[ index ], typeInfo );
}

/** List / Array のメソッド */
fn convFilter.lowerListMethod( node:&Nodes.ExpCallNode, prefix:&Nodes.Node, name:str )
   mut : &W.Ins, &List<&Ast.TypeInfo>
{
   let list = self.lowerExp( prefix );
   switch name {
      case "insert" {
         return W.call( self.rt.fnListPush(), [ list, self.lowerArgAny( node, 1 ) ] ), [];
      }
      case "remove" {
         return W.call( self.rt.fnListRemove(),
                        [ list, W.call( self.fnIntOrZero(),
                                        [ self.lowerArgAs( node, 1, Ast.builtinTypeStem_ ) ] ) ] ),
                [ Ast.builtinTypeStem_ ];
      }
      case "sort" {
         let lessInfo = self.rt.getLessCloInfo();
         let mut cmp:&W.Ins = W.refNull( lessInfo.$cloType );
         if! let argList = node.$argList {
            if #argList.$expList > 0 {
               let arg = argList.$expList[ 1 ];
               if arg.$kind ~= Nodes.NodeKind.$Abbr {
                  let val = self.lowerVal( arg );
                  let lessType = self.rt.getCloInfo( [ W.typeAnyRef, W.typeAnyRef ], [ W.typeI32 ] );
                  if val.$rep.equalsType( W.refType( lessType.$cloType ) ) {
                     cmp = val.$ins;
                  } else {
                     // 比較関数の型を (stem, stem): bool に変換する
                     cmp = self.adaptClosure( val.$ins, val.$typeInfo, self.getLessFormType( node ) );
                  }
               }
            }
         }
         return W.call( self.rt.fnListSort(), [ list, cmp ] ), [];
      }
      case "unpack" {
         return W.call( self.rt.fnListClone(), [ list ] ), [ Ast.builtinTypeDDD ];
      }
   }
   self.error( node, "not support list method -- %s" (name) );
}

/** sort の比較関数の型 (generics の型パラメータを含む宣言時の型) */
fn convFilter.getLessFormType( node:&Nodes.ExpCallNode ) : &Ast.TypeInfo {
   let funcType = self.normType( node.$func.$expType );
   if! let fieldNode = node.$func@@@Nodes.RefFieldNode {
      if! let symbol = fieldNode.$symbolInfo {
         let declType = symbol.$typeInfo;
         if #declType.$argTypeInfoList > 0 {
            return declType.$argTypeInfoList[ 1 ];
         }
      }
   }
   return funcType.$argTypeInfoList[ 1 ];
}

/** int! (anyref) を i64 にする。nil は 0 */
fn convFilter.fnIntOrZero() mut : int {
   if! let index = self.adapterMap[ "intOrZero" ] {
      return index;
   }
   let index, mut func = self.mod.addFunc( [ W.typeAnyRef ], [ W.typeI64 ] );
   self.adapterMap[ "intOrZero" ] = index;
   self.mod.setFuncName( index, "intOrZero" );
   func.setBody( [
      W.ifElse( W.refIsNull( lg( 0 ) ), [ W.ret( [ W.i64Const( 0 ) ] ) ], nil, nil ),
      self.rt.unboxI64( lg( 0 ) ) ] );
   return index;
}

/** Set のメソッド */
fn convFilter.lowerSetMethod( node:&Nodes.ExpCallNode, prefix:&Nodes.Node, name:str )
   mut : &W.Ins, &List<&Ast.TypeInfo>
{
   let set = self.lowerExp( prefix );
   switch name {
      case "add" {
         let work = self.tempLocal( W.typeAnyRef );
         return W.seq( [ ls( work, self.lowerArgAny( node, 1 ) ),
                         W.call( self.rt.fnMapSet(), [ set, lg( work ), lg( work ) ] ) ] ), [];
      }
      case "del" {
         return W.call( self.rt.fnMapSet(), [ set, self.lowerArgAny( node, 1 ),
                                              W.refNull( W.htAny ) ] ), [];
      }
      case "has" {
         return p( W.opI32Eqz, [ W.refIsNull( W.call( self.rt.fnMapGet(),
                                                      [ set, self.lowerArgAny( node, 1 ) ] ) ) ] ),
                [ Ast.builtinTypeBool ];
      }
      case "and", "or", "sub" {
         let mut mode = 2;
         if name == "and" {
            mode = 0;
         } elseif name == "or" {
            mode = 1;
         }
         return W.call( self.rt.fnSetOp( mode ),
                        [ set, self.lowerArgAs( node, 1, prefix.$expType ) ] ),
                [ prefix.$expType ];
      }
      case "clone" {
         return W.call( self.rt.fnMapClone(), [ set ] ), [ prefix.$expType ];
      }
      case "len" {
         return p( W.opI64ExtendI32U, [ W.structGet( self.rt.$tMap, Rt.fMapCount, set ) ] ),
                [ Ast.builtinTypeInt ];
      }
   }
   self.error( node, "not support set method -- %s" (name) );
}

/** str のメソッド */
fn convFilter.lowerStrMethod( node:&Nodes.ExpCallNode, prefix:&Nodes.Node, name:str )
   mut : &W.Ins, &List<&Ast.TypeInfo>
{
   let strVal = self.lowerExpAs( prefix, Ast.builtinTypeString );
   switch name {
      case "sub" {
         let mut endIns = W.i64Const( -1 );
         if! let argList = node.$argList {
            if #argList.$expList >= 2 and argList.$expList[ 2 ].$kind ~= Nodes.NodeKind.$Abbr {
               endIns = W.call( self.fnIntOrMinus1(),
                                [ self.lowerArgAs( node, 2, Ast.builtinTypeStem_ ) ] );
            }
         }
         return W.call( self.rt.fnStrSub(),
                        [ strVal, self.lowerArgAs( node, 1, Ast.builtinTypeInt ), endIns ] ),
                [ Ast.builtinTypeString ];
      }
      case "find" {
         let mut initIns = W.i64Const( 1 );
         let mut plainIns = W.i32Const( 0 );
         if! let argList = node.$argList {
            if #argList.$expList >= 2 and argList.$expList[ 2 ].$kind ~= Nodes.NodeKind.$Abbr {
               initIns = W.call( self.fnIntOrDefault( 1 ),
                                 [ self.lowerArgAs( node, 2, Ast.builtinTypeStem_ ) ] );
            }
            if #argList.$expList >= 3 and argList.$expList[ 3 ].$kind ~= Nodes.NodeKind.$Abbr {
               plainIns = self.toCond( self.lowerVal( argList.$expList[ 3 ] ) );
            }
         }
         return W.call( self.rt.fnStrFind(),
                        [ strVal, self.lowerArgAs( node, 1, Ast.builtinTypeString ),
                          initIns, plainIns ] ),
                [ Ast.builtinTypeDDD ];
      }
      case "gsub" {
         return W.call( self.rt.fnStrGsub(),
                        [ strVal, self.lowerArgAs( node, 1, Ast.builtinTypeString ),
                          self.lowerArgAs( node, 2, Ast.builtinTypeString ) ] ),
                [ Ast.builtinTypeString, Ast.builtinTypeInt ];
      }
      case "format" {
         let mut pre:List<&W.Ins> = [];
         let work = self.tempLocal( self.rt.$strType );
         pre.insert( ls( work, strVal ) );
         let mut vals:&List<&Val> = [];
         if! let argList = node.$argList {
            if #argList.$expList == 1 {
               if! let dddNode = argList.$expList[ 1 ]@@@Nodes.ExpToDDDNode {
                  vals = self.lowerValList( dddNode.$expList, pre );
               } else {
                  vals = self.lowerValList( argList, pre );
               }
            }
         }
         pre.insert( W.call( self.rt.fnFormat(), [ lg( work ), self.buildList( vals ) ] ) );
         return W.seq( pre ), [ Ast.builtinTypeString ];
      }
   }
   let luaIdMap:&Map<str,int> = {
      "byte": Rt.luaByte, "rep": Rt.luaRep, "lower": Rt.luaLower, "upper": Rt.luaUpper,
      "reverse": Rt.luaReverse, "len": Rt.luaLen, "replace": Rt.luaReplace,
   };
   if! let luaId = luaIdMap[ name ] {
      return self.lowerLuaCall( node, luaId, [ strVal ] )**;
   }
   self.error( node, "not support str method -- %s" (name) );
}

/**
Lua の builtin の関数 (Rt.luaXXX) を呼び出す。

引数は、headArgs の後に node の引数を続ける。
戻り値の型が 1 つの場合はその型の値に変換し、それ以外は戻り値を ... (List) として返す。
*/
fn convFilter.lowerLuaCall( node:&Nodes.ExpCallNode, luaId:int, headArgs:&List<&W.Ins> )
   mut : &W.Ins, &List<&Ast.TypeInfo>
{
   return self.lowerLuaCallSub( node, luaId, nil, headArgs, [] )**;
}

/**
Lua の関数の呼び出し。

@param luaId builtin の関数の ID (funcVal が nil の場合)
@param funcVal 呼び出す Lua の値 (Luaval)
@param headArgs 先頭に追加する引数
@param headPre 事前に評価する命令
*/
fn convFilter.lowerLuaCallSub( node:&Nodes.ExpCallNode, luaId:int, funcVal:&W.Ins!,
                               headArgs:&List<&W.Ins>, headPre:&List<&W.Ins> )
   mut : &W.Ins, &List<&Ast.TypeInfo>
{
   let mut pre:List<&W.Ins> = [];
   append( pre, headPre );
   let args = self.tempLocal( self.rt.$listType );
   pre.insert( ls( args, W.call( self.rt.fnListNew(), [ W.i32Const( 4 ) ] ) ) );
   foreach ins in headArgs {
      pre.insert( W.call( self.rt.fnListPush(), [ lg( args ), ins ] ) );
   }
   if! let argList = node.$argList {
      foreach exp in argList.$expList {
         if! let dddNode = exp@@@Nodes.ExpToDDDNode {
            // 可変長引数 (...) の値は、展開して 1 つずつ渡す
            foreach val in self.lowerValList( dddNode.$expList, pre ) {
               pre.insert( W.call( self.rt.fnListPush(), [ lg( args ), self.toAny( val ) ] ) );
            }
            continue;
         }
         let argIns;
         if exp.$kind == Nodes.NodeKind.$Abbr {
            argIns = W.refNull( W.htAny );
         } else {
            argIns = self.lowerExpAs( exp, Ast.builtinTypeStem_ );
         }
         pre.insert( W.call( self.rt.fnListPush(), [ lg( args ), argIns ] ) );
      }
   }
   let result;
   when! funcVal {
      result = W.call( self.rt.fnLuaCallVal(), [ funcVal, lg( args ) ] );
   } else {
      if! let nativeFunc = self.rt.getNativeStrFunc( luaId ) {
         // Go 版と同じく、Lua を使わずに wasm の中で処理する
         result = W.call( nativeFunc, [ lg( args ) ] );
      } else {
         result = W.call( self.rt.fnLuaCall(), [ W.i32Const( luaId ), lg( args ) ] );
      }
   }
   let retTypeList;
   if funcVal {
      // Lua の値の関数の戻り値は Luaval<T> になる (宣言時の型ではなく、呼び出しの式の型を使う)
      retTypeList = node.$expTypeList;
   } else {
      retTypeList = node.$func.$expType.$retTypeInfoList;
   }
   if #retTypeList == 1 and retTypeList[ 1 ].$kind ~= .DDD {
      pre.insert( self.coerce( self.rt.listItem( result, 0 ),
                               Ast.builtinTypeStem_, retTypeList[ 1 ] ) );
      return W.seq( pre ), retTypeList;
   }
   pre.insert( result );
   return W.seq( pre ), [ Ast.builtinTypeDDD ];
}

/** Lua の type() と同じ型の名前 (anyref → str) */
fn convFilter.fnLuaType() mut : int {
   if! let index = self.adapterMap[ "luaType" ] {
      return index;
   }
   let index, mut func = self.mod.addFunc( [ W.typeAnyRef ], [ self.rt.$strType ] );
   self.adapterMap[ "luaType" ] = index;
   self.mod.setFuncName( index, "luaType" );
   let check = fn ( cond:&W.Ins, name:str ) : &W.Ins {
      return W.ifElse( cond, [ W.ret( [ self.rt.strLiteral( name ) ] ) ], nil, nil );
   };
   func.setBody( [
      check( W.refIsNull( lg( 0 ) ), "nil" ),
      check( W.refTest( self.rt.$tBoxI64, lg( 0 ) ), "number" ),
      check( W.refTest( self.rt.$tBoxF64, lg( 0 ) ), "number" ),
      check( W.refTest( self.rt.$tBoxBool, lg( 0 ) ), "boolean" ),
      check( W.refTest( self.rt.$tStr, lg( 0 ) ), "string" ),
      check( W.refTest( self.rt.$tClo, lg( 0 ) ), "function" ),
      W.ifElse( W.refTest( self.rt.$tLuaVal, lg( 0 ) ), [
         check( p( W.opI32Eq, [ self.rt.luaValType( lg( 0 ) ), W.i32Const( Rt.luaTFunction ) ] ),
                "function" ),
         check( p( W.opI32Eq, [ self.rt.luaValType( lg( 0 ) ), W.i32Const( 7 ) ] ), "userdata" ),
         check( p( W.opI32Eq, [ self.rt.luaValType( lg( 0 ) ), W.i32Const( 8 ) ] ), "thread" ) ],
                nil, nil ),
      self.rt.strLiteral( "table" ) ] );
   return index;
}

/** stem の値の要素 (Lua の table の参照と同じ)。引数: 値、キー (anyref) */
fn convFilter.fnStemIndex() mut : int {
   if! let index = self.adapterMap[ "stemIndex" ] {
      return index;
   }
   let index, mut func = self.mod.addFunc( [ W.typeAnyRef, W.typeAnyRef ], [ W.typeAnyRef ] );
   self.adapterMap[ "stemIndex" ] = index;
   self.mod.setFuncName( index, "stemIndex" );
   let pos = func.addLocal( W.typeI64 );
   func.setBody( [
      // Lua の値 (_G の値など)
      W.ifElse( W.refTest( self.rt.$tLuaVal, lg( 0 ) ), [
         W.ret( [ W.call( self.rt.fnLuaGetAtLazy(), [ lg( 0 ), lg( 1 ) ] ) ] ) ], nil, nil ),
      W.ifElse( W.refTest( self.rt.$tList, lg( 0 ) ), [
         W.ifElse( W.refTest( self.rt.$tBoxI64, lg( 1 ) ), [
            W.ret( [ W.call( self.rt.fnListGet(),
                             [ W.refCast( self.rt.$tList, lg( 0 ) ),
                               self.rt.unboxI64( lg( 1 ) ) ] ) ] ) ], nil, nil ),
         W.ret( [ W.refNull( W.htAny ) ] ) ], nil, nil ),
      W.ifElse( W.refTest( self.rt.$tMap, lg( 0 ) ), [
         W.ret( [ W.call( self.rt.fnMapGet(),
                          [ W.refCast( self.rt.$tMap, lg( 0 ) ), lg( 1 ) ] ) ] ) ], nil, nil ),
      // 文字列は、そのバイトの値 (範囲外は nil)
      W.ifElse( p( W.opI32And, [ W.refTest( self.rt.$tStr, lg( 0 ) ),
                                  W.refTest( self.rt.$tBoxI64, lg( 1 ) ) ] ), [
         ls( pos, p( W.opI64Sub, [ self.rt.unboxI64( lg( 1 ) ), W.i64Const( 1 ) ] ) ),
         W.ifElse( p( W.opI32Or,
                      [ p( W.opI64LtS, [ lg( pos ), W.i64Const( 0 ) ] ),
                        p( W.opI64GeS, [ lg( pos ),
                                         p( W.opI64ExtendI32U,
                                            [ W.arrayLen( W.refCast( self.rt.$tStr, lg( 0 ) ) ) ] ) ] ) ] ),
                   [ W.ret( [ W.refNull( W.htAny ) ] ) ], nil, nil ),
         W.ret( [ self.rt.boxI64(
            p( W.opI64ExtendI32U,
               [ W.arrayGetU( self.rt.$tStr, W.refCast( self.rt.$tStr, lg( 0 ) ),
                              p( W.opI32WrapI64, [ lg( pos ) ] ) ) ] ) ) ] ) ], nil, nil ),
      self.rt.error( self.rt.strLiteral( "attempt to index a non-table value" ) ) ] );
   return index;
}

/** int! (anyref) を i64 にする。nil は defVal */
fn convFilter.fnIntOrDefault( defVal:int ) mut : int {
   let name = "intOr:%d" (defVal);
   if! let index = self.adapterMap[ name ] {
      return index;
   }
   let index, mut func = self.mod.addFunc( [ W.typeAnyRef ], [ W.typeI64 ] );
   self.adapterMap[ name ] = index;
   self.mod.setFuncName( index, name );
   func.setBody( [
      W.ifElse( W.refIsNull( lg( 0 ) ), [ W.ret( [ W.i64Const( defVal ) ] ) ], nil, nil ),
      self.rt.unboxI64( lg( 0 ) ) ] );
   return index;
}

/** int! (anyref) を i64 にする。nil は -1 */
fn convFilter.fnIntOrMinus1() mut : int {
   if! let index = self.adapterMap[ "intOrMinus1" ] {
      return index;
   }
   let index, mut func = self.mod.addFunc( [ W.typeAnyRef ], [ W.typeI64 ] );
   self.adapterMap[ "intOrMinus1" ] = index;
   func.setBody( [
      W.ifElse( W.refIsNull( lg( 0 ) ), [ W.ret( [ W.i64Const( -1 ) ] ) ], nil, nil ),
      self.rt.unboxI64( lg( 0 ) ) ] );
   return index;
}

/** 標準出力などのストリームのメソッド */
fn convFilter.lowerStreamMethod( node:&Nodes.ExpCallNode, prefix:&Nodes.Node, name:str )
   mut : &W.Ins, &List<&Ast.TypeInfo>
{
   let obj = self.tempLocal( self.rt.$objType );
   // Luaval<T> (io.popen の結果など) の場合もあるので、anyref からキャストする
   let mut pre:List<&W.Ins> = [
      ls( obj, W.refCast( self.rt.$tObj, self.lowerExpAs( prefix, Ast.builtinTypeStem_ ) ) ) ];
   let isFile = self.rt.isFile( lg( obj ) );
   // LuneScript のクラスで実装したストリーム (Util.memStream など) は、インタフェースのメソッドを呼ぶ。
   // ファイルと標準出力・標準エラー出力のオブジェクトは、itable を持たない
   let mut ifType = self.getGenSrc( prefix.$expType );
   if self.isLuaval( prefix.$expType ) {
      ifType = self.getGenSrc( prefix.$expType.$nonnilableType.$extedType );
   }
   let isUser = p( W.opI32Eqz,
                   [ W.refIsNull( W.structGet( self.rt.$tVT, Rt.fVtItabs,
                                               W.structGet( self.rt.$tObj, Rt.fObjVt,
                                                            lg( obj ) ) ) ) ] );
   /**
   インタフェースのメソッドを呼び出し、戻り値を retLocals (表現 retReps) に入れる命令。
   */
   let userCall = fn ( args:&List<&W.Ins>, retLocals:&List<int>,
                       retReps:&List<&W.ValType> ) : &W.Ins
   {
      let ifInfo = self.getIfInfo( ifType );
      let! methodIndex = ifInfo.$name2index[ name ] {
         self.error( node, "not found method -- %s" (name) );
      };
      let methodType = unwrap self.getIfMethodType( ifType, name );
      let mut callArgs:List<&W.Ins> = [ lg( obj ) ];
      foreach arg in args {
         callArgs.insert( arg );
      }
      let itab = W.refCast(
         ifInfo.$itType,
         W.arrayGet( self.rt.$tAnyArr,
                     W.structGet( self.rt.$tVT, Rt.fVtItabs,
                                  W.structGet( self.rt.$tObj, Rt.fObjVt, lg( obj ) ) ),
                     W.i32Const( ifInfo.$ifId ) ) );
      callArgs.insert( W.structGet( ifInfo.$itType, methodIndex, itab ) );
      let mut body:List<&W.Ins> = [
         W.callRef( ifInfo.$methodFuncTypes[ methodIndex + 1 ], callArgs ) ];
      let calleeRets = self.getRepList( methodType.$retTypeInfoList );
      let mut works:List<int> = [];
      foreach rep in calleeRets {
         works.insert( self.tempLocal( rep ) );
      }
      for index = #works, 1, -1 {
         body.insert( ls( works[ index ], W.nop() ) );
      }
      foreach retLocal, index in retLocals {
         if index <= #works {
            body.insert( ls( retLocal, self.coerceRep( lg( works[ index ] ), calleeRets[ index ],
                                                       retReps[ index ] ) ) );
         } else {
            body.insert( ls( retLocal, self.getDefaultVal( retReps[ index ] ) ) );
         }
      }
      return W.seq( body );
   };
   switch name {
      case "write" {
         let txt = self.tempLocal( self.rt.$strType );
         pre.insert( ls( txt, self.lowerArgAs( node, 1, Ast.builtinTypeString ) ) );
         self.getStdStream( true );
         let ret1 = self.tempLocal( W.typeAnyRef );
         let ret2 = self.tempLocal( self.rt.$strType );
         pre.insert( ls( ret1, lg( obj ) ) );
         pre.insert( ls( ret2, W.refNull( self.rt.$tStr ) ) );
         pre.insert(
            W.ifElse( isFile, [ W.call( self.rt.fnFileWrite(), [ lg( obj ), lg( txt ) ] ) ],
                      [ W.ifElse( W.refEq( lg( obj ), W.globalGet( self.stderrGlobal ) ),
                                  [ W.call( self.rt.fnHostWriteErr(), [ lg( txt ) ] ) ],
                                  [ W.ifElse( isUser,
                                              [ userCall( [ lg( txt ) ], [ ret1, ret2 ],
                                                          [ W.typeAnyRef, self.rt.$strType ] ) ],
                                              [ W.call( self.rt.fnHostWrite(), [ lg( txt ) ] ) ],
                                              nil ) ], nil ) ],
                      nil ) );
         pre.insert( lg( ret1 ) );
         pre.insert( lg( ret2 ) );
         return W.seq( pre ), [ Ast.builtinTypeStem_, Ast.builtinTypeString.$nilableTypeInfo ];
      }
      case "read" {
         let fmt = self.tempLocal( W.typeAnyRef );
         pre.insert( ls( fmt, self.lowerArgAs( node, 1, Ast.builtinTypeStem_ ) ) );
         let ret = self.tempLocal( self.rt.$strType );
         pre.insert( ls( ret, W.refNull( self.rt.$tStr ) ) );
         pre.insert( W.ifElse( isFile, [ ls( ret, W.call( self.rt.fnFileRead(), [ lg( obj ), lg( fmt ) ] ) ) ],
                               [ W.ifElse( isUser,
                                           [ userCall( [ lg( fmt ) ], [ ret ], [ self.rt.$strType ] ) ],
                                           nil, nil ) ], nil ) );
         pre.insert( lg( ret ) );
         return W.seq( pre ), [ Ast.builtinTypeString.$nilableTypeInfo ];
      }
      case "seek" {
         pre.insert( W.call( self.rt.fnFileSeek(),
                             [ lg( obj ), self.lowerArgAs( node, 1, Ast.builtinTypeString ),
                               self.lowerArgAs( node, 2, Ast.builtinTypeInt ) ] ) );
         // Lua と同じく、成功なら値は 1 つ、失敗なら 2 つ (...)
         return W.seq( pre ), [ Ast.builtinTypeDDD ];
      }
      case "close", "flush" {
         let mut fileOp:List<&W.Ins> = [];
         if name == "close" {
            fileOp.insert( W.call( self.rt.fnFileClose(), [ lg( obj ) ] ) );
         }
         pre.insert( W.ifElse( isFile, fileOp,
                               [ W.ifElse( isUser, [ userCall( [], [], [] ) ], nil, nil ) ],
                               nil ) );
         return W.seq( pre ), [];
      }
   }
   self.error( node, "not support stream method -- %s" (name) );
}

/** builtin のストリームの型かどうか */
fn convFilter.isStreamType( typeInfo:&Ast.TypeInfo ) : bool {
   let work = self.getGenSrc( typeInfo );
   let builtin = self.builtinFuncs;
   return work == self.getGenSrc( builtin.ostream_ ) or
       work == self.getGenSrc( builtin.istream_ ) or
       work == self.getGenSrc( builtin.luastream_ );
}

/** インタフェースのメソッドの呼び出し (itable) */
fn convFilter.lowerIfMethodCall( prefix:&Nodes.Node, name:str, mut pre:List<&W.Ins>,
                                 argList:&Nodes.ExpListNode! )
   mut : &W.Ins, &List<&Ast.TypeInfo>
{
   let objType = self.getObjTypeForMethod( prefix.$expType, name );
   let ifInfo = self.getIfInfo( objType );
   let! methodIndex = ifInfo.$name2index[ name ] {
      self.error( prefix, "not found method -- %s" (name) );
   };
   let methodType = unwrap self.getIfMethodType( objType, name );
   let obj = self.tempLocal( self.rt.$objType );
   pre.insert( ls( obj, self.lowerExpAs( prefix, objType ) ) );
   let mut args:List<&W.Ins> = [ lg( obj ) ];
   append( args, self.lowerArgs( argList, methodType.$argTypeInfoList, pre ) );
   let itab = W.refCast(
      ifInfo.$itType,
      W.arrayGet( self.rt.$tAnyArr,
                  W.structGet( self.rt.$tVT, Rt.fVtItabs,
                               W.structGet( self.rt.$tObj, Rt.fObjVt, lg( obj ) ) ),
                  W.i32Const( ifInfo.$ifId ) ) );
   args.insert( W.structGet( ifInfo.$itType, methodIndex, itab ) );
   pre.insert( W.callRef( ifInfo.$methodFuncTypes[ methodIndex + 1 ], args ) );
   return W.seq( pre ), methodType.$retTypeInfoList;
}

/** オブジェクトのメソッドの呼び出し (vtable / itable) */
fn convFilter.lowerMethodCall( node:&Nodes.ExpCallNode, prefix:&Nodes.Node, name:str,
                               mut pre:List<&W.Ins> ) mut : &W.Ins, &List<&Ast.TypeInfo>
{
   let objType = self.getObjType( prefix.$expType );
   if objType.$kind ~= .IF and not self.getClassInfo( objType ) and
      Ast.isBuiltin( self.getGenSrc( objType ).$typeId.id )
   {
      // __lns.Sync.Flag などの builtin のクラスのメソッド。
      // Lua 版と同じく、これらの値は nil なので呼び出されない
      pre.insert( W.drop( self.toAny( self.lowerVal( prefix ) ) ) );
      let retTypes = node.$func.$expType.$retTypeInfoList;
      foreach retType in retTypes {
         pre.insert( self.getDefaultVal( self.getRep( retType ) ) );
      }
      return W.seq( pre ), retTypes;
   }
   return self.lowerObjMethodCall( node, prefix, name, pre, node.$argList )**;
}

/** prefix のオブジェクトのメソッド name を、引数 argList で呼び出す (vtable / itable) */
fn convFilter.lowerObjMethodCall( errNode:&Nodes.Node, prefix:&Nodes.Node, name:str,
                                  mut pre:List<&W.Ins>, argList:&Nodes.ExpListNode! )
   mut : &W.Ins, &List<&Ast.TypeInfo>
{
   let objType = self.getObjTypeForMethod( prefix.$expType, name );
   if objType.$kind == .IF {
      return self.lowerIfMethodCall( prefix, name, pre, argList )**;
   }
   let! info = self.getClassInfo( objType ) {
      self.error( errNode, "not found class -- %s" ( objType.getTxt( ## ) ) );
   };
   let! slotIndex = info.$name2slot[ name ] {
      self.error( errNode, "not found method -- %s" (name) );
   };
   let slot = info.$slotList[ slotIndex ];
   let obj = self.tempLocal( W.refType( info.$structType ) );
   pre.insert( ls( obj, self.lowerExpAs( prefix, info.$typeInfo ) ) );
   let mut args:List<&W.Ins> = [ lg( obj ) ];
   append( args, self.lowerArgs( argList, slot.$methodType.$argTypeInfoList, pre ) );
   args.insert( W.structGet( info.$vtType, slotIndex,
                             W.structGet( info.$structType, Rt.fObjVt, lg( obj ) ) ) );
   pre.insert( W.callRef( slot.$funcType, args ) );
   return W.seq( pre ), slot.$methodType.$retTypeInfoList;
}

/** インタフェースのメソッドの型 */
fn convFilter.getIfMethodType( ifType:&Ast.TypeInfo, name:str ) : &Ast.TypeInfo! {
   let mut map:Map<str,&Ast.TypeInfo> = {};
   self.collectIfMethods( self.getGenSrc( ifType ), map );
   return map[ name ];
}

/** RefField の関数 (メソッドなど) の呼び出し */
fn convFilter.lowerCallField( node:&Nodes.ExpCallNode, fieldNode:&Nodes.RefFieldNode,
                              mut pre:List<&W.Ins> ) mut : &W.Ins, &List<&Ast.TypeInfo>
{
   let prefix = fieldNode.$prefix;
   let name = fieldNode.$field.txt;
   let mut prefixType = self.normType( prefix.$expType );
   if self.isLuaval( prefix.$expType ) {
      // Lua の値ではない Luaval<T> (io.popen の結果のストリーム)
      prefixType = self.normType( prefix.$expType.$nonnilableType.$extedType );
   }
   let builtin = self.builtinFuncs;
   let funcType = node.$func.$expType;
   if! let initIns = self.getLazyInit( prefix ) {
      pre.insert( initIns );
   }
   if funcType.equals( self.processInfo, builtin.string_format ## ) {
      let mut vals:&List<&Val> = [];
      if! let argList = node.$argList {
         vals = self.lowerValList( argList, pre );
      }
      let mut rest:List<&Val> = [];
      for index = 2, #vals {
         rest.insert( vals[ index ] );
      }
      pre.insert( W.call( self.rt.fnFormat(),
                          [ self.coerceVal( vals[ 1 ], Ast.builtinTypeString ),
                            self.buildList( rest ) ] ) );
      return W.seq( pre ), [ Ast.builtinTypeString ];
   }
   switch prefixType.$kind {
      case .Box {
         if name == "val" {
            // Nilable<T>.val() は箱の中の値
            pre.insert( W.call( self.rt.fnListGet(),
                                [ self.lowerExpAs( prefix, prefix.$expType ), W.i64Const( 1 ) ] ) );
            return W.seq( pre ), [ Ast.builtinTypeStem_ ];
         }
      }
      case .List, .Array {
         return self.lowerListMethod( node, prefix, name )**;
      }
      case .Set {
         return self.lowerSetMethod( node, prefix, name )**;
      }
   }
   if self.isType( prefixType, Ast.builtinTypeString ) {
      return self.lowerStrMethod( node, prefix, name )**;
   }
   if self.isStreamType( prefixType ) {
      return self.lowerStreamMethod( node, prefix, name )**;
   }
   if! let symbol = fieldNode.$symbolInfo {
      let methodType = symbol.getOrg().$typeInfo;
      if symbol.$kind == .Mbr or symbol.$kind == .Var {
         // 関数を持つメンバ (obj.func()) は、メンバの値のクロージャを呼び出す
         let cloVal = self.lowerVal( fieldNode );
         pre.insert( self.callClosure( cloVal.$ins, methodType, node.$argList, pre ) );
         return W.seq( pre ), self.normType( methodType ).$retTypeInfoList;
      }
      if methodType.$staticFlag or symbol.$kind == .Fun {
         return self.lowerStaticCall( node, prefix, name, methodType, pre )**;
      }
   }
   if! let enumType = prefixType@@@Ast.EnumTypeInfo {
      // $_txt をメソッドとして呼び出した場合 (val.get__txt())
      if name == "get__txt" {
         pre.insert( W.call( self.fnEnumTxt( enumType ), [ self.lowerExp( prefix ) ] ) );
         return W.seq( pre ), [ Ast.builtinTypeString ];
      }
   }
   if prefixType.$kind == .Alge and name == "get__txt" {
      pre.insert( self.algeTxt( prefix, prefixType ) );
      return W.seq( pre ), [ Ast.builtinTypeString ];
   }
   if name == "_toMap" {
      // Lua 版はオブジェクトそのものを返すので、派生クラスのメンバも含める。
      // そのため、実行時の型の _toMap を呼ぶ
      if not self.toMapDynNode {
         self.toMapDynNode = node;
      }
      pre.insert( W.call( self.fnToMapDyn(),
                          [ self.lowerExpAs( prefix, Ast.builtinTypeStem_ ) ] ) );
      return W.seq( pre ), [ node.$expType ];
   }
   return self.lowerMethodCall( node, prefix, name, pre )**;
}

/** string・math モジュールの関数の型 → Lua の関数の ID */
fn convFilter.getStringModuleFuncMap() : &Map<&Ast.TypeInfo,int> {
   let builtin = self.builtinFuncs;
   return {
      builtin.string_find: Rt.luaFind, builtin.string_byte: Rt.luaByte,
      builtin.string_rep: Rt.luaRep, builtin.string_gsub: Rt.luaGsub,
      builtin.string_lower: Rt.luaLower, builtin.string_upper: Rt.luaUpper,
      builtin.string_reverse: Rt.luaReverse, builtin.string_sub: Rt.luaSub,
      builtin.math_random: Rt.luaRandom, builtin.math_randomseed: Rt.luaRandomseed,
      builtin.string_dump: Rt.luaDump,
   };
}

/**
string._join / string.__join (Lua の table.concat)。

引数: List、区切り (str!)、開始位置 (int!)、終了位置 (int!)。いずれも anyref
*/
fn convFilter.fnStrJoin() mut : int {
   if! let index = self.adapterMap[ "strJoin" ] {
      return index;
   }
   let index, mut func = self.mod.addFunc(
      [ W.typeAnyRef, W.typeAnyRef, W.typeAnyRef, W.typeAnyRef ], [ self.rt.$strType ] );
   self.adapterMap[ "strJoin" ] = index;
   self.mod.setFuncName( index, "strJoin" );
   let list = func.addLocal( self.rt.$listType );
   let sep = func.addLocal( self.rt.$strType );
   let pos = func.addLocal( W.typeI32 );
   let last = func.addLocal( W.typeI32 );
   let result = func.addLocal( self.rt.$strType );
   let first = func.addLocal( W.typeI32 );
   let total = func.addLocal( W.typeI32 );
   let work = func.addLocal( self.rt.$strType );
   let toI32 = fn ( val:&W.Ins ) : &W.Ins {
      return p( W.opI32WrapI64, [ self.rt.unboxI64( val ) ] );
   };
   // pos 番目 (1 始まり) の要素
   let item = fn () : &W.Ins {
      return W.refCast( self.rt.$tStr,
                        W.arrayGet( self.rt.$tAnyArr,
                                    W.structGet( self.rt.$tList, Rt.fListItems, lg( list ) ),
                                    p( W.opI32Sub, [ lg( pos ), W.i32Const( 1 ) ] ) ) );
   };
   // 文字列を result の total の位置にコピーし、total を進める
   let copyTo = fn ( val:&W.Ins ) : &W.Ins {
      let strIdx = self.rt.$tStr;
      return W.seq( [
         ls( work, val ),
         W.arrayCopy( strIdx, strIdx, lg( result ), lg( total ), lg( work ), W.i32Const( 0 ),
                      W.arrayLen( lg( work ) ) ),
         ls( total, p( W.opI32Add, [ lg( total ), W.arrayLen( lg( work ) ) ] ) ) ] );
   };
   func.setBody( [
      ls( list, W.refCast( self.rt.$tList, lg( 0 ) ) ),
      ls( sep, W.ifElse( W.refIsNull( lg( 1 ) ), [ self.rt.strLiteral( "" ) ],
                         [ W.refCast( self.rt.$tStr, lg( 1 ) ) ], self.rt.$strType ) ),
      ls( pos, W.ifElse( W.refIsNull( lg( 2 ) ), [ W.i32Const( 1 ) ], [ toI32( lg( 2 ) ) ],
                         W.typeI32 ) ),
      ls( last, W.ifElse( W.refIsNull( lg( 3 ) ),
                          [ W.structGet( self.rt.$tList, Rt.fListLen, lg( list ) ) ],
                          [ toI32( lg( 3 ) ) ], W.typeI32 ) ),
      // 先に結果の長さを求め、1 回だけ領域を確保してコピーする
      // (1 つずつ連結すると、要素数 × 全体の長さに比例する時間がかかる)
      ls( first, lg( pos ) ),
      W.block( [ W.loop( [
         W.brIf( 1, p( W.opI32GtS, [ lg( pos ), lg( last ) ] ) ),
         ls( total, p( W.opI32Add, [ lg( total ), W.arrayLen( item() ) ] ) ),
         W.ifElse( p( W.opI32LtS, [ lg( pos ), lg( last ) ] ),
                   [ ls( total, p( W.opI32Add, [ lg( total ), W.arrayLen( lg( sep ) ) ] ) ) ],
                   nil, nil ),
         ls( pos, p( W.opI32Add, [ lg( pos ), W.i32Const( 1 ) ] ) ),
         W.br( 0 ) ], nil ) ], nil ),
      ls( result, W.arrayNewDefault( self.rt.$tStr, lg( total ) ) ),
      ls( pos, lg( first ) ),
      ls( total, W.i32Const( 0 ) ),
      W.block( [ W.loop( [
         W.brIf( 1, p( W.opI32GtS, [ lg( pos ), lg( last ) ] ) ),
         copyTo( item() ),
         W.ifElse( p( W.opI32LtS, [ lg( pos ), lg( last ) ] ), [ copyTo( lg( sep ) ) ], nil, nil ),
         ls( pos, p( W.opI32Add, [ lg( pos ), W.i32Const( 1 ) ] ) ),
         W.br( 0 ) ], nil ) ], nil ),
      lg( result ) ] );
   return index;
}

/** static メソッド (クラスの関数) の呼び出し */
fn convFilter.lowerStaticCall( node:&Nodes.ExpCallNode, prefix:&Nodes.Node, name:str,
                               methodType:&Ast.TypeInfo, mut pre:List<&W.Ins> )
   mut : &W.Ins, &List<&Ast.TypeInfo>
{
   if not self.declaredMethodSet.has( methodType ) {
      // static メンバの自動生成のアクセッサは、メンバ (グローバル変数) を直接読み書きする
      if name.find( "^[gs]et_." ## ) {
         let memberName = name.sub( 5 ## );
         if! let scope = self.getGenSrc( prefix.$expType ).$scope {
            if! let symbol = scope.$symbol2SymbolInfoMap[ memberName ] {
               let orgSym = symbol.getOrg();
               if self.globalSym2loc[ orgSym ] {
                  if name.find( "^get_" ## ) {
                     pre.insert( self.readSym( node, orgSym ) );
                     return W.seq( pre ), [ orgSym.$typeInfo ];
                  }
                  pre.insert( self.writeSym(
                     node, orgSym, self.lowerArgAs( node, 1, orgSym.$typeInfo ) ) );
                  return W.seq( pre ), [];
               }
            }
         }
      }
   }
   if! let funcIndex = self.func2index[ methodType ] {
      let mut args:List<&W.Ins> = [ W.refNull( self.rt.$tClo ) ];
      append( args, self.lowerArgs( node.$argList, methodType.$argTypeInfoList, pre ) );
      pre.insert( W.call( funcIndex, args ) );
      return W.seq( pre ), methodType.$retTypeInfoList;
   }
   // string モジュールの関数 (Lua の関数を呼び出す)
   let builtin = self.builtinFuncs;
   foreach luaId, strFunc in self.getStringModuleFuncMap() {
      if methodType.equals( self.processInfo, strFunc ## ) {
         return self.lowerLuaCall( node, luaId, [] )**;
      }
   }
   // Lua 版と同じく、ログなどの処理は何もしない
   foreach noopFunc in [ builtin.__lns_runtime_log, builtin.__lns_runtime_enableLog,
                         builtin.__lns_runtime_enableDebugLog, builtin.__lns_runtime_dumpLog,
                         builtin.__processor_end ]
   {
      if methodType.equals( self.processInfo, noopFunc ## ) {
         if! let argList = node.$argList {
            foreach exp in argList.$expList {
               pre.insert( W.drop( self.lowerExpAs( exp, Ast.builtinTypeStem_ ) ) );
            }
         }
         return W.seq( pre ), [];
      }
   }
   if methodType.equals( self.processInfo, builtin.__lns_runtime_time ## ) {
      // Lua 版と同じく os.time() * 1000
      pre.insert( p( W.opI64Mul, [ W.call( self.rt.fnOsTime(), [] ), W.i64Const( 1000 ) ] ) );
      return W.seq( pre ), [ Ast.builtinTypeInt ];
   }
   if methodType.equals( self.processInfo, builtin.debug_getinfo ## ) {
      // wasm では Lua のスタックの情報は無い
      pre.insert( W.refNull( self.rt.$tMap ) );
      return W.seq( pre ), methodType.$retTypeInfoList;
   }
   if methodType.equals( self.processInfo, builtin.debug_getlocal ## ) {
      pre.insert( W.refNull( self.rt.$tStr ) );
      pre.insert( W.refNull( W.htAny ) );
      return W.seq( pre ), methodType.$retTypeInfoList;
   }
   if methodType.equals( self.processInfo, builtin.os_exit ## ) {
      let mut codeIns:&W.Ins = W.i64Const( 0 );
      if! let argList = node.$argList {
         if #argList.$expList >= 1 and argList.$expList[ 1 ].$kind ~= Nodes.NodeKind.$Abbr {
            codeIns = W.call( self.fnIntOrZero(),
                              [ self.lowerArgAs( node, 1, Ast.builtinTypeStem_ ) ] );
         }
      }
      pre.insert( W.call( self.rt.fnOsExit(), [ codeIns ] ) );
      pre.insert( W.unreachable() );
      return W.seq( pre ), [];
   }
   if methodType.equals( self.processInfo, builtin.os_remove ## ) {
      pre.insert( W.call( self.rt.fnOsFileOp( "remove" ),
                          [ self.lowerArgAs( node, 1, Ast.builtinTypeString ) ] ) );
      return W.seq( pre ), methodType.$retTypeInfoList;
   }
   if methodType.equals( self.processInfo, builtin.os_rename ## ) {
      pre.insert( W.call( self.rt.fnOsFileOp( "rename" ),
                          [ self.lowerArgAs( node, 1, Ast.builtinTypeString ),
                            self.lowerArgAs( node, 2, Ast.builtinTypeString ) ] ) );
      return W.seq( pre ), methodType.$retTypeInfoList;
   }
   if methodType.equals( self.processInfo, builtin.os_time ## ) {
      if! let argList = node.$argList {
         if #argList.$expList >= 1 and argList.$expList[ 1 ].$kind ~= Nodes.NodeKind.$Abbr {
            self.error( node, "not support os.time with the argument" );
         }
      }
      pre.insert( self.rt.boxI64( W.call( self.rt.fnOsTime(), [] ) ) );
      return W.seq( pre ), methodType.$retTypeInfoList;
   }
   if methodType.equals( self.processInfo, builtin.package_searchpath ## ) {
      return self.lowerLuaCall( node, Rt.luaSearchpath, [] )**;
   }
   if methodType.equals( self.processInfo, builtin.os_clock ## ) {
      pre.insert( W.call( self.rt.fnOsClock(), [] ) );
      return W.seq( pre ), [ Ast.builtinTypeReal ];
   }
   if methodType.equals( self.processInfo, builtin.io_popen ## ) {
      pre.insert( W.call( self.rt.fnIoPopen(),
                          [ self.lowerArgAs( node, 1, Ast.builtinTypeString ) ] ) );
      return W.seq( pre ), methodType.$retTypeInfoList;
   }
   if methodType.equals( self.processInfo, builtin.io_open ## ) {
      let mut modeIns:&W.Ins = W.refNull( self.rt.$tStr );
      if! let argList = node.$argList {
         if #argList.$expList >= 2 and argList.$expList[ 2 ].$kind ~= Nodes.NodeKind.$Abbr {
            modeIns = self.lowerArgAs( node, 2, Ast.builtinTypeString.$nilableTypeInfo );
         }
      }
      pre.insert( W.call( self.rt.fnIoOpen(),
                          [ self.lowerArgAs( node, 1, Ast.builtinTypeString ), modeIns ] ) );
      return W.seq( pre ), methodType.$retTypeInfoList;
   }
   if methodType.equals( self.processInfo, builtin.__lns_sync_createFlag ## ) or
      methodType.equals( self.processInfo, builtin.__lns_sync__createPipe ## )
   {
      // Lua 版と同じく nil にする (wasm は 1 スレッド)
      pre.insert( W.refNull( W.htAny ) );
      return W.seq( pre ), [ Ast.builtinTypeStem.$nilableTypeInfo ];
   }
   if methodType.equals( self.processInfo, builtin.string__join ## ) or
      methodType.equals( self.processInfo, builtin.string___join ## )
   {
      let mut args:List<&W.Ins> = [];
      args.insert( self.lowerArgAs( node, 1, Ast.builtinTypeStem_ ) );
      for index = 2, 4 {
         args.insert( self.lowerArgAs( node, index, Ast.builtinTypeStem_ ) );
      }
      pre.insert( W.call( self.fnStrJoin(), args ) );
      return W.seq( pre ), [ Ast.builtinTypeString ];
   }
   let classType = self.getGenSrc( prefix.$expType );
   if! let enumType = classType@@@Ast.EnumTypeInfo {
      if name == "_from" {
         // fnEnumFrom は anyref を返すので、nilable の enum の表現 (str の enum は str) にする
         pre.insert( self.coerceRep(
            W.call( self.fnEnumFrom( enumType ),
                    [ self.lowerArgAs( node, 1, enumType.$valTypeInfo ) ] ),
            W.typeAnyRef, self.getRep( enumType.$nilableTypeInfo ) ) );
         return W.seq( pre ), [ enumType.$nilableTypeInfo ];
      }
   }
   if name == "_fromMap" or name == "_fromStem" {
      if! let info = self.getClassInfo( classType ) {
         pre.insert( W.call( self.fnFromMap( node, info ),
                             [ self.lowerArgAs( node, 1, Ast.builtinTypeStem_ ) ] ) );
         return W.seq( pre ), [ info.$typeInfo.$nilableTypeInfo,
                                Ast.builtinTypeString.$nilableTypeInfo ];
      }
   }
   self.error( node, "not support static call -- %s" (name) );
}

/** 関数呼び出し。命令と、戻り値の型 (宣言時の型) を返す */
fn convFilter.lowerCall( node:&Nodes.ExpCallNode ) mut : &W.Ins, &List<&Ast.TypeInfo> {
   if! let prefix = self.getNilAccPrefix( node ) {
      return self.lowerNilAccCall( node, prefix )**;
   }
   let mut pre:List<&W.Ins> = [];
   let funcNode = node.$func;
   if! let fieldNode = funcNode@@@Nodes.RefFieldNode {
      if! let modType = self.getExtModuleType( fieldNode.$prefix.$expType ) {
         // Lua のモジュールの関数 (Lua 版と同じく、メソッドは Lua の mod:name( ... ))
         let modVal = self.tempLocal( W.typeAnyRef );
         let func = self.tempLocal( W.typeAnyRef );
         pre.insert( ls( modVal, self.lowerExtModuleVal( node, modType ) ) );
         pre.insert( ls( func, W.call( self.rt.fnLuaGetAt(),
                                       [ lg( modVal ), self.rt.strLiteral( fieldNode.$field.txt ) ] ) ) );
         let mut headArgs:List<&W.Ins> = [];
         if funcNode.$expType.$kind == .Method {
            headArgs.insert( lg( modVal ) );
         }
         return self.lowerLuaCallSub( node, 0, lg( func ), headArgs, pre )**;
      }
      if self.isLuaval( fieldNode.$prefix.$expType ) and
         not self.isStreamType( fieldNode.$prefix.$expType.$nonnilableType.$extedType )
      {
         // Lua の値のメソッドの呼び出し (Lua の obj:name( ... ))
         let obj = self.tempLocal( W.typeAnyRef );
         let func = self.tempLocal( W.typeAnyRef );
         pre.insert( ls( obj, self.lowerExpAs( fieldNode.$prefix, Ast.builtinTypeStem_ ) ) );
         pre.insert( ls( func, W.call( self.rt.fnLuaGetAt(),
                                       [ lg( obj ), self.rt.strLiteral( fieldNode.$field.txt ) ] ) ) );
         return self.lowerLuaCallSub( node, 0, lg( func ), [ lg( obj ) ], pre )**;
      }
   }
   if self.isLuaval( funcNode.$expType ) {
      // Lua の値 (関数) の呼び出し
      let func = self.tempLocal( W.typeAnyRef );
      pre.insert( ls( func, self.lowerExpAs( funcNode, Ast.builtinTypeStem_ ) ) );
      return self.lowerLuaCallSub( node, 0, lg( func ), [], pre )**;
   }
   if! let refNode = funcNode@@@Nodes.ExpRefNode {
      return self.lowerCallRef( node, refNode, pre )**;
   }
   if! let fieldNode = funcNode@@@Nodes.RefFieldNode {
      return self.lowerCallField( node, fieldNode, pre )**;
   }
   let funcVal = self.lowerVal( funcNode );
   pre.insert( self.callClosure( funcVal.$ins, funcVal.$typeInfo, node.$argList, pre ) );
   return W.seq( pre ), self.normType( funcVal.$typeInfo ).$retTypeInfoList;
}

/** super のメソッドの呼び出し */
fn convFilter.lowerCallSuper( node:&Nodes.ExpCallSuperNode ) mut : &W.Ins, &List<&Ast.TypeInfo> {
   let methodType = node.$methodType;
   let! funcIndex = self.func2index[ methodType ] {
      self.error( node, "not found super method" );
   };
   let mut pre:List<&W.Ins> = [];
   let mut args:List<&W.Ins> = [ lg( self.ctx.$selfLocal ) ];
   append( args, self.lowerArgs( node.$expList, methodType.$argTypeInfoList, pre ) );
   pre.insert( W.call( funcIndex, args ) );
   return W.seq( pre ), methodType.$retTypeInfoList;
}

/** new */
fn convFilter.lowerNew( node:&Nodes.ExpNewNode ) mut : &Val {
   let! info = self.getClassInfo( node.$expType ) {
      self.error( node, "not found class -- %s" ( node.$expType.getTxt( ## ) ) );
   };
   let objRep = W.refType( info.$structType );
   let obj = self.tempLocal( objRep );
   let mut fields:List<&W.Ins> = [ W.i32Const( 0 ), W.globalGet( info.$vtGlobal ) ];
   foreach rep in info.$fieldReps {
      fields.insert( self.getDefaultVal( rep ) );
   }
   let mut pre:List<&W.Ins> = [ ls( obj, W.structNew( info.$structType, fields ) ) ];
   let ctorType = self.getCtorType( info.$typeInfo );
   let mut args:List<&W.Ins> = [ lg( obj ) ];
   append( args, self.lowerArgs( node.$argList, ctorType.$argTypeInfoList, pre ) );
   pre.insert( W.call( info.$ctorFunc, args ) );
   pre.insert( lg( obj ) );
   return new Val( W.seq( pre ), objRep, node.$expType );
}

/** alge の値の名前 ($_txt) */
fn convFilter.algeTxt( prefix:&Nodes.Node, prefixType:&Ast.TypeInfo ) mut : &W.Ins {
   let algeType = self.getGenSrc( prefixType );
   let info = unwrap self.getAlgeInfo( algeType );
   return W.refCast( self.rt.$tStr,
                     W.arrayGet( self.rt.$tAnyArr, W.globalGet( info.$namesGlobal ),
                                 W.structGet( info.$baseType, 1,
                                              self.lowerExpAs( prefix, algeType ) ) ) );
}

/** コンストラクタの型 (宣言時の型) */
fn convFilter.getCtorType( classType:&Ast.TypeInfo ) : &Ast.TypeInfo {
   let scope = unwrap classType.$scope;
   return (unwrap scope.$symbol2SymbolInfoMap[ "__init" ]).$typeInfo;
}

/** GetField ($field) */
fn convFilter.lowerGetField( node:&Nodes.GetFieldNode ) mut : &Val {
   let prefix = node.$prefix;
   let getterType = node.$getterTypeInfo;
   // builtin の getter は $rawTxt が名前にならないので、フィールド名から求める
   let fieldName = node.$field.txt.gsub( "^%$", "" );
   let getterName = "get_" .. fieldName;
   let prefixType = self.normType( prefix.$expType );
   if! let enumType = prefixType@@@Ast.EnumTypeInfo {
      switch getterName {
         case "get__txt" {
            return self.newVal( W.call( self.fnEnumTxt( enumType ), [ self.lowerExp( prefix ) ] ),
                                Ast.builtinTypeString );
         }
         case "get__allList" {
            return self.newVal( W.call( self.fnEnumAllList( enumType ), [] ), node.$expType );
         }
      }
   }
   if prefixType.$kind == .Alge and getterName == "get__txt" {
      return self.newVal( self.algeTxt( prefix, prefixType ), Ast.builtinTypeString );
   }
   if self.getObjType( prefix.$expType ).$kind == .IF {
      // インタフェースの getter は itable から呼び出す
      let ins, retTypes = self.lowerIfMethodCall( prefix, getterName, [], nil );
      return self.newVal( ins, retTypes[ 1 ] );
   }
   if getterType.$staticFlag and ( getterType.$autoFlag or
                                   not self.declaredMethodSet.has( getterType ) )
   {
      // static メンバの自動生成の getter は、メンバ (グローバル変数) を直接参照する
      if! let scope = self.getGenSrc( prefix.$expType ).$scope {
         if! let symbol = scope.$symbol2SymbolInfoMap[ fieldName ] {
            let orgSym = symbol.getOrg();
            if self.globalSym2loc[ orgSym ] {
               return new Val( self.readSym( node, orgSym ), self.getRep( orgSym.$typeInfo ),
                               orgSym.$typeInfo );
            }
         }
      }
   }
   if ( getterType.$autoFlag or not self.declaredMethodSet.has( getterType ) ) and
      not self.advertiseMethodSet.has( getterType ) and
      not self.dynGetterNameSet.has( getterName )
   {
      // 自動生成の getter はメンバを直接参照する (advertise で委譲する getter は除く)
      return self.lowerMemberRef( node, prefix, fieldName );
   }
   if getterType.$staticFlag {
      // static の getter は関数として呼び出す
      if! let funcIndex = self.func2index[ getterType ] {
         return self.newVal( W.call( funcIndex, [ W.refNull( self.rt.$tClo ) ] ),
                             getterType.$retTypeInfoList[ 1 ] );
      }
   }
   // getter のメソッドを呼び出す
   let objType = self.getObjType( prefix.$expType );
   let! info = self.getClassInfo( objType ) {
      self.error( node, "not found class -- %s" ( objType.getTxt( ## ) ) );
   };
   let! slotIndex = info.$name2slot[ getterName ] {
      self.error( node, "not found getter -- %s" (getterName) );
   };
   let slot = info.$slotList[ slotIndex ];
   let obj = self.tempLocal( W.refType( info.$structType ) );
   let retType = slot.$methodType.$retTypeInfoList[ 1 ];
   return self.newVal(
      W.seq( [ ls( obj, self.lowerExpAs( prefix, info.$typeInfo ) ),
               W.callRef( slot.$funcType,
                          [ lg( obj ),
                            W.structGet( info.$vtType, slotIndex,
                                         W.structGet( info.$structType, Rt.fObjVt,
                                                      lg( obj ) ) ) ] ) ] ),
      retType );
}

// ======== enum ========

/** enum の値の一覧 (宣言順) */
fn convFilter.getEnumValList( enumType:&Ast.EnumTypeInfo ) : &List<&Ast.EnumValInfo> {
   let mut list:List<&Ast.EnumValInfo> = [];
   if! let declNode = self.enumType2decl[ enumType ] {
      foreach token in declNode.$valueNameList {
         if! let valInfo = enumType.$name2EnumValInfo[ token.txt ] {
            list.insert( valInfo );
         }
      }
   } else {
      forsort valInfo in enumType.$name2EnumValInfo {
         list.insert( valInfo );
      }
   }
   return list;
}

fn convFilter.getEnumFuncName( enumType:&Ast.EnumTypeInfo, kind:str ) : str {
   return "enum%s:%d" ( kind, enumType.$typeId.id );
}

/** enum の値の比較 */
fn convFilter.enumEq( enumType:&Ast.EnumTypeInfo, val:&W.Ins, valInfo:&Ast.EnumValInfo ) mut
   : &W.Ins
{
   let literal = self.lowerEnumVal( enumType, valInfo );
   return self.lowerEqVals( new Val( val, literal.$rep, enumType ), literal );
}

/** enum の値の名前 ($_txt) */
fn convFilter.fnEnumTxt( enumType:&Ast.EnumTypeInfo ) mut : int {
   let name = self.getEnumFuncName( enumType, "txt" );
   if! let index = self.adapterMap[ name ] {
      return index;
   }
   let rep = self.getRep( enumType );
   let index, mut func = self.mod.addFunc( [ rep ], [ self.rt.$strType ] );
   self.adapterMap[ name ] = index;
   self.mod.setFuncName( index, name );
   let mut body:List<&W.Ins> = [];
   foreach valInfo in self.getEnumValList( enumType ) {
      body.insert( W.ifElse( self.enumEq( enumType, lg( 0 ), valInfo ),
                             [ W.ret( [ self.rt.strLiteral(
                                "%s.%s" ( enumType.$rawTxt, valInfo.$name ) ) ] ) ],
                             nil, nil ) );
   }
   body.insert( self.rt.strLiteral( "" ) );
   func.setBody( body );
   return index;
}

/** enum の _from (値が enum の値なら返す。そうでなければ nil) */
fn convFilter.fnEnumFrom( enumType:&Ast.EnumTypeInfo ) mut : int {
   let name = self.getEnumFuncName( enumType, "from" );
   if! let index = self.adapterMap[ name ] {
      return index;
   }
   let rep = self.getRep( enumType );
   let index, mut func = self.mod.addFunc( [ rep ], [ W.typeAnyRef ] );
   self.adapterMap[ name ] = index;
   self.mod.setFuncName( index, name );
   let mut body:List<&W.Ins> = [];
   foreach valInfo in self.getEnumValList( enumType ) {
      body.insert( W.ifElse( self.enumEq( enumType, lg( 0 ), valInfo ),
                             [ W.ret( [ self.coerceRep( lg( 0 ), rep, W.typeAnyRef ) ] ) ],
                             nil, nil ) );
   }
   body.insert( W.refNull( W.htAny ) );
   func.setBody( body );
   return index;
}

/** enum の値のリスト ($_allList) */
fn convFilter.fnEnumAllList( enumType:&Ast.EnumTypeInfo ) mut : int {
   let name = self.getEnumFuncName( enumType, "all" );
   if! let index = self.adapterMap[ name ] {
      return index;
   }
   let index, mut func = self.mod.addFunc( [], [ self.rt.$listType ] );
   self.adapterMap[ name ] = index;
   self.mod.setFuncName( index, name );
   let mut vals:List<&Val> = [];
   foreach valInfo in self.getEnumValList( enumType ) {
      vals.insert( self.lowerEnumVal( enumType, valInfo ) );
   }
   let mut saved = self.ctx;
   self.ctx = new FuncCtx( func, [ self.rt.$listType ], [] );
   let ins = self.buildList( vals );
   self.ctx = saved;
   func.setBody( [ ins ] );
   return index;
}

// ======== Mapping ========

/**
_toMap で変換が必要な型かどうか。

Lua 版の _toMap はオブジェクトをそのまま返す (オブジェクトが table なので Map として扱える)。
wasm ではオブジェクトは struct なので、Mapping のクラスの値と、それを含む List / Map を変換する。
*/
fn convFilter.needToMapConv( typeInfo:&Ast.TypeInfo ) mut : bool {
   let work = self.normType( typeInfo );
   switch work.$kind {
      case .List, .Array, .Map {
         foreach item in work.$itemTypeInfoList {
            if self.needToMapConv( item ) {
               return true;
            }
         }
         return false;
      }
      case .Class {
         if self.isType( work, Ast.builtinTypeString ) {
            return false;
         }
         return self.getClassInfo( work ) ~= nil;
      }
      case .Alge {
         return true;
      }
   }
   return false;
}

/** Mapping の変換関数のキャッシュのキー (型の構造から作る) */
fn convFilter.mapConvKey( typeInfo:&Ast.TypeInfo ) : str {
   let work = self.normType( typeInfo );
   let mut key = "%d" ( self.getGenSrc( work ).$typeId.id );
   if #work.$itemTypeInfoList > 0 {
      key = key .. "<";
      foreach item, index in work.$itemTypeInfoList {
         if index > 1 {
            key = key .. ",";
         }
         key = key .. self.mapConvKey( item );
         if item.$nilable {
            key = key .. "!";
         }
      }
      key = key .. ">";
   }
   return key;
}

/** typeInfo の値 (anyref) を _toMap の形にする関数 (anyref → anyref) */
fn convFilter.fnToMapConv( node:&Nodes.Node, typeInfo:&Ast.TypeInfo ) mut : int {
   let name = "toMapConv:" .. self.mapConvKey( typeInfo );
   if! let index = self.adapterMap[ name ] {
      return index;
   }
   let index, mut func = self.mod.addFunc( [ W.typeAnyRef ], [ W.typeAnyRef ] );
   self.adapterMap[ name ] = index;
   self.mod.setFuncName( index, name );
   let work = self.normType( typeInfo );
   let mut body:List<&W.Ins> = [
      W.ifElse( W.refIsNull( lg( 0 ) ), [ W.ret( [ W.refNull( W.htAny ) ] ) ], nil, nil ) ];
   switch work.$kind {
      case .List, .Array {
         let elemType = work.$itemTypeInfoList[ 1 ];
         let src = func.addLocal( self.rt.$listType );
         let result = func.addLocal( self.rt.$listType );
         let pos = func.addLocal( W.typeI32 );
         body.insert( ls( src, W.refCast( self.rt.$tList, lg( 0 ) ) ) );
         body.insert( ls( result, W.call( self.rt.fnListNew(),
                                          [ W.structGet( self.rt.$tList, Rt.fListLen, lg( src ) ) ] ) ) );
         body.insert( W.block( [ W.loop( [
            W.brIf( 1, p( W.opI32GeS, [ lg( pos ),
                                        W.structGet( self.rt.$tList, Rt.fListLen, lg( src ) ) ] ) ),
            W.call( self.rt.fnListPush(),
                    [ lg( result ),
                      self.toMapVal( node, elemType,
                                     W.arrayGet( self.rt.$tAnyArr,
                                                 W.structGet( self.rt.$tList, Rt.fListItems, lg( src ) ),
                                                 lg( pos ) ) ) ] ),
            ls( pos, p( W.opI32Add, [ lg( pos ), W.i32Const( 1 ) ] ) ),
            W.br( 0 ) ], nil ) ], nil ) );
         body.insert( lg( result ) );
      }
      case .Map {
         let keyType = work.$itemTypeInfoList[ 1 ];
         let valType = work.$itemTypeInfoList[ 2 ];
         let src = func.addLocal( self.rt.$mapType );
         let result = func.addLocal( self.rt.$mapType );
         let pos = func.addLocal( W.typeI32 );
         body.insert( ls( src, W.refCast( self.rt.$tMap, lg( 0 ) ) ) );
         body.insert( ls( result, self.rt.newMap() ) );
         body.insert( W.block( [ W.loop( [
            ls( pos, W.call( self.rt.fnMapNext(), [ lg( src ), lg( pos ) ] ) ),
            W.brIf( 1, p( W.opI32LtS, [ lg( pos ), W.i32Const( 0 ) ] ) ),
            W.call( self.rt.fnMapSet(),
                    [ lg( result ),
                      self.toMapVal( node, keyType, self.rt.mapKeyAt( lg( src ), lg( pos ) ) ),
                      self.toMapVal( node, valType, self.rt.mapValAt( lg( src ), lg( pos ) ) ) ] ),
            ls( pos, p( W.opI32Add, [ lg( pos ), W.i32Const( 1 ) ] ) ),
            W.br( 0 ) ], nil ) ], nil ) );
         body.insert( lg( result ) );
      }
      case .Alge {
         // Lua 版の alge の値と同じく、{ 1: 値の名前, 2: [ パラメータ ] } にする
         let algeType = self.getGenSrc( work );
         let algeInfo = unwrap self.getAlgeInfo( algeType );
         let algeWork = unwrap algeType@@@Ast.AlgeTypeInfo;
         let src = func.addLocal( W.refType( algeInfo.$baseType ) );
         let result = func.addLocal( self.rt.$mapType );
         let params = func.addLocal( self.rt.$listType );
         let tag = func.addLocal( W.typeI32 );
         body.insert( ls( src, W.refCast( algeInfo.$baseType, lg( 0 ) ) ) );
         body.insert( ls( tag, W.structGet( algeInfo.$baseType, 1, lg( src ) ) ) );
         body.insert( ls( result, self.rt.newMap() ) );
         foreach valName in algeInfo.$valNames {
            let valInfo = unwrap algeWork.$valInfoMap[ valName ];
            let valType = unwrap algeInfo.$name2type[ valName ];
            let mut thenBody:List<&W.Ins> = [
               W.call( self.rt.fnMapSet(), [ lg( result ), self.rt.boxI64( W.i64Const( 1 ) ),
                                             self.rt.strLiteral( valName ) ] ) ];
            if #valInfo.$typeList > 0 {
               thenBody.insert( ls( params, W.call( self.rt.fnListNew(),
                                                    [ W.i32Const( #valInfo.$typeList ) ] ) ) );
               foreach paramType, paramIndex in valInfo.$typeList {
                  let paramVal = self.coerceRep(
                     W.structGet( valType, paramIndex + 1, W.refCast( valType, lg( src ) ) ),
                     self.getRep( paramType ), W.typeAnyRef );
                  thenBody.insert( W.call( self.rt.fnListPush(),
                                           [ lg( params ),
                                             self.toMapVal( node, paramType, paramVal ) ] ) );
               }
               thenBody.insert( W.call( self.rt.fnMapSet(),
                                        [ lg( result ), self.rt.boxI64( W.i64Const( 2 ) ),
                                          lg( params ) ] ) );
            }
            body.insert( W.ifElse(
               p( W.opI32Eq, [ lg( tag ), W.i32Const( unwrap algeInfo.$name2tag[ valName ] ) ] ),
               thenBody, nil, nil ) );
         }
         body.insert( lg( result ) );
      }
      default {
         let! info = self.getClassInfo( work ) {
            self.error( node, "not support _toMap -- %s" ( typeInfo.getTxt( ## ) ) );
         };
         body.insert( W.call( self.fnToMap( node, info ),
                              [ W.refCast( info.$structType, lg( 0 ) ) ] ) );
      }
   }
   func.setBody( body );
   return index;
}

/** typeInfo の値 val (anyref) を、必要なら _toMap の形にする */
fn convFilter.toMapVal( node:&Nodes.Node, typeInfo:&Ast.TypeInfo, val:&W.Ins ) mut : &W.Ins {
   if not self.needToMapConv( typeInfo ) {
      return val;
   }
   return W.call( self.fnToMapConv( node, typeInfo ), [ val ] );
}

/** _toMap */
fn convFilter.fnToMap( node:&Nodes.Node, info:&ClassInfo ) mut : int {
   let name = "toMap:%d" ( info.$structType );
   if! let index = self.adapterMap[ name ] {
      return index;
   }
   let index, mut func = self.mod.addFunc( [ W.refType( info.$structType ) ], [ self.rt.$mapType ] );
   self.adapterMap[ name ] = index;
   self.mod.setFuncName( index, name );
   let map = func.addLocal( self.rt.$mapType );
   let mut body:List<&W.Ins> = [ ls( map, self.rt.newMap() ) ];
   foreach fieldName, fieldIndex in info.$fieldNames {
      let rep = info.$fieldReps[ fieldIndex ];
      let val = self.coerceRep( W.structGet( info.$structType, fieldIndex + 1, lg( 0 ) ),
                                rep, W.typeAnyRef );
      body.insert( W.call( self.rt.fnMapSet(),
                           [ lg( map ), self.rt.strLiteral( fieldName ),
                             self.toMapVal( node, info.$fieldTypes[ fieldIndex ], val ) ] ) );
   }
   body.insert( lg( map ) );
   func.setBody( body );
   return index;
}

/**
_fromMap で、typeInfo の値に変換する関数。

引数: 値 (anyref)。戻り値: 変換した値 (anyref。変換できない場合は null)、エラーの位置 (str。無ければ null)。
Lua 版の _lune._toInt・_toList・_toMap などと同じ動作にする。
*/
fn convFilter.fnFromConv( node:&Nodes.Node, typeInfo:&Ast.TypeInfo ) mut : int {
   let name = "fromConv:" .. self.mapConvKey( typeInfo );
   if! let index = self.adapterMap[ name ] {
      return index;
   }
   let strNull = W.refNull( self.rt.$tStr );
   let anyNull = W.refNull( W.htAny );
   let index, mut func = self.mod.addFunc( [ W.typeAnyRef ], [ W.typeAnyRef, self.rt.$strType ] );
   self.adapterMap[ name ] = index;
   self.mod.setFuncName( index, name );
   let work = self.normType( typeInfo );
   let fail = W.ret( [ anyNull, strNull ] );
   let ok = fn ( val:&W.Ins ) : &W.Ins {
      return W.ret( [ val, strNull ] );
   };
   let ifThen = fn ( cond:&W.Ins, body:&List<&W.Ins> ) : &W.Ins {
      return W.ifElse( cond, body, nil, nil );
   };
   let mut body:List<&W.Ins> = [];
   // 変換に失敗した要素の位置 pos のエラー (Lua の "%d.%s" と同じ)
   let posMess = fn ( posTxt:&W.Ins, mess:&W.Ins, messLocal:int ) : &W.Ins {
      return W.ifElse( W.refIsNull( mess ), [ posTxt ],
                       [ W.call( self.rt.fnStrConcat(),
                                 [ posTxt,
                                   W.call( self.rt.fnStrConcat(),
                                           [ self.rt.strLiteral( "." ), lg( messLocal ) ] ) ] ) ],
                       self.rt.$strType );
   };
   if! let enumType = work@@@Ast.EnumTypeInfo {
      // Lua 版と同じく、値の型に変換してから _from で enum にする
      let valType = enumType.$valTypeInfo;
      let val = func.addLocal( W.typeAnyRef );
      body.insert( W.call( self.fnFromConv( node, valType ), [ lg( 0 ) ] ) );
      body.insert( W.drop( W.nop() ) );
      body.insert( ls( val, W.nop() ) );
      body.insert( ifThen( W.refIsNull( lg( val ) ), [ fail ] ) );
      body.insert( ok( self.coerceRep(
         W.call( self.fnEnumFrom( enumType ),
                 [ self.coerceRep( lg( val ), W.typeAnyRef, self.getRep( valType ) ) ] ),
         self.getRep( enumType.$nilableTypeInfo ), W.typeAnyRef ) ) );
   } elseif self.isType( work, Ast.builtinTypeInt ) {
      body.insert( ifThen( W.refTest( self.rt.$tBoxI64, lg( 0 ) ), [ ok( lg( 0 ) ) ] ) );
      body.insert( ifThen( W.refTest( self.rt.$tBoxF64, lg( 0 ) ), [
         ok( self.rt.boxI64( p( W.opI64TruncF64S, [ p( W.opF64Floor, [ self.rt.unboxF64( lg( 0 ) ) ] ) ] ) ) ) ] ) );
      body.insert( fail );
   } elseif self.isType( work, Ast.builtinTypeReal ) {
      body.insert( ifThen( W.refTest( self.rt.$tBoxF64, lg( 0 ) ), [ ok( lg( 0 ) ) ] ) );
      body.insert( ifThen( W.refTest( self.rt.$tBoxI64, lg( 0 ) ), [
         ok( self.rt.boxF64( p( W.opF64ConvertI64S, [ self.rt.unboxI64( lg( 0 ) ) ] ) ) ) ] ) );
      body.insert( fail );
   } elseif self.isType( work, Ast.builtinTypeBool ) {
      body.insert( ifThen( W.refTest( self.rt.$tBoxBool, lg( 0 ) ), [ ok( lg( 0 ) ) ] ) );
      body.insert( fail );
   } elseif self.isType( work, Ast.builtinTypeString ) {
      body.insert( ifThen( W.refTest( self.rt.$tStr, lg( 0 ) ), [ ok( lg( 0 ) ) ] ) );
      body.insert( fail );
   } elseif self.isType( work, Ast.builtinTypeStem ) or work.$kind == .Alternate {
      // generics の型パラメータは、型を消去しているので変換しない (Lua 版は実際の型で検査する)
      body.insert( ok( lg( 0 ) ) );
   } else {
      switch work.$kind {
         case .List, .Array {
            let elemType = work.$itemTypeInfoList[ 1 ];
            let src = func.addLocal( self.rt.$listType );
            let result = func.addLocal( self.rt.$listType );
            let pos = func.addLocal( W.typeI32 );
            let val = func.addLocal( W.typeAnyRef );
            let mess = func.addLocal( self.rt.$strType );
            // Lua の table と同じく、1 からの整数のキーの Map も List として扱う
            // (expandLuavalMap の結果など)
            body.insert( ifThen( W.refTest( self.rt.$tMap, lg( 0 ) ),
                                 [ ls( 0, W.call( self.fnMapToList(),
                                                  [ W.refCast( self.rt.$tMap, lg( 0 ) ) ] ) ) ] ) );
            body.insert( ifThen( p( W.opI32Eqz, [ W.refTest( self.rt.$tList, lg( 0 ) ) ] ),
                                 [ fail ] ) );
            body.insert( ls( src, W.refCast( self.rt.$tList, lg( 0 ) ) ) );
            body.insert( ls( result, W.call( self.rt.fnListNew(),
                                             [ W.structGet( self.rt.$tList, Rt.fListLen, lg( src ) ) ] ) ) );
            let mut loopBody:List<&W.Ins> = [
               W.brIf( 1, p( W.opI32GeS, [ lg( pos ),
                                           W.structGet( self.rt.$tList, Rt.fListLen, lg( src ) ) ] ) ),
               W.call( self.fnFromConv( node, elemType ),
                       [ W.arrayGet( self.rt.$tAnyArr,
                                     W.structGet( self.rt.$tList, Rt.fListItems, lg( src ) ),
                                     lg( pos ) ) ] ),
               ls( mess, W.nop() ),
               ls( val, W.nop() ),
               ls( pos, p( W.opI32Add, [ lg( pos ), W.i32Const( 1 ) ] ) ) ];
            if not elemType.$nilable {
               loopBody.insert( ifThen( W.refIsNull( lg( val ) ), [
                  W.ret( [ anyNull,
                           posMess( W.call( self.rt.fnI64ToStr(),
                                            [ p( W.opI64ExtendI32S, [ lg( pos ) ] ) ] ),
                                    lg( mess ), mess ) ] ) ] ) );
            }
            loopBody.insert( W.call( self.rt.fnListPush(), [ lg( result ), lg( val ) ] ) );
            loopBody.insert( W.br( 0 ) );
            body.insert( W.block( [ W.loop( loopBody, nil ) ], nil ) );
            body.insert( ok( lg( result ) ) );
         }
         case .Map, .Set {
            let isSet = work.$kind == .Set;
            let keyType = work.$itemTypeInfoList[ 1 ];
            let src = func.addLocal( self.rt.$mapType );
            let result = func.addLocal( self.rt.$mapType );
            let pos = func.addLocal( W.typeI32 );
            let key = func.addLocal( W.typeAnyRef );
            let val = func.addLocal( W.typeAnyRef );
            let mess = func.addLocal( self.rt.$strType );
            body.insert( ifThen( p( W.opI32Eqz, [ W.refTest( self.rt.$tMap, lg( 0 ) ) ] ),
                                 [ fail ] ) );
            body.insert( ls( src, W.refCast( self.rt.$tMap, lg( 0 ) ) ) );
            body.insert( ls( result, self.rt.newMap() ) );
            let mut loopBody:List<&W.Ins> = [
               ls( pos, W.call( self.rt.fnMapNext(), [ lg( src ), lg( pos ) ] ) ),
               W.brIf( 1, p( W.opI32LtS, [ lg( pos ), W.i32Const( 0 ) ] ) ),
               W.call( self.fnFromConv( node, keyType ),
                       [ self.rt.mapKeyAt( lg( src ), lg( pos ) ) ] ),
               W.drop( W.nop() ),
               ls( key, W.nop() ),
               // キーを変換できない場合は、エラーの位置無しで失敗する (Lua と同じ)
               ifThen( W.refIsNull( lg( key ) ), [ fail ] ) ];
            if isSet {
               loopBody.insert( ls( val, lg( key ) ) );
            } else {
               loopBody.insert( W.call( self.fnFromConv( node, work.$itemTypeInfoList[ 2 ] ),
                                        [ self.rt.mapValAt( lg( src ), lg( pos ) ) ] ) );
               loopBody.insert( ls( mess, W.nop() ) );
               loopBody.insert( ls( val, W.nop() ) );
               // Lua 版は、値を変換できない場合にキーを位置とする
               loopBody.insert( ifThen( W.refIsNull( lg( val ) ), [
                  W.ret( [ anyNull, W.call( self.rt.fnToStr(), [ lg( key ) ] ) ] ) ] ) );
            }
            loopBody.insert( W.call( self.rt.fnMapSet(), [ lg( result ), lg( key ), lg( val ) ] ) );
            loopBody.insert( ls( pos, p( W.opI32Add, [ lg( pos ), W.i32Const( 1 ) ] ) ) );
            loopBody.insert( W.br( 0 ) );
            body.insert( W.block( [ W.loop( loopBody, nil ) ], nil ) );
            body.insert( ok( lg( result ) ) );
         }
         case .Alge {
            // Lua 版の _lune._AlgeFrom と同じく、[1] の名前の値を、[2] のパラメータで生成する
            let algeType = self.getGenSrc( work );
            let algeInfo = unwrap self.getAlgeInfo( algeType );
            let algeWork = unwrap algeType@@@Ast.AlgeTypeInfo;
            let algeName = func.addLocal( self.rt.$strType );
            let params = func.addLocal( W.typeAnyRef );
            let val = func.addLocal( W.typeAnyRef );
            let item = fn ( obj:&W.Ins, itemIndex:int ) : &W.Ins {
               return W.call( self.fnStemIndex(), [ obj, self.rt.boxI64( W.i64Const( itemIndex ) ) ] );
            };
            body.insert( ifThen( p( W.opI32Eqz,
                                    [ p( W.opI32Or, [ W.refTest( self.rt.$tList, lg( 0 ) ),
                                                      W.refTest( self.rt.$tMap, lg( 0 ) ) ] ) ] ),
                                 [ fail ] ) );
            body.insert( ls( val, item( lg( 0 ), 1 ) ) );
            body.insert( ifThen( p( W.opI32Eqz, [ W.refTest( self.rt.$tStr, lg( val ) ) ] ),
                                 [ fail ] ) );
            body.insert( ls( algeName, W.refCast( self.rt.$tStr, lg( val ) ) ) );
            body.insert( ls( params, item( lg( 0 ), 2 ) ) );
            foreach valName in algeInfo.$valNames {
               let valInfo = unwrap algeWork.$valInfoMap[ valName ];
               let valType = unwrap algeInfo.$name2type[ valName ];
               let mut thenBody:List<&W.Ins> = [];
               if #valInfo.$typeList == 0 {
                  thenBody.insert(
                     ok( W.globalGet( unwrap algeInfo.$name2global[ valName ] ) ) );
               } else {
                  thenBody.insert( ifThen( W.refIsNull( lg( params ) ), [ fail ] ) );
                  let mut fields:List<&W.Ins> = [ W.i32Const( 0 ),
                                                  W.i32Const( unwrap algeInfo.$name2tag[ valName ] ) ];
                  foreach paramType, paramIndex in valInfo.$typeList {
                     let paramLocal = func.addLocal( self.getRep( paramType ) );
                     thenBody.insert( W.call( self.fnFromConv( node, paramType ),
                                              [ item( lg( params ), paramIndex ) ] ) );
                     thenBody.insert( W.drop( W.nop() ) );
                     thenBody.insert( ls( val, W.nop() ) );
                     if not paramType.$nilable {
                        thenBody.insert( ifThen( W.refIsNull( lg( val ) ), [ fail ] ) );
                     }
                     thenBody.insert( ls( paramLocal, self.coerceRep(
                        lg( val ), W.typeAnyRef, self.getRep( paramType ) ) ) );
                     fields.insert( lg( paramLocal ) );
                  }
                  thenBody.insert( ok( W.structNew( valType, fields ) ) );
               }
               body.insert( ifThen( W.call( self.rt.fnStrEq(),
                                            [ lg( algeName ), self.rt.strLiteral( valName ) ] ),
                                    thenBody ) );
            }
            body.insert( fail );
         }
         default {
            let! info = self.getClassInfo( work ) {
               self.error( node, "not support _fromMap -- %s" ( typeInfo.getTxt( ## ) ) );
            };
            body.insert( W.call( self.fnFromMap( node, info ), [ lg( 0 ) ] ) );
         }
      }
   }
   func.setBody( body );
   return index;
}

/** _fromMap。引数: 値 (anyref)。戻り値: オブジェクト (変換できない場合は null)、エラーの位置 */
fn convFilter.fnFromMap( node:&Nodes.Node, info:&ClassInfo ) mut : int {
   let name = "fromMap:%d" ( info.$structType );
   if! let index = self.adapterMap[ name ] {
      return index;
   }
   let objRep = W.refType( info.$structType );
   let index, mut func = self.mod.addFunc( [ W.typeAnyRef ], [ objRep, self.rt.$strType ] );
   self.adapterMap[ name ] = index;
   self.mod.setFuncName( index, name );
   let map = func.addLocal( self.rt.$mapType );
   let val = func.addLocal( W.typeAnyRef );
   let mess = func.addLocal( self.rt.$strType );
   let mut body:List<&W.Ins> = [
      W.ifElse( p( W.opI32Eqz, [ W.refTest( self.rt.$tMap, lg( 0 ) ) ] ),
                [ W.ret( [ W.refNull( info.$structType ), W.refNull( self.rt.$tStr ) ] ) ],
                nil, nil ),
      ls( map, W.refCast( self.rt.$tMap, lg( 0 ) ) ) ];
   let mut fields:List<&W.Ins> = [ W.i32Const( 0 ), W.globalGet( info.$vtGlobal ) ];
   foreach fieldName, fieldIndex in info.$fieldNames {
      let rep = info.$fieldReps[ fieldIndex ];
      let fieldType = info.$fieldTypes[ fieldIndex ];
      let fieldLocal = func.addLocal( rep );
      body.insert( W.call( self.fnFromConv( node, fieldType ),
                           [ W.call( self.rt.fnMapGet(),
                                     [ lg( map ), self.rt.strLiteral( fieldName ) ] ) ] ) );
      body.insert( ls( mess, W.nop() ) );
      body.insert( ls( val, W.nop() ) );
      if not fieldType.$nilable {
         let nameTxt = self.rt.strLiteral( fieldName );
         body.insert( W.ifElse( W.refIsNull( lg( val ) ), [
            W.ret( [ W.refNull( info.$structType ),
                     W.ifElse( W.refIsNull( lg( mess ) ), [ nameTxt ],
                               [ W.call( self.rt.fnStrConcat(),
                                         [ self.rt.strLiteral( fieldName .. "." ), lg( mess ) ] ) ],
                               self.rt.$strType ) ] ) ], nil, nil ) );
      }
      body.insert( ls( fieldLocal, self.coerceRep( lg( val ), W.typeAnyRef, rep ) ) );
      fields.insert( lg( fieldLocal ) );
   }
   body.insert( W.structNew( info.$structType, fields ) );
   body.insert( W.refNull( self.rt.$tStr ) );
   func.setBody( body );
   return index;
}

// ======== 文 ========

/** ブロック内の文を変換する。 */
fn convFilter.lowerStmtList( stmtList:&List<&Nodes.Node> ) mut : &List<&W.Ins> {
   let mut list:List<&W.Ins> = [];
   // 関数は宣言より前から参照できるように、先に登録する
   foreach stmt in stmtList {
      self.preDeclare( stmt, list );
   }
   foreach stmt in stmtList {
      self.lowerStmt( stmt, list );
   }
   return list;
}

fn convFilter.lowerBlock( node:&Nodes.BlockNode ) mut : &List<&W.Ins> {
   return self.lowerStmtList( node.$stmtList );
}

/** ブロックを、制御構造の入れ子の深さ depth で変換する */
fn convFilter.lowerBlockAt( node:&Nodes.BlockNode, depth:int ) mut : &List<&W.Ins> {
   let saved = self.ctx.$depth;
   self.ctx.set_depth( depth );
   let list = self.lowerBlock( node );
   self.ctx.set_depth( saved );
   return list;
}

/** 関数・クラスを先に登録する */
fn convFilter.preDeclare( stmt:&Nodes.Node, mut out:List<&W.Ins> ) mut {
   if! let macroNode = getMacroExp( stmt ) {
      // マクロを展開した文は、展開した位置の文と同じに扱う
      foreach child in macroNode.$stmtList {
         self.preDeclare( child, out );
      }
      return;
   }
   if! let declNode = stmt@@@Nodes.DeclFuncNode {
      if! let symbol = declNode.$declInfo.$symbol {
         self.registerFunc( declNode.$declInfo, declNode.$expType );
         let orgSym = symbol.getOrg();
         if not self.isGlobalSym( orgSym ) and not self.findLoc( orgSym ) {
            // 入れ子の関数は、クロージャを持つ変数にする
            out.insert( self.declareVar( orgSym, nil ) );
         }
      }
   }
   if! let classNode = stmt@@@Nodes.DeclClassNode {
      if classNode.$expType.$kind == .Class {
         self.registerClass( classNode );
      }
   }
}

/**
ループに入る。

ループは、break で抜けるための block と、ループ自体の loop で囲む。
ループの本体を変換する前に呼ぶ。
*/
fn convFilter.enterLoop() mut {
   self.ctx.set_depth( self.ctx.$depth + 1 );
   self.ctx.$breakDepthList.insert( self.ctx.$depth );
   self.ctx.set_depth( self.ctx.$depth + 1 );
}

/** ループを出る。ループの本体を受け取り、block と loop で囲んだ命令を返す。 */
fn convFilter.exitLoop( body:&List<&W.Ins> ) mut : &W.Ins {
   self.ctx.set_depth( self.ctx.$depth - 2 );
   self.ctx.$breakDepthList.remove(##);
   return W.block( [ W.loop( body, nil ) ], nil );
}

/**
apply 文。

str.gmatch() の場合は、Lua で全ての一致を求めてから順に処理する。
それ以外は、Lua の汎用の for と同じく、関数 f、状態 s、制御変数 c に対して、
f( s, c ) の最初の値が nil になるまで繰り返す。
*/
fn convFilter.lowerApply( node:&Nodes.ApplyNode ) mut : &W.Ins {
   let expList = node.$expList;
   let builtin = self.builtinFuncs;
   let mut list:List<&W.Ins> = [];
   if #expList.$expList >= 1 {
      let mut callNode:&Nodes.ExpCallNode! = nil;
      if! let mretNode = expList.$expList[ 1 ]@@@Nodes.ExpMRetNode {
         callNode = mretNode.$mRet@@@Nodes.ExpCallNode;
      }
      when! callNode {
         let funcType = callNode.$func.$expType;
         let mut headArgs:List<&W.Ins> = [];
         let mut isGmatch = false;
         if funcType.equals( self.processInfo, builtin.str_gmatch ## ) {
            if! let fieldNode = callNode.$func@@@Nodes.RefFieldNode {
               headArgs.insert( self.lowerExpAs( fieldNode.$prefix, Ast.builtinTypeString ) );
               isGmatch = true;
            }
         } elseif funcType.equals( self.processInfo, builtin.string_gmatch ## ) {
            isGmatch = true;
         }
         if isGmatch {
            return self.lowerApplyGmatch( node, callNode, headArgs );
         }
      }
   }

   let vals = self.lowerValList( expList, list );
   let funcType = self.normType( expList.$expTypeList[ 1 ] );
   let cloInfo = self.getFuncCloInfo( funcType );
   let clo = self.tempLocal( W.refType( cloInfo.$cloType ) );
   let state = self.tempLocal( W.typeAnyRef );
   let ctrl = self.tempLocal( W.typeAnyRef );
   list.insert( ls( clo, W.refCast( cloInfo.$cloType, vals[ 1 ].$ins ) ) );
   let getAny = fn ( index:int ) : &W.Ins {
      if index <= #vals {
         return self.coerceVal( vals[ index ], Ast.builtinTypeStem_ );
      }
      return W.refNull( W.htAny );
   };
   list.insert( ls( state, getAny( 2 ) ) );
   list.insert( ls( ctrl, getAny( 3 ) ) );

   let argTypes = funcType.$argTypeInfoList;
   let retTypes = funcType.$retTypeInfoList;
   self.enterLoop();
   let mut body:List<&W.Ins> = [];
   let mut args:List<&W.Ins> = [ lg( clo ) ];
   foreach argType, index in argTypes {
      let argIns;
      if index == 1 {
         argIns = lg( state );
      } elseif index == 2 {
         argIns = lg( ctrl );
      } else {
         argIns = W.refNull( W.htAny );
      }
      args.insert( self.coerce( argIns, Ast.builtinTypeStem_, argType ) );
   }
   args.insert( W.structGet( cloInfo.$cloType, Rt.fCloCode, lg( clo ) ) );
   body.insert( W.callRef( cloInfo.$funcType, args ) );
   let mut locals:List<int> = [];
   foreach retType in retTypes {
      locals.insert( self.tempLocal( self.getRep( retType ) ) );
   }
   for index = #locals, 1, -1 {
      body.insert( ls( locals[ index ], W.nop() ) );
   }
   // 最初の値が nil なら終わる
   body.insert( ls( ctrl, self.coerce( lg( locals[ 1 ] ), retTypes[ 1 ], Ast.builtinTypeStem_ ) ) );
   body.insert( W.brIf( 1, W.refIsNull( lg( ctrl ) ) ) );
   foreach varSym, index in node.$varList {
      let valIns;
      if index <= #retTypes {
         valIns = self.coerce( lg( locals[ index ] ), retTypes[ index ], varSym.$typeInfo );
      } else {
         valIns = self.getDefaultVal( self.getRep( varSym.$typeInfo ) );
      }
      body.insert( self.declareVar( varSym, valIns ) );
   }
   append( body, self.lowerBlock( node.$block ) );
   body.insert( W.br( 0 ) );
   list.insert( self.exitLoop( body ) );
   return W.seq( list );
}

/** apply ... of str.gmatch() */
fn convFilter.lowerApplyGmatch( node:&Nodes.ApplyNode, callNode:&Nodes.ExpCallNode,
                                headArgs:&List<&W.Ins> ) mut : &W.Ins
{
   let mut list:List<&W.Ins> = [];
   let ins, _ = self.lowerLuaCall( callNode, Rt.luaGmatchAll, headArgs );
   let result = self.tempLocal( self.rt.$listType );
   list.insert( ls( result, ins ) );
   // 1 回の一致の値の数
   let num = self.tempLocal( W.typeI32 );
   list.insert( ls( num, p( W.opI32WrapI64, [ self.rt.unboxI64( self.rt.listItem( lg( result ), 0 ) ) ] ) ) );
   let pos = self.tempLocal( W.typeI32 );
   list.insert( ls( pos, W.i32Const( 1 ) ) );
   self.enterLoop();
   let mut body:List<&W.Ins> = [];
   body.insert( W.brIf( 1, p( W.opI32GeS, [ lg( pos ),
                                            W.structGet( self.rt.$tList, Rt.fListLen,
                                                         lg( result ) ) ] ) ) );
   foreach varSym, index in node.$varList {
      let item = W.arrayGet( self.rt.$tAnyArr,
                             W.structGet( self.rt.$tList, Rt.fListItems, lg( result ) ),
                             p( W.opI32Add, [ lg( pos ), W.i32Const( index - 1 ) ] ) );
      let valIns = W.ifElse(
         p( W.opI32LtS, [ W.i32Const( index - 1 ), lg( num ) ] ),
         [ item ], [ W.refNull( W.htAny ) ], W.typeAnyRef );
      body.insert( self.declareVar(
         varSym, self.coerce( valIns, Ast.builtinTypeStem_, varSym.$typeInfo ) ) );
   }
   body.insert( ls( pos, p( W.opI32Add, [ lg( pos ), lg( num ) ] ) ) );
   append( body, self.lowerBlock( node.$block ) );
   body.insert( W.br( 0 ) );
   list.insert( self.exitLoop( body ) );
   return W.seq( list );
}

/**
if/elseif/else の連鎖を組み立てる。

k 番目の本体は、k 段の if の中にある。
*/
fn makeIfChain( conds:&List<&W.Ins>, bodies:&List<&List<&W.Ins>>,
                elseBody:&List<&W.Ins>! ) : &W.Ins
{
   let mut acc = elseBody;
   for index = #conds, 1, -1 {
      acc = [ W.ifElse( conds[ index ], bodies[ index ], acc, nil ) ];
   }
   when! acc {
      return W.seq( acc );
   }
   return W.nop();
}

fn convFilter.lowerIf( node:&Nodes.IfNode ) mut : &W.Ins {
   let base = self.ctx.$depth;
   let mut conds:List<&W.Ins> = [];
   let mut bodies:List<&List<&W.Ins>> = [];
   let mut elseBody:&List<&W.Ins>! = nil;
   foreach stmt in node.$stmtList {
      if stmt.$kind == .Else {
         elseBody = self.lowerBlockAt( stmt.$block, base + #conds );
      } else {
         self.ctx.set_depth( base + #conds );
         conds.insert( self.lowerCond( stmt.$exp ) );
         bodies.insert( self.lowerBlockAt( stmt.$block, base + #conds ) );
      }
   }
   self.ctx.set_depth( base );
   return makeIfChain( conds, bodies, elseBody );
}

fn convFilter.lowerSwitch( node:&Nodes.SwitchNode ) mut : &W.Ins {
   let base = self.ctx.$depth;
   let val = self.lowerVal( node.$exp );
   let work = self.tempLocal( val.$rep );
   let localVal = new Val( lg( work ), val.$rep, val.$typeInfo );
   let mut conds:List<&W.Ins> = [];
   let mut bodies:List<&List<&W.Ins>> = [];
   foreach caseInfo in node.$caseList {
      let mut cond:&W.Ins! = nil;
      foreach exp in caseInfo.$expList.$expList {
         let eq = self.lowerEqVals( localVal, self.lowerVal( exp ) );
         if! let prev = cond {
            cond = p( W.opI32Or, [ prev, eq ] );
         } else {
            cond = eq;
         }
      }
      conds.insert( unwrap cond default W.i32Const( 0 ) );
      bodies.insert( self.lowerBlockAt( caseInfo.$block, base + #conds ) );
   }
   let mut elseBody:&List<&W.Ins>! = nil;
   if! let defBlock = node.$default {
      elseBody = self.lowerBlockAt( defBlock, base + #conds );
   }
   return W.seq( [ ls( work, val.$ins ), makeIfChain( conds, bodies, elseBody ) ] );
}

fn convFilter.lowerMatch( node:&Nodes.MatchNode ) mut : &W.Ins {
   let base = self.ctx.$depth;
   let algeType = self.getGenSrc( node.$val.$expType );
   let! info = self.getAlgeInfo( algeType ) {
      self.error( node, "not found alge -- %s" ( algeType.getTxt( ## ) ) );
   };
   let algeVal = self.tempLocal( W.refType( info.$baseType ) );
   let tag = self.tempLocal( W.typeI32 );
   let mut conds:List<&W.Ins> = [];
   let mut bodies:List<&List<&W.Ins>> = [];
   foreach caseInfo in node.$caseList {
      let name = caseInfo.$valInfo.$name;
      conds.insert( p( W.opI32Eq, [ lg( tag ), W.i32Const( unwrap info.$name2tag[ name ] ) ] ) );
      self.ctx.set_depth( base + #conds );
      let mut body:List<&W.Ins> = [];
      let valType = unwrap info.$name2type[ name ];
      foreach symbol, index in caseInfo.$valParamNameList {
         let paramType = caseInfo.$valInfo.$typeList[ index ];
         let paramVal = W.structGet( valType, index + 1, W.refCast( valType, lg( algeVal ) ) );
         body.insert( self.declareVar( symbol, self.coerce( paramVal, paramType,
                                                            symbol.$typeInfo ) ) );
      }
      append( body, self.lowerBlock( caseInfo.$block ) );
      bodies.insert( body );
   }
   let mut elseBody:&List<&W.Ins>! = nil;
   if! let defBlock = node.$defaultBlock {
      self.ctx.set_depth( base + #conds );
      let mut defBody:List<&W.Ins> = [];
      self.lowerStmt( defBlock, defBody );
      elseBody = defBody;
   }
   self.ctx.set_depth( base );
   return W.seq( [ ls( algeVal, self.lowerExpAs( node.$val, algeType ) ),
                   ls( tag, W.structGet( info.$baseType, 1, lg( algeVal ) ) ),
                   makeIfChain( conds, bodies, elseBody ) ] );
}

/** nilable を外す前の値 (暗黙の cast を取り除いた式) を評価する */
fn convFilter.lowerRawVal( node:&Nodes.Node ) mut : &Val {
   if! let castNode = node@@@Nodes.ExpCastNode {
      if castNode.$castKind == .Implicit and castNode.$exp.$expType.$nilable {
         return self.lowerVal( castNode.$exp );
      }
   }
   return self.lowerVal( node );
}

/** 値を局所変数に入れる */
fn convFilter.spillVal( val:&Val, mut pre:List<&W.Ins> ) mut : &Val {
   let work = self.tempLocal( val.$rep );
   pre.insert( ls( work, val.$ins ) );
   return new Val( lg( work ), val.$rep, val.$typeInfo );
}

/**
値のリストの末尾が ... の値 (List) の場合、num 個の値になるように、その要素に展開する。

let a, b = ...; のように、... の値を複数の変数で受け取る場合に使う。
*/
fn convFilter.expandDDD( vals:&List<&Val>, num:int, mut pre:List<&W.Ins> ) mut : &List<&Val> {
   if #vals == 0 or #vals > num or
      self.normType( vals[ #vals ].$typeInfo ).$kind ~= .DDD
   {
      return vals;
   }
   let mut work:List<&Val> = [];
   for index = 1, #vals - 1 {
      work.insert( vals[ index ] );
   }
   let list = self.spillVal( vals[ #vals ], pre );
   for index = 1, num - #vals + 1 {
      work.insert( self.spillVal(
         new Val( W.call( self.rt.fnListGet(), [ list.$ins, W.i64Const( index ) ] ),
                  W.typeAnyRef, Ast.builtinTypeStem_ ), pre ) );
   }
   return work;
}

/** 値のリストを評価して局所変数に入れる (nilable を外す前の値) */
fn convFilter.lowerRawValList( expList:&Nodes.ExpListNode, mut pre:List<&W.Ins> ) mut
   : &List<&Val>
{
   let mut vals:List<&Val> = [];
   if expList.$mRetExp {
      foreach val in self.lowerValListSub( expList, pre, true ) {
         vals.insert( self.spillVal( val, pre ) );
      }
   } else {
      foreach exp in expList.$expList {
         vals.insert( self.spillVal( self.lowerRawVal( exp ), pre ) );
      }
   }
   return vals;
}

/** 先頭から num 個の値のどれかが nil かどうか */
fn convFilter.anyNil( vals:&List<&Val>, num:int ) : &W.Ins {
   let mut cond:&W.Ins = W.i32Const( 0 );
   foreach val, index in vals {
      if val.$rep.isRef() and index <= num {
         cond = p( W.opI32Or, [ cond, W.refIsNull( val.$ins ) ] );
      }
   }
   return cond;
}

fn convFilter.lowerDeclVar( node:&Nodes.DeclVarNode, mut out:List<&W.Ins> ) mut {
   if node.$unwrapFlag {
      // let! a, b = exp { 処理 } then { 処理 };
      let base = self.ctx.$depth;
      let mut vals:&List<&Val> = [];
      if! let expList = node.$expList {
         vals = self.expandDDD( self.lowerRawValList( expList, out ),
                                #node.$symbolInfoList, out );
      }
      if node.$mode == .Let {
         // unwrap! (mode が Unwrap) は、宣言済みの変数への代入
         foreach symbol in node.$symbolInfoList {
            out.insert( self.declareVar( symbol, nil ) );
         }
      }
      self.ctx.set_depth( base + 1 );
      let mut nilBody:List<&W.Ins> = [];
      if! let block = node.$unwrapBlock {
         // ブロックの中では、_変数名 で unwrap する前の値を参照できる
         foreach symbol, index in node.$symbolInfoList {
            if! let rawSym = block.$scope.$symbol2SymbolInfoMap[ "_" .. symbol.$name ] {
               if index <= #vals {
                  nilBody.insert( self.declareVar(
                     rawSym, self.coerceVal( vals[ index ], rawSym.$typeInfo ) ) );
               }
            }
         }
         append( nilBody, self.lowerBlock( block ) );
      }
      let mut thenBody:List<&W.Ins> = [];
      foreach symbol, index in node.$symbolInfoList {
         if index <= #vals {
            thenBody.insert( self.writeSym( node, symbol,
                                            self.coerceVal( vals[ index ], symbol.$typeInfo ) ) );
         }
      }
      if! let block = node.$thenBlock {
         append( thenBody, self.lowerBlock( block ) );
      }
      self.ctx.set_depth( base );
      out.insert( W.ifElse( self.anyNil( vals, #node.$symbolInfoList ), nilBody, thenBody, nil ) );
      return;
   }
   let mut vals:&List<&Val> = [];
   if! let expList = node.$expList {
      vals = self.expandDDD( self.lowerValList( expList, out ), #node.$symbolInfoList, out );
   }
   foreach symbol, index in node.$symbolInfoList {
      if index <= #vals {
         out.insert( self.declareVar( symbol, self.coerceVal( vals[ index ], symbol.$typeInfo ) ) );
      } else {
         out.insert( self.declareVar( symbol, nil ) );
      }
   }
}

fn convFilter.lowerIfUnwrap( node:&Nodes.IfUnwrapNode ) mut : &W.Ins {
   let base = self.ctx.$depth;
   let mut pre:List<&W.Ins> = [];
   let vals = self.expandDDD( self.lowerRawValList( node.$expList, pre ),
                              #node.$varSymList, pre );
   self.ctx.set_depth( base + 1 );
   let mut thenBody:List<&W.Ins> = [];
   foreach symbol, index in node.$varSymList {
      if index <= #vals {
         thenBody.insert( self.declareVar( symbol,
                                           self.coerceVal( vals[ index ], symbol.$typeInfo ) ) );
      }
   }
   append( thenBody, self.lowerBlock( node.$block ) );
   let mut elseBody:&List<&W.Ins>! = nil;
   if! let block = node.$nilBlock {
      elseBody = self.lowerBlock( block );
   }
   self.ctx.set_depth( base );
   let mut checkNum = #node.$varSymList;
   if checkNum == 0 {
      checkNum = #vals;
   }
   pre.insert( W.ifElse( self.anyNil( vals, checkNum ), unwrap elseBody default [], thenBody,
                         nil ) );
   return W.seq( pre );
}

fn convFilter.lowerWhen( node:&Nodes.WhenNode ) mut : &W.Ins {
   let base = self.ctx.$depth;
   let mut vals:List<&Val> = [];
   foreach pair in node.$symPairList {
      let src = pair.$src.getOrg();
      vals.insert( new Val( self.readSym( node, src ), self.getRep( src.$typeInfo ),
                            src.$typeInfo ) );
   }
   self.ctx.set_depth( base + 1 );
   let mut thenBody:List<&W.Ins> = [];
   foreach pair, index in node.$symPairList {
      thenBody.insert( self.declareVar( pair.$dst, self.coerceVal( vals[ index ],
                                                                   pair.$dst.$typeInfo ) ) );
   }
   append( thenBody, self.lowerBlock( node.$block ) );
   let mut elseBody:&List<&W.Ins>! = nil;
   if! let block = node.$elseBlock {
      elseBody = self.lowerBlock( block );
   }
   self.ctx.set_depth( base );
   return W.ifElse( self.anyNil( vals, #vals ), unwrap elseBody default [], thenBody, nil );
}

fn convFilter.lowerUnwrapSet( node:&Nodes.UnwrapSetNode, mut out:List<&W.Ins> ) mut {
   let base = self.ctx.$depth;
   let vals = self.expandDDD( self.lowerRawValList( node.$srcExpList, out ),
                              #node.$dstExpList.$expList, out );
   self.ctx.set_depth( base + 1 );
   let mut nilBody:List<&W.Ins> = [];
   if! let block = node.$unwrapBlock {
      append( nilBody, self.lowerBlock( block ) );
   }
   let mut thenBody:List<&W.Ins> = [];
   foreach dst, index in node.$dstExpList.$expList {
      if index <= #vals {
         self.lowerAssign( dst, vals[ index ], thenBody );
      }
   }
   self.ctx.set_depth( base );
   out.insert( W.ifElse( self.anyNil( vals, #node.$dstExpList.$expList ), nilBody, thenBody, nil ) );
}

/** 代入先への代入 */
fn convFilter.lowerAssign( dst:&Nodes.Node, val:&Val, mut out:List<&W.Ins> ) mut {
   if! let refNode = dst@@@Nodes.ExpRefNode {
      let symbol = refNode.$symbolInfo.getOrg();
      out.insert( self.writeSym( dst, symbol, self.coerceVal( val, symbol.$typeInfo ) ) );
      return;
   }
   if! let fieldNode = dst@@@Nodes.RefFieldNode {
      let prefixType = self.normType( fieldNode.$prefix.$expType );
      let name = fieldNode.$field.txt;
      if! let symbol = fieldNode.$symbolInfo {
         let orgSym = symbol.getOrg();
         if self.globalSym2loc[ orgSym ] {
            out.insert( self.writeSym( dst, orgSym, self.coerceVal( val, orgSym.$typeInfo ) ) );
            return;
         }
      }
      if prefixType.$kind == .Map {
         out.insert( W.call( self.rt.fnMapSet(),
                             [ self.lowerExp( fieldNode.$prefix ), self.rt.strLiteral( name ),
                               self.toAny( val ) ] ) );
         return;
      }
      let objType = self.getObjType( prefixType );
      let! info = self.getClassInfo( objType ) {
         self.error( dst, "not found class -- %s" ( objType.getTxt( ## ) ) );
      };
      let fieldIndex = self.getFieldIndex( dst, info, name );
      out.insert( W.structSet(
         info.$structType, fieldIndex,
         W.refCast( info.$structType, self.lowerExpAs( fieldNode.$prefix, info.$typeInfo ) ),
         self.coerce( val.$ins, val.$typeInfo, self.getMemberType( info, name ) ) ) );
      return;
   }
   if! let itemNode = dst@@@Nodes.ExpRefItemNode {
      let index;
      if! let indexNode = itemNode.$index {
         index = self.lowerVal( indexNode );
      } else {
         index = new Val( self.rt.strLiteral( unwrap itemNode.$symbol ), self.rt.$strType,
                          Ast.builtinTypeString );
      }
      self.assignItem( dst, itemNode.$val, index, val, out );
      return;
   }
   self.error( dst, "not support assign -- %s" ( Nodes.getNodeKindName( dst.$kind ) ) );
}

/** コレクションの要素への代入 */
fn convFilter.assignItem( node:&Nodes.Node, collNode:&Nodes.Node, index:&Val, val:&Val,
                          mut out:List<&W.Ins> ) mut
{
   let collType = self.normType( collNode.$expType );
   let coll = self.lowerExp( collNode );
   switch collType.$kind {
      case .List, .Array {
         out.insert( W.call( self.rt.fnListSet(),
                             [ coll, self.coerceVal( index, Ast.builtinTypeInt ),
                               self.toAny( val ) ] ) );
         return;
      }
      case .Map {
         out.insert( W.call( self.rt.fnMapSet(), [ coll, self.toAny( index ), self.toAny( val ) ] ) );
         return;
      }
   }
   self.error( node, "not support assign -- %s" ( collType.getTxt( ## ) ) );
}

/** ExpSetItem (val[index] = exp) */
fn convFilter.lowerSetItem( node:&Nodes.ExpSetItemNode, mut out:List<&W.Ins> ) mut {
   let index;
   _match node.$index {
      case .NodeIdx( indexNode ) {
         index = self.lowerVal( indexNode );
      }
      case .SymIdx( symTxt ) {
         index = new Val( self.rt.strLiteral( symTxt ), self.rt.$strType, Ast.builtinTypeString );
      }
   }
   let val;
   if! let listNode = node.$exp2@@@Nodes.ExpListNode {
      let vals = self.lowerValList( listNode, out );
      val = vals[ 1 ];
   } else {
      val = self.lowerVal( node.$exp2 );
   }
   self.assignItem( node, node.$val, index, val, out );
}

fn convFilter.lowerSetVal( node:&Nodes.ExpSetValNode, mut out:List<&W.Ins> ) mut {
   let mut dstList:List<&Nodes.Node> = [];
   if! let listNode = node.$exp1@@@Nodes.ExpListNode {
      foreach exp in listNode.$expList {
         dstList.insert( exp );
      }
   } else {
      dstList.insert( node.$exp1 );
   }
   let mut vals = self.expandDDD( self.lowerValList( node.$exp2, out ), #dstList, out );
   if #dstList > 1 {
      // 全ての値を評価してから代入する
      let mut work:List<&Val> = [];
      foreach val in vals {
         work.insert( self.spillVal( val, out ) );
      }
      vals = work;
   }
   foreach dst, index in dstList {
      if index <= #vals {
         self.lowerAssign( dst, vals[ index ], out );
      } else {
         self.lowerAssign( dst, new Val( W.refNull( W.htAny ), W.typeAnyRef, Ast.builtinTypeNil ),
                           out );
      }
   }
}

fn convFilter.lowerReturn( node:&Nodes.ReturnNode, mut out:List<&W.Ins> ) mut {
   let mut vals:&List<&Val> = [];
   if! let expList = node.$expList {
      vals = self.lowerValList( expList, out );
   }
   let retTypes = self.ctx.$retTypes;
   let mut rets:List<&W.Ins> = [];
   foreach retType, index in retTypes {
      let retRep = self.ctx.$retReps[ index ];
      if self.normType( retType ).$kind == .DDD and index == #retTypes {
         if #vals == index and self.normType( vals[ index ].$typeInfo ).$kind == .DDD {
            rets.insert( vals[ index ].$ins );
         } else {
            let mut rest:List<&Val> = [];
            for work = index, #vals {
               rest.insert( vals[ work ] );
            }
            rets.insert( self.buildList( rest ) );
         }
      } elseif index <= #vals {
         rets.insert( self.coerceRep( self.coerceVal( vals[ index ], retType ),
                                      self.getRep( retType ), retRep ) );
      } else {
         rets.insert( self.getDefaultVal( retRep ) );
      }
   }
   out.insert( W.ret( rets ) );
}

fn convFilter.lowerFor( node:&Nodes.ForNode ) mut : &W.Ins {
   // 変数が real の場合は f64 で数える (Lua と同じく、増分が実数なら実数のループ)
   let isReal = self.isType( node.$val.$typeInfo, Ast.builtinTypeReal );
   let rep;
   let numType;
   let mut ge = W.opI64GeS;
   let mut gt = W.opI64GtS;
   let mut lt = W.opI64LtS;
   let mut add = W.opI64Add;
   let zero;
   if isReal {
      rep = W.typeF64;
      numType = Ast.builtinTypeReal;
      ge = W.opF64Ge;
      gt = W.opF64Gt;
      lt = W.opF64Lt;
      add = W.opF64Add;
      zero = W.f64Const( 0.0 );
   } else {
      rep = W.typeI64;
      numType = Ast.builtinTypeInt;
      zero = W.i64Const( 0 );
   }
   let counter = self.tempLocal( rep );
   let toIdx = self.tempLocal( rep );
   let stepIdx = self.tempLocal( rep );

   let mut list:List<&W.Ins> = [];
   list.insert( ls( counter, self.lowerExpAs( node.$init, numType ) ) );
   list.insert( ls( toIdx, self.lowerExpAs( node.$to, numType ) ) );
   if! let delta = node.$delta {
      list.insert( ls( stepIdx, self.lowerExpAs( delta, numType ) ) );
   } elseif isReal {
      list.insert( ls( stepIdx, W.f64Const( 1.0 ) ) );
   } else {
      list.insert( ls( stepIdx, W.i64Const( 1 ) ) );
   }
   self.enterLoop();
   let mut body:List<&W.Ins> = [];
   // step >= 0 なら counter > to、そうでなければ counter < to で抜ける
   body.insert( W.brIf( 1, W.ifElse(
      p( ge, [ lg( stepIdx ), zero ] ),
      [ p( gt, [ lg( counter ), lg( toIdx ) ] ) ],
      [ p( lt, [ lg( counter ), lg( toIdx ) ] ) ], W.typeI32 ) ) );
   body.insert( self.declareVar( node.$val, self.coerceRep( lg( counter ), rep,
                                                            self.getRep( node.$val.$typeInfo ) ) ) );
   body.insert( ls( counter, p( add, [ lg( counter ), lg( stepIdx ) ] ) ) );
   append( body, self.lowerBlock( node.$block ) );
   body.insert( W.br( 0 ) );
   list.insert( self.exitLoop( body ) );
   return W.seq( list );
}

fn convFilter.lowerForeach( node:&Nodes.Node, valSym:&Ast.SymbolInfo, keySym:&Ast.SymbolInfo!,
                            exp:&Nodes.Node, block:&Nodes.BlockNode, sort:bool ) mut : &W.Ins
{
   let mut expType = self.normType( exp.$expType );
   let mut list:List<&W.Ins> = [];
   let pos = self.tempLocal( W.typeI32 );
   list.insert( ls( pos, W.i32Const( 0 ) ) );
   let luavalFlag = self.isLuaval( exp.$expType );
   if luavalFlag {
      // Lua の値は、List / Map に変換して処理する (要素のテーブルは Lua の値のまま)
      expType = self.normType( exp.$expType.$nonnilableType.$extedType );
   }
   let lowerColl = fn () : &W.Ins {
      if not luavalFlag {
         return self.lowerExp( exp );
      }
      let luaVal = self.lowerExpAs( exp, Ast.builtinTypeStem_ );
      if expType.$kind == .List or expType.$kind == .Array {
         return W.call( self.rt.fnLuaToList(), [ luaVal ] );
      }
      return W.call( self.rt.fnLuaToMap(), [ luaVal, W.i32Const( 0 ) ] );
   };
   switch expType.$kind {
      case .List, .Array {
         let coll = self.tempLocal( self.rt.$listType );
         list.insert( ls( coll, lowerColl() ) );
         self.enterLoop();
         let mut body:List<&W.Ins> = [];
         body.insert( W.brIf( 1, p( W.opI32GeS, [ lg( pos ),
                                                  W.structGet( self.rt.$tList, Rt.fListLen,
                                                               lg( coll ) ) ] ) ) );
         let item = W.arrayGet( self.rt.$tAnyArr,
                                W.structGet( self.rt.$tList, Rt.fListItems, lg( coll ) ),
                                lg( pos ) );
         body.insert( self.declareVar( valSym, self.coerceRep( item, W.typeAnyRef,
                                                               self.getRep( valSym.$typeInfo ) ) ) );
         body.insert( ls( pos, p( W.opI32Add, [ lg( pos ), W.i32Const( 1 ) ] ) ) );
         when! keySym {
            body.insert( self.declareVar( keySym, p( W.opI64ExtendI32U, [ lg( pos ) ] ) ) );
         }
         append( body, self.lowerBlock( block ) );
         body.insert( W.br( 0 ) );
         list.insert( self.exitLoop( body ) );
         return W.seq( list );
      }
      case .Map, .Set {
         let isSet = expType.$kind == .Set;
         let coll = self.tempLocal( self.rt.$mapType );
         list.insert( ls( coll, lowerColl() ) );
         if sort {
            // キーを整列して処理する
            let keys = self.tempLocal( self.rt.$listType );
            list.insert( ls( keys, W.call( self.rt.fnMapKeys(), [ lg( coll ) ] ) ) );
            list.insert( W.call( self.rt.fnListSort(),
                                 [ lg( keys ), W.refNull( self.rt.getLessCloInfo().$cloType ) ] ) );
            let key = self.tempLocal( W.typeAnyRef );
            self.enterLoop();
            let mut body:List<&W.Ins> = [];
            body.insert( W.brIf( 1, p( W.opI32GeS, [ lg( pos ),
                                                     W.structGet( self.rt.$tList, Rt.fListLen,
                                                                  lg( keys ) ) ] ) ) );
            body.insert( ls( key, W.arrayGet( self.rt.$tAnyArr,
                                              W.structGet( self.rt.$tList, Rt.fListItems,
                                                           lg( keys ) ), lg( pos ) ) ) );
            body.insert( ls( pos, p( W.opI32Add, [ lg( pos ), W.i32Const( 1 ) ] ) ) );
            let valIns;
            if isSet {
               valIns = lg( key );
            } else {
               valIns = W.call( self.rt.fnMapGet(), [ lg( coll ), lg( key ) ] );
            }
            body.insert( self.declareVar( valSym, self.coerceRep(
               valIns, W.typeAnyRef, self.getRep( valSym.$typeInfo ) ) ) );
            when! keySym {
               body.insert( self.declareVar( keySym, self.coerceRep(
                  lg( key ), W.typeAnyRef, self.getRep( keySym.$typeInfo ) ) ) );
            }
            append( body, self.lowerBlock( block ) );
            body.insert( W.br( 0 ) );
            list.insert( self.exitLoop( body ) );
            return W.seq( list );
         }
         self.enterLoop();
         let mut body:List<&W.Ins> = [];
         body.insert( ls( pos, W.call( self.rt.fnMapNext(), [ lg( coll ), lg( pos ) ] ) ) );
         body.insert( W.brIf( 1, p( W.opI32LtS, [ lg( pos ), W.i32Const( 0 ) ] ) ) );
         let keyIns = self.rt.mapKeyAt( lg( coll ), lg( pos ) );
         let valIns;
         if isSet {
            valIns = keyIns;
         } else {
            valIns = self.rt.mapValAt( lg( coll ), lg( pos ) );
         }
         body.insert( self.declareVar( valSym, self.coerceRep(
            valIns, W.typeAnyRef, self.getRep( valSym.$typeInfo ) ) ) );
         when! keySym {
            body.insert( self.declareVar( keySym, self.coerceRep(
               keyIns, W.typeAnyRef, self.getRep( keySym.$typeInfo ) ) ) );
         }
         body.insert( ls( pos, p( W.opI32Add, [ lg( pos ), W.i32Const( 1 ) ] ) ) );
         append( body, self.lowerBlock( block ) );
         body.insert( W.br( 0 ) );
         list.insert( self.exitLoop( body ) );
         return W.seq( list );
      }
   }
   self.error( node, "not support foreach -- %s" ( expType.getTxt( ## ) ) );
}

/** 文が持つ ! (CondRet) の情報 */
fn convFilter.getCondRetInfo( node:&Nodes.Node ) : &Nodes.CondRetInfo! {
   if! let work = node@@@Nodes.DeclVarNode {
      return work.$condRetInfo;
   } elseif! let work = node@@@Nodes.ExpSetValNode {
      return work.$condRetInfo;
   } elseif! let work = node@@@Nodes.ExpSetItemNode {
      return work.$condRetInfo;
   } elseif! let work = node@@@Nodes.IfUnwrapNode {
      return work.$condRetInfo;
   } elseif! let work = node@@@Nodes.IfNode {
      return work.$stmtList[ 1 ].$condRetInfo;
   } elseif! let work = node@@@Nodes.StmtExpNode {
      if! let condRetList = work.$exp@@@Nodes.CondRetListNode {
         return condRetList.$info;
      }
   }
   return nil;
}

/**
文の中の ! (CondRet) を処理する。

値を局所変数に入れ、nil (__Ret の場合は Err) なら関数から戻る。
CondRet のノードは、その局所変数の値で置き換える。
*/
fn convFilter.lowerCondRetOf( node:&Nodes.Node, mut out:List<&W.Ins> ) mut {
   let! info = self.getCondRetInfo( node ) {
      return;
   };
   let retReps = self.ctx.$retReps;
   // 1 番目の戻り値を first にして、残りは既定値で戻る
   let retWith = fn ( first:&W.Ins! ) : &W.Ins {
      let mut vals:List<&W.Ins> = [];
      foreach rep, index in retReps {
         when! first {
            if index == 1 {
               vals.insert( first );
               continue;
            }
         }
         vals.insert( self.getDefaultVal( rep ) );
      }
      return W.ret( vals );
   };
   foreach condRet in info.$list {
      _switch condRet.$condKind {
         case .Nilable {
            let val = self.lowerVal( condRet.$exp );
            let work = self.tempLocal( val.$rep );
            out.insert( ls( work, val.$ins ) );
            out.insert( W.ifElse( W.refIsNull( lg( work ) ), [ retWith( nil ) ], nil, nil ) );
            self.node2val[ condRet ] = new Val( lg( work ), val.$rep, val.$typeInfo );
         }
         case .Ret {
            let algeType = self.getGenSrc( condRet.$exp.$expType );
            let! algeInfo = self.getAlgeInfo( algeType ) {
               self.error( condRet, "not found alge -- %s" ( algeType.getTxt( ## ) ) );
            };
            let algeRep = W.refType( algeInfo.$baseType );
            let work = self.tempLocal( algeRep );
            out.insert( ls( work, self.lowerExpAs( condRet.$exp, algeType ) ) );
            // Err なら、その値をそのまま返す
            out.insert( W.ifElse(
               p( W.opI32Eq, [ W.structGet( algeInfo.$baseType, 1, lg( work ) ),
                               W.i32Const( unwrap algeInfo.$name2tag[ "Err" ] ) ] ),
               [ retWith( self.coerceRep( lg( work ), algeRep, retReps[ 1 ] ) ) ], nil, nil ) );
            let okType = unwrap algeInfo.$name2type[ "Ok" ];
            self.node2val[ condRet ] = new Val(
               // フィールド 1 は tag なので、値は 2 から
               W.structGet( okType, 2, W.refCast( okType, lg( work ) ) ),
               W.typeAnyRef, Ast.builtinTypeStem_ );
         }
         case .Two {
            let vals = self.lowerMulti( condRet.$exp, out );
            let val = vals[ 1 ];
            let errVal = vals[ 2 ];
            let mut retVals:List<&W.Ins> = [];
            foreach rep, index in retReps {
               if index == 2 {
                  retVals.insert( self.coerceRep( self.coerceVal( errVal, Ast.builtinTypeStem_ ),
                                                  W.typeAnyRef, rep ) );
               } else {
                  retVals.insert( self.getDefaultVal( rep ) );
               }
            }
            out.insert( W.ifElse( W.refIsNull( val.$ins ), [ W.ret( retVals ) ], nil, nil ) );
            self.node2val[ condRet ] = val;
         }
      }
   }
}

/** 式文。戻り値は捨てる */
fn convFilter.lowerStmtExp( exp:&Nodes.Node, mut out:List<&W.Ins> ) mut {
   if exp.$kind == Nodes.NodeKind.$ExpSetVal or exp.$kind == Nodes.NodeKind.$ExpSetItem {
      self.lowerStmt( exp, out );
      return;
   }
   if! let callNode = exp@@@Nodes.ExpCallNode {
      // obj$.func() の文は、obj が nil でなければ呼び出す
      let prefix = self.getNilAccPrefix( callNode );
      let mut work:List<&W.Ins> = [];
      let mut prefixLocal = -1;
      when! prefix {
         let prefixVal = self.lowerVal( prefix );
         prefixLocal = self.tempLocal( prefixVal.$rep );
         out.insert( ls( prefixLocal, prefixVal.$ins ) );
         self.node2val[ prefix ] = new Val( lg( prefixLocal ), prefixVal.$rep, prefixVal.$typeInfo );
         self.nilAccDoneSet.add( callNode );
         self.nilAccDoneSet.add( callNode.$func );
      }
      let ins, retTypes = self.lowerCall( callNode );
      work.insert( ins );
      foreach _ in retTypes {
         work.insert( W.drop( W.nop() ) );
      }
      when! prefix {
         self.node2val[ prefix ] = nil;
         out.insert( W.ifElse( p( W.opI32Eqz, [ W.refIsNull( lg( prefixLocal ) ) ] ),
                               work, nil, nil ) );
      } else {
         append( out, work );
      }
      return;
   }
   if! let superNode = exp@@@Nodes.ExpCallSuperNode {
      let ins, retTypes = self.lowerCallSuper( superNode );
      out.insert( ins );
      foreach _ in retTypes {
         out.insert( W.drop( W.nop() ) );
      }
      return;
   }
   if! let ctorNode = exp@@@Nodes.ExpCallSuperCtorNode {
      self.lowerCallSuperCtor( ctorNode, out );
      return;
   }
   if! let macroNode = exp@@@Nodes.ExpMacroExpNode {
      foreach ins in self.lowerStmtList( macroNode.$stmtList ) {
         out.insert( ins );
      }
      return;
   }
   let val = self.lowerVal( exp );
   if val.$typeInfo == Ast.builtinTypeNone {
      out.insert( val.$ins );
   } else {
      out.insert( W.drop( val.$ins ) );
   }
}

/** super( ... ) (親クラスのコンストラクタの呼び出し) */
fn convFilter.lowerCallSuperCtor( node:&Nodes.ExpCallSuperCtorNode, mut out:List<&W.Ins> ) mut {
   let! info = self.getClassInfo( node.$superType ) {
      self.error( node, "not found class -- %s" ( node.$superType.getTxt( ## ) ) );
   };
   let mut args:List<&W.Ins> = [ lg( self.ctx.$selfLocal ) ];
   append( args, self.lowerArgs( node.$expList, self.getCtorType( info.$typeInfo ).$argTypeInfoList,
                                 out ) );
   out.insert( W.call( info.$ctorFunc, args ) );
}

/** 文 */
fn convFilter.lowerStmt( node:&Nodes.Node, mut out:List<&W.Ins> ) mut {
   // 文の中の ! (CondRet) の値を、文の前に求める
   self.lowerCondRetOf( node, out );
   switch node.$kind {
      case Nodes.NodeKind.$None, Nodes.NodeKind.$BlankLine, Nodes.NodeKind.$Shebang,
         Nodes.NodeKind.$LuneControl, Nodes.NodeKind.$DeclMacro, Nodes.NodeKind.$TestBlock,
         Nodes.NodeKind.$DeclForm, Nodes.NodeKind.$ProtoClass, Nodes.NodeKind.$DeclEnum,
         Nodes.NodeKind.$DeclAlge, Nodes.NodeKind.$ProtoMethod, Nodes.NodeKind.$Subfile,
         Nodes.NodeKind.$Alias, Nodes.NodeKind.$TestCase, Nodes.NodeKind.$Provide
      {
         return;
      }
      case Nodes.NodeKind.$DeclFunc {
         let declNode = unwrap node@@@Nodes.DeclFuncNode;
         let funcIndex = self.registerFunc( declNode.$declInfo, declNode.$expType );
         let closure = self.compileFunc( node, declNode.$declInfo, declNode.$expType, funcIndex );
         if! let symbol = declNode.$declInfo.$symbol {
            if not self.isGlobalSym( symbol.getOrg() ) {
               out.insert( self.writeSym( node, symbol, closure ) );
            }
         }
         return;
      }
      case Nodes.NodeKind.$DeclClass {
         self.lowerDeclClass( unwrap node@@@Nodes.DeclClassNode, out );
         return;
      }
      case Nodes.NodeKind.$DeclMethod {
         let declNode = unwrap node@@@Nodes.DeclMethodNode;
         self.compileMethodNode( node, declNode.$declInfo );
         return;
      }
      case Nodes.NodeKind.$StmtExp {
         let mut exp = (unwrap node@@@Nodes.StmtExpNode).$exp;
         if! let condRetList = exp@@@Nodes.CondRetListNode {
            exp = condRetList.$exp;
         }
         self.lowerStmtExp( exp, out );
         return;
      }
      case Nodes.NodeKind.$ExpCall, Nodes.NodeKind.$ExpCallSuperCtor, Nodes.NodeKind.$ExpMacroExp {
         self.lowerStmtExp( node, out );
         return;
      }
      case Nodes.NodeKind.$DeclVar {
         self.lowerDeclVar( unwrap node@@@Nodes.DeclVarNode, out );
         return;
      }
      case Nodes.NodeKind.$ExpSetVal {
         self.lowerSetVal( unwrap node@@@Nodes.ExpSetValNode, out );
         return;
      }
      case Nodes.NodeKind.$ExpSetItem {
         self.lowerSetItem( unwrap node@@@Nodes.ExpSetItemNode, out );
         return;
      }
      case Nodes.NodeKind.$UnwrapSet {
         self.lowerUnwrapSet( unwrap node@@@Nodes.UnwrapSetNode, out );
         return;
      }
      case Nodes.NodeKind.$If {
         out.insert( self.lowerIf( unwrap node@@@Nodes.IfNode ) );
         return;
      }
      case Nodes.NodeKind.$IfUnwrap {
         out.insert( self.lowerIfUnwrap( unwrap node@@@Nodes.IfUnwrapNode ) );
         return;
      }
      case Nodes.NodeKind.$When {
         out.insert( self.lowerWhen( unwrap node@@@Nodes.WhenNode ) );
         return;
      }
      case Nodes.NodeKind.$Switch {
         out.insert( self.lowerSwitch( unwrap node@@@Nodes.SwitchNode ) );
         return;
      }
      case Nodes.NodeKind.$Match {
         out.insert( self.lowerMatch( unwrap node@@@Nodes.MatchNode ) );
         return;
      }
      case Nodes.NodeKind.$While {
         let whileNode = unwrap node@@@Nodes.WhileNode;
         self.enterLoop();
         let mut body:List<&W.Ins> = [];
         if not whileNode.$infinit {
            body.insert( W.brIf( 1, p( W.opI32Eqz, [ self.lowerCond( whileNode.$exp ) ] ) ) );
         }
         append( body, self.lowerBlock( whileNode.$block ) );
         body.insert( W.br( 0 ) );
         out.insert( self.exitLoop( body ) );
         return;
      }
      case Nodes.NodeKind.$Repeat {
         let repeatNode = unwrap node@@@Nodes.RepeatNode;
         self.enterLoop();
         let mut body:List<&W.Ins> = [];
         append( body, self.lowerBlock( repeatNode.$block ) );
         // 条件が偽ならループの先頭に戻る
         body.insert( W.brIf( 0, p( W.opI32Eqz, [ self.lowerCond( repeatNode.$exp ) ] ) ) );
         out.insert( self.exitLoop( body ) );
         return;
      }
      case Nodes.NodeKind.$For {
         out.insert( self.lowerFor( unwrap node@@@Nodes.ForNode ) );
         return;
      }
      case Nodes.NodeKind.$Foreach {
         let foreachNode = unwrap node@@@Nodes.ForeachNode;
         out.insert( self.lowerForeach( node, foreachNode.$val, foreachNode.$key,
                                        foreachNode.$exp, foreachNode.$block, false ) );
         return;
      }
      case Nodes.NodeKind.$Forsort {
         let forsortNode = unwrap node@@@Nodes.ForsortNode;
         out.insert( self.lowerForeach( node, forsortNode.$val, forsortNode.$key,
                                        forsortNode.$exp, forsortNode.$block, true ) );
         return;
      }
      case Nodes.NodeKind.$Continue {
         let breakList = self.ctx.$breakDepthList;
         if #breakList == 0 {
            self.error( node, "continue outside loop" );
         }
         // ループの更新 (カウンタの加算など) は本体の先頭で行うので、loop の先頭に戻れば良い
         out.insert( W.br( self.ctx.$depth - ( breakList[ #breakList ] + 1 ) ) );
         return;
      }
      case Nodes.NodeKind.$Break {
         let breakList = self.ctx.$breakDepthList;
         if #breakList == 0 {
            self.error( node, "break outside loop" );
         }
         out.insert( W.br( self.ctx.$depth - breakList[ #breakList ] ) );
         return;
      }
      case Nodes.NodeKind.$Return {
         self.lowerReturn( unwrap node@@@Nodes.ReturnNode, out );
         return;
      }
      case Nodes.NodeKind.$Scope {
         let scopeNode = unwrap node@@@Nodes.ScopeNode;
         // __scope root ( sym ) では、スコープの中に sym と同じ名前の別のシンボルを作るので、
         // 元のシンボルに対応付ける
         foreach symbol in scopeNode.$symbolList {
            if! let aliasSym = scopeNode.$scope.$symbol2SymbolInfoMap[ symbol.$name ] {
               self.symAlias[ aliasSym.getOrg() ] = self.resolveSym( symbol.getOrg() );
            }
         }
         append( out, self.lowerBlock( scopeNode.$block ) );
         return;
      }
      case Nodes.NodeKind.$Import {
         let info = (unwrap node@@@Nodes.ImportNode).$info;
         let! initIndex = self.module2init[ info.$modulePath ] {
            self.error( node, "not found the imported module -- %s" ( info.$modulePath ) );
         };
         // import したモジュールのシンボル (SubPkg など) は、モジュールの型で参照するので値は不要
         if info.$lazy == .Off {
            out.insert( W.call( initIndex, [] ) );
         }
         return;
      }
      case Nodes.NodeKind.$Apply {
         out.insert( self.lowerApply( unwrap node@@@Nodes.ApplyNode ) );
         return;
      }
      case Nodes.NodeKind.$AsyncLock {
         // wasm は 1 スレッドなので、排他は不要
         append( out, self.lowerBlock( (unwrap node@@@Nodes.AsyncLockNode).$block ) );
         return;
      }
      case Nodes.NodeKind.$Block {
         append( out, self.lowerBlock( unwrap node@@@Nodes.BlockNode ) );
         return;
      }
   }
   self.notSupport( node );
}

// ======== 関数 ========

/** 関数を登録し、関数インデックスを返す */
fn convFilter.registerFunc( declInfo:&Nodes.DeclFuncInfo, funcType:&Ast.TypeInfo ) mut : int {
   if! let index = self.func2index[ funcType ] {
      return index;
   }
   let info = self.getFuncCloInfo( funcType );
   let index, _ = self.mod.addFuncWithType( info.$funcType, 1 + #funcType.$argTypeInfoList );
   self.func2index[ funcType ] = index;
   self.mod.setFuncName( index, funcType.getTxt( ## ) );
   return index;
}

/** クロージャが参照する変数 (モジュールレベルの変数を除く) */
fn convFilter.getCaptureSyms( funcType:&Ast.TypeInfo ) : &List<&Ast.SymbolInfo> {
   let mut list:List<&Ast.SymbolInfo> = [];
   if! let scope = funcType.$scope {
      let mut addedSet:Set<&Ast.SymbolInfo> = (@);
      foreach symbol in scope.$closureSymList {
         // __scope root の別名のシンボルは、元のシンボルを捕捉する
         let orgSym = self.resolveSym( symbol.getOrg() );
         if not self.isGlobalSym( orgSym ) and not addedSet.has( orgSym ) {
            addedSet.add( orgSym );
            list.insert( orgSym );
         }
      }
   }
   return list;
}

/** 現在の関数で、クロージャに渡すセルを取得する */
fn convFilter.getCellRef( node:&Nodes.Node, symbol:&Ast.SymbolInfo ) mut : &W.Ins {
   let! loc = self.findLoc( symbol ) {
      self.error( node, "not found closure symbol -- %s" ( symbol.$name ) );
   };
   _match loc {
      case .CellLocal( index ) {
         return lg( index );
      }
      case .Captured( field ) {
         return self.envGet( field );
      }
      case .Local( index ) {
         // セルに入っていない変数は、値をコピーしたセルを渡す
         let rep = self.getRep( symbol.$typeInfo );
         return W.structNew( self.rt.getCellType( rep ), [ lg( index ) ] );
      }
      case .Global( _ ) {
         self.error( node, "global closure symbol -- %s" ( symbol.$name ) );
      }
   }
}

/** 仮引数を局所変数に対応付ける */
fn convFilter.setupParams( declInfo:&Nodes.DeclFuncInfo, funcType:&Ast.TypeInfo,
                           mut body:List<&W.Ins> ) mut
{
   if declInfo.$has__func__Symbol {
      if! let block = declInfo.$body {
         // 本体のスコープから外側に向かって、最初に見つかる __func__
         let mut scope = block.$scope;
         for _ = 1, 3 {
            if! let funcSym = scope.$symbol2SymbolInfoMap[ "__func__" ] {
               if! let name = declInfo.$name {
                  self.funcSym2name[ funcSym ] = name.txt;
               }
               break;
            }
            scope = scope.$parent;
         }
      }
   }
   foreach arg, index in declInfo.$argList {
      if arg.$kind == Nodes.NodeKind.$DeclArgDDD {
         if! let scope = funcType.$scope {
            if! let symbol = scope.$symbol2SymbolInfoMap[ "..." ] {
               self.ctx.$sym2loc[ symbol.getOrg() ] = VarLoc.Local( index );
            }
         }
      }
      if! let argNode = arg@@@Nodes.DeclArgNode {
         let symbol = argNode.$symbolInfo.getOrg();
         if symbol.$hasAccessFromClosure {
            body.insert( self.declareVar( symbol, lg( index ) ) );
         } else {
            self.ctx.$sym2loc[ symbol ] = VarLoc.Local( index );
         }
      }
   }
}

/**
関数の本体を変換する。

@return 関数のクロージャを生成する命令 (現在の関数のコンテキストで評価する)
*/
fn convFilter.compileFunc( node:&Nodes.Node, declInfo:&Nodes.DeclFuncInfo,
                           funcType:&Ast.TypeInfo, funcIndex:int ) mut : &W.Ins
{
   let info = self.getFuncCloInfo( funcType );
   let capSyms = self.getCaptureSyms( funcType );
   let mut envType = -1;
   let cloIns;
   if #capSyms > 0 {
      let mut fields:List<&W.FieldType> = [ W.field( W.typeI32, true ),
                                            W.field( W.refType( info.$funcType ), false ) ];
      let mut vals:List<&W.Ins> = [ W.i32Const( 0 ), self.mod.refFunc( funcIndex ) ];
      foreach symbol in capSyms {
         let cellType = self.rt.getCellType( self.getRep( symbol.$typeInfo ) );
         fields.insert( W.field( W.refType( cellType ), false ) );
         vals.insert( self.getCellRef( node, symbol ) );
      }
      envType = self.mod.addStructType( info.$cloType, fields );
      cloIns = W.structNew( envType, vals );
   } else {
      cloIns = W.structNew( info.$cloType, [ W.i32Const( 0 ), self.mod.refFunc( funcIndex ) ] );
   }
   if self.compiledFuncSet.has( funcIndex ) {
      return cloIns;
   }
   self.compiledFuncSet.add( funcIndex );

   let mut saved = self.ctx;
   let retTypes = self.normType( funcType ).$retTypeInfoList;
   self.ctx = new FuncCtx( self.mod.getFunc( funcIndex ), info.$results, retTypes );
   let mut body:List<&W.Ins> = [];
   if envType >= 0 {
      let envLocal = self.ctx.addLocal( W.refType( envType ) );
      self.ctx.set_envLocal( envLocal );
      self.ctx.set_envType( envType );
      body.insert( ls( envLocal, W.refCast( envType, lg( 0 ) ) ) );
      foreach symbol, index in capSyms {
         self.ctx.$sym2loc[ symbol ] = VarLoc.Captured( index + 1 );
      }
   }
   self.setupParams( declInfo, funcType, body );
   if self.isRunLuaOnLns( funcType ) {
      // Go 版と同じく、Lua 版の LuneScript を使って Lua のコードを実行する
      // 引数: (クロージャ, frontAccessor, luaCode, baseDir, async)
      let args = self.tempLocal( self.rt.$listType );
      let result = self.tempLocal( self.rt.$listType );
      let mess = self.tempLocal( W.typeAnyRef );
      if #self.embedLuaList > 0 {
         body.insert( self.registerEmbedLua() );
      }
      body.insert( ls( args, W.call( self.rt.fnListNew(), [ W.i32Const( 1 ) ] ) ) );
      body.insert( W.call( self.rt.fnListPush(), [ lg( args ), lg( 2 ) ] ) );
      body.insert( ls( result, W.call( self.rt.fnLuaCall(),
                                       [ W.i32Const( Rt.luaRunLuaOnLns ), lg( args ) ] ) ) );
      body.insert( ls( mess, W.call( self.rt.fnListGet(), [ lg( result ), W.i64Const( 2 ) ] ) ) );
      body.insert( W.call( self.rt.fnListGet(), [ lg( result ), W.i64Const( 1 ) ] ) );
      body.insert( W.ifElse( W.refIsNull( lg( mess ) ), [ self.rt.strLiteral( "" ) ],
                             [ W.refCast( self.rt.$tStr, lg( mess ) ) ], self.rt.$strType ) );
   } elseif self.isModuleFunc( funcType, "@lune.@base.@Str", "getLineList" ) {
      // Lua 版は string.gmatch を使うので、Go 版と同じく Lua を使わない処理に置き換える
      body.insert( W.call( self.rt.fnStrLineList(), [ lg( 1 ) ] ) );
   } elseif self.isModuleFunc( funcType, "@lune.@base.@Depend", "getBindLns" ) {
      // Go 版と同じく、埋め込んだ LuneScript のソースを返す
      let mut val:&W.Ins = W.refNull( W.htAny );
      forsort code, mod in self.bindLnsMap {
         val = W.ifElse( W.call( self.rt.fnStrEq(), [ lg( 1 ), self.rt.strLiteral( mod ) ] ),
                         [ self.rt.strLiteral( code ) ], [ val ], W.typeAnyRef );
      }
      body.insert( self.coerce( val, Ast.builtinTypeStem_, retTypes[ 1 ] ) );
   } elseif self.isModuleFunc( funcType, "@lune.@base.@Depend", "getFileLastModifiedTime" ) {
      // Lua 版は stat コマンドを起動するので、Go 版と同じくホストで取得する
      let mtime = self.tempLocal( W.typeF64 );
      body.insert( ls( mtime, W.call( self.rt.fnFileMtime(), [ lg( 1 ) ] ) ) );
      body.insert( self.coerce( W.ifElse( W.plain( W.opF64Ne, [ lg( mtime ), lg( mtime ) ] ),
                                          [ W.refNull( W.htAny ) ],
                                          [ self.rt.boxF64( lg( mtime ) ) ], W.typeAnyRef ),
                                Ast.builtinTypeStem_, retTypes[ 1 ] ) );
   } else {
      if! let block = declInfo.$body {
         append( body, self.lowerBlock( block ) );
      }
      if #retTypes > 0 {
         body.insert( W.unreachable() );
      }
   }
   self.ctx.$func.setBody( body );
   self.ctx = saved;
   return cloIns;
}

/** funcType が、モジュール modName (getFullName の形式) の関数 name かどうか */
fn convFilter.isModuleFunc( funcType:&Ast.TypeInfo, modName:str, name:str ) : bool {
   if funcType.$rawTxt ~= name {
      return false;
   }
   return funcType.getModule().getFullName(
      self.$typeNameCtrl, self.$moduleInfoManager, false ) == modName;
}

/**
埋め込んだ Lua のモジュールを、Lua の package.preload に登録する命令 (最初の 1 回だけ登録する)。

lnsc の起動を遅くしないように、最初にマクロを実行する時 (runLuaOnLns) に登録する。
*/
fn convFilter.registerEmbedLua() mut : &W.Ins {
   if self.embedLuaGlobal < 0 {
      self.embedLuaGlobal = self.mod.addGlobal( W.typeI32, W.i32Const( 0 ) );
   }
   let args = self.tempLocal( self.rt.$listType );
   let mut body:List<&W.Ins> = [ W.globalSet( self.embedLuaGlobal, W.i32Const( 1 ) ) ];
   foreach info in self.embedLuaList {
      body.insert( ls( args, W.call( self.rt.fnListNew(), [ W.i32Const( 3 ) ] ) ) );
      foreach txt in [ info.$mod, info.$code, info.$chunkname ] {
         body.insert( W.call( self.rt.fnListPush(), [ lg( args ), self.rt.strLiteral( txt ) ] ) );
      }
      body.insert( W.drop( W.call( self.rt.fnLuaCall(),
                                   [ W.i32Const( Rt.luaPreload ), lg( args ) ] ) ) );
   }
   return W.ifElse( W.plain( W.opI32Eqz, [ W.globalGet( self.embedLuaGlobal ) ] ), body, nil, nil );
}

/** DependLuaOnLns.runLuaOnLns (マクロの実行) の関数かどうか */
fn convFilter.isRunLuaOnLns( funcType:&Ast.TypeInfo ) : bool {
   return self.isModuleFunc( funcType, "@lune.@base.@DependLuaOnLns", "runLuaOnLns" );
}

/** メソッド・コンストラクタの本体を変換する */
fn convFilter.compileMethod( node:&Nodes.Node, declInfo:&Nodes.DeclFuncInfo,
                             methodType:&Ast.TypeInfo, funcIndex:int, info:&ClassInfo,
                             retReps:&List<&W.ValType> ) mut
{
   if self.compiledFuncSet.has( funcIndex ) {
      return;
   }
   self.compiledFuncSet.add( funcIndex );
   let mut saved = self.ctx;
   self.ctx = new FuncCtx( self.mod.getFunc( funcIndex ), retReps,
                           methodType.$retTypeInfoList );
   let mut body:List<&W.Ins> = [];
   let selfLocal = self.ctx.addLocal( W.refType( info.$structType ) );
   self.ctx.set_selfLocal( selfLocal );
   self.ctx.set_selfClass( info );
   body.insert( ls( selfLocal, W.refCast( info.$structType, lg( 0 ) ) ) );
   if! let scope = methodType.$scope {
      if! let selfSym = scope.$symbol2SymbolInfoMap[ "self" ] {
         let orgSym = selfSym.getOrg();
         if orgSym.$hasAccessFromClosure {
            body.insert( self.declareVar( orgSym, lg( selfLocal ) ) );
         } else {
            self.ctx.$sym2loc[ orgSym ] = VarLoc.Local( selfLocal );
         }
      }
   }
   self.setupParams( declInfo, methodType, body );
   if! let nativeBody = self.getStrBuilderBody( node, methodType, info, selfLocal ) {
      append( body, nativeBody );
   } else {
      if! let block = declInfo.$body {
         append( body, self.lowerBlock( block ) );
      }
      if #retReps > 0 {
         body.insert( W.unreachable() );
      }
   }
   self.ctx.$func.setBody( body );
   self.ctx = saved;
}

/**
Str.Builder のメソッドの場合、Go 版 (strings.Builder) と同じく、
容量に余裕を持たせたバッファで処理する本体を返す。それ以外は nil。

Lua 版は、1000 バイトごとにそれまでの文字列全体を連結し直す。
wasm では、private のフィールド progress にバッファ (Rt.newBuf) を持ち、txt は使わない。
フィールドはメソッドからしか参照しないので、全てのメソッドを置き換える。
*/
fn convFilter.getStrBuilderBody( node:&Nodes.Node, methodType:&Ast.TypeInfo, info:&ClassInfo,
                                 selfLocal:int ) mut : &List<&W.Ins>!
{
   let classType = methodType.$parentInfo;
   if classType.$rawTxt ~= "Builder" or
      classType.getModule().getFullName(
         self.$typeNameCtrl, self.$moduleInfoManager, false ) ~= "@lune.@base.@Str"
   {
      return nil;
   }
   let structType = info.$structType;
   let txtField = self.getFieldIndex( node, info, "txt" );
   let bufField = self.getFieldIndex( node, info, "progress" );
   let buf = W.refCast( self.rt.$tStr, W.structGet( structType, bufField, lg( selfLocal ) ) );
   let setBuf = fn ( val:&W.Ins ) : &W.Ins {
      return W.structSet( structType, bufField, lg( selfLocal ), val );
   };
   switch methodType.$rawTxt {
      case "__init" {
         return [ W.structSet( structType, txtField, lg( selfLocal ), self.rt.strLiteral( "" ) ),
                  setBuf( self.rt.newBuf() ) ];
      }
      case "add" {
         return [ setBuf( W.call( self.rt.fnBufAdd(), [ buf, lg( 1 ) ] ) ) ];
      }
      case "get_txt" {
         return [ W.call( self.rt.fnBufToStr(), [ buf ] ) ];
      }
      case "len" {
         return [ self.rt.bufLenI64( buf ) ];
      }
      case "clear" {
         return [ self.rt.clearBuf( buf ) ];
      }
      case "flush" {
         return [];
      }
   }
   self.error( node, "unknown method of Str.Builder -- %s" (methodType.$rawTxt) );
}

/** メソッドの戻り値の表現 (スロットの関数型に合わせる) */
fn convFilter.getSlotRetReps( info:&ClassInfo, methodType:&Ast.TypeInfo ) mut : &List<&W.ValType> {
   if! let slotIndex = info.$name2slot[ methodType.$rawTxt ] {
      return self.getRepList( info.$slotList[ slotIndex ].$methodType.$retTypeInfoList );
   }
   return self.getRepList( methodType.$retTypeInfoList );
}

/** DeclMethod / DeclConstr の変換 */
fn convFilter.compileMethodNode( node:&Nodes.Node, declInfo:&Nodes.DeclFuncInfo ) mut {
   let! classType = declInfo.$classTypeInfo {
      self.error( node, "no class" );
   };
   let! info = self.getClassInfo( classType ) {
      self.error( node, "not found class -- %s" ( classType.getTxt( ## ) ) );
   };
   let methodType = node.$expType;
   let! funcIndex = self.func2index[ methodType ] {
      if declInfo.$kind == .Ctor {
         self.compileMethod( node, declInfo, methodType, info.$ctorFunc, info, [] );
         return;
      }
      self.error( node, "not found method -- %s" ( methodType.getTxt( ## ) ) );
   };
   if declInfo.$staticFlag {
      self.compileFunc( node, declInfo, methodType, funcIndex );
      return;
   }
   if declInfo.$kind == .Ctor {
      self.compileMethod( node, declInfo, methodType, funcIndex, info, [] );
      return;
   }
   // 実装の関数は、メソッド自身の型で生成している (vtable の型と異なる場合はアダプタを使う)
   self.compileMethod( node, declInfo, methodType, funcIndex, info,
                       self.getRepList( methodType.$retTypeInfoList ) );
}

/** 既定のコンストラクタ (メンバを引数の順に初期化する) */
fn convFilter.compileDefaultCtor( node:&Nodes.DeclClassNode, info:&ClassInfo ) mut {
   if self.compiledFuncSet.has( info.$ctorFunc ) {
      return;
   }
   self.compiledFuncSet.add( info.$ctorFunc );
   let ctorType = self.getCtorType( info.$typeInfo );
   let mut func = self.mod.getFunc( info.$ctorFunc );
   let selfLocal = func.addLocal( W.refType( info.$structType ) );
   let mut body:List<&W.Ins> = [ ls( selfLocal, W.refCast( info.$structType, lg( 0 ) ) ) ];
   let mut superArgNum = 0;
   if! let parent = info.$parent {
      let parentCtorType = self.getCtorType( parent.$typeInfo );
      let mut args:List<&W.Ins> = [ lg( selfLocal ) ];
      foreach argType, index in parentCtorType.$argTypeInfoList {
         if node.$hasOldCtor {
            args.insert( self.getDefaultVal( self.getRep( argType ) ) );
         } else {
            args.insert( lg( index ) );
         }
      }
      body.insert( W.call( parent.$ctorFunc, args ) );
      if not node.$hasOldCtor {
         superArgNum = #parentCtorType.$argTypeInfoList;
      }
   }
   let mut argIndex = superArgNum + 1;
   foreach memberNode in node.$memberList {
      if not memberNode.$staticFlag {
         if argIndex <= #ctorType.$argTypeInfoList {
            let fieldIndex = self.getFieldIndex( node, info, memberNode.$name.txt );
            body.insert( W.structSet(
               info.$structType, fieldIndex, lg( selfLocal ),
               self.coerce( lg( argIndex ), ctorType.$argTypeInfoList[ argIndex ],
                            memberNode.$symbolInfo.$typeInfo ) ) );
         }
         argIndex = argIndex + 1;
      }
   }
   func.setBody( body );
}

/** 自動生成されるアクセッサ (get_xxx / set_xxx) */
fn convFilter.compileAccessors( node:&Nodes.DeclClassNode, info:&ClassInfo ) mut {
   let scope = unwrap info.$typeInfo.$scope;
   foreach memberNode in node.$memberList {
      let member = memberNode.$name.txt;
      if not memberNode.$staticFlag {
         foreach name in [ "get_" .. member, "set_" .. member ] {
            if! let symbol = scope.$symbol2SymbolInfoMap[ name ] {
               let methodType = symbol.$typeInfo;
               if not self.declaredMethodSet.has( methodType ) {
                  if! let funcIndex = self.func2index[ methodType ] {
                     if not self.compiledFuncSet.has( funcIndex ) {
                        self.compiledFuncSet.add( funcIndex );
                        let mut func = self.mod.getFunc( funcIndex );
                        let selfIns = W.refCast( info.$structType, lg( 0 ) );
                        let fieldIndex = self.getFieldIndex( node, info, member );
                        if name.find( "^get_" ## ) {
                           let retReps = self.getRepList( methodType.$retTypeInfoList );
                           func.setBody( [
                              self.coerceRep( W.structGet( info.$structType, fieldIndex, selfIns ),
                                              info.$fieldReps[ fieldIndex - 1 ], retReps[ 1 ] ) ] );
                        } else {
                           func.setBody( [
                              W.structSet( info.$structType, fieldIndex, selfIns,
                                           self.coerceRep(
                                              lg( 1 ),
                                              self.getRep( methodType.$argTypeInfoList[ 1 ] ),
                                              info.$fieldReps[ fieldIndex - 1 ] ) ) ] );
                        }
                     }
                  }
               }
            }
         }
      }
   }
}

/** 引数の index 番目を、rep の表現で返す関数 */
form ArgGetter( index:int, rep:&W.ValType ) : &W.Ins;

/** advertise で委譲するメソッドの本体を生成する */
fn convFilter.compileAdvertise( node:&Nodes.DeclClassNode, info:&ClassInfo ) mut {
   foreach adv in info.$advertiseList {
      if self.compiledFuncSet.has( adv.$impl ) {
         continue;
      }
      self.compiledFuncSet.add( adv.$impl );
      let mut func = self.mod.getFunc( adv.$impl );
      let fieldIndex = self.getFieldIndex( node, info, adv.$memberName );
      let member = W.structGet( info.$structType, fieldIndex,
                                W.refCast( info.$structType, lg( 0 ) ) );
      let argReps = self.getRepList( adv.$methodType.$argTypeInfoList );
      let retReps = self.getSlotRetReps( info, adv.$methodType );
      let ins, _, calleeRetReps = self.callMethodDyn(
         node, member, info.$fieldReps[ fieldIndex - 1 ], adv.$memberType, adv.$methodName,
         fn ( index:int, rep:&W.ValType ) : &W.Ins {
            return self.coerceRep( lg( index ), argReps[ index ], rep );
         }, func );
      let mut body:List<&W.Ins> = [ ins ];
      if #calleeRetReps > 0 {
         let mut locals:List<int> = [];
         foreach rep in calleeRetReps {
            locals.insert( func.addLocal( rep ) );
         }
         for index = #locals, 1, -1 {
            body.insert( ls( locals[ index ], W.nop() ) );
         }
         foreach rep, index in retReps {
            body.insert( self.coerceRep( lg( locals[ index ] ), calleeRetReps[ index ], rep ) );
         }
      }
      func.setBody( body );
   }
}

/**
obj (表現 objRep、型 objType) の name のメソッドを、動的に (vtable / itable で) 呼び出す。

getArg( index, rep ) で、index 番目の引数を rep の表現で返す。
@return 呼び出しの命令、呼び出し先の引数の表現、戻り値の表現
*/
fn convFilter.callMethodDyn( node:&Nodes.Node, obj:&W.Ins, objRep:&W.ValType, objType:&Ast.TypeInfo,
                             name:str, getArg:ArgGetter, mut func:W.Func )
   mut : &W.Ins, &List<&W.ValType>, &List<&W.ValType>
{
   let work = self.getObjType( objType );
   let objLocal = func.addLocal( self.rt.$objType );
   let mut pre:List<&W.Ins> = [ ls( objLocal, self.coerceRep( obj, objRep, self.rt.$objType ) ) ];
   let methodType;
   let mut args:List<&W.Ins> = [];
   let callFuncType;
   let funcRef;
   if work.$kind == .IF {
      let ifInfo = self.getIfInfo( work );
      let! methodIndex = ifInfo.$name2index[ name ] {
         self.error( node, "not found method -- %s" (name) );
      };
      methodType = unwrap self.getIfMethodType( work, name );
      args.insert( lg( objLocal ) );
      callFuncType = ifInfo.$methodFuncTypes[ methodIndex + 1 ];
      let itab = W.refCast(
         ifInfo.$itType,
         W.arrayGet( self.rt.$tAnyArr,
                     W.structGet( self.rt.$tVT, Rt.fVtItabs,
                                  W.structGet( self.rt.$tObj, Rt.fObjVt, lg( objLocal ) ) ),
                     W.i32Const( ifInfo.$ifId ) ) );
      funcRef = W.structGet( ifInfo.$itType, methodIndex, itab );
   } else {
      let! info = self.getClassInfo( work ) {
         self.error( node, "not found class -- %s" ( work.getTxt( ## ) ) );
      };
      let! slotIndex = info.$name2slot[ name ] {
         self.error( node, "not found method -- %s" (name) );
      };
      let slot = info.$slotList[ slotIndex ];
      methodType = slot.$methodType;
      let objWork = func.addLocal( W.refType( info.$structType ) );
      pre.insert( ls( objWork, W.refCast( info.$structType, lg( objLocal ) ) ) );
      args.insert( lg( objWork ) );
      callFuncType = slot.$funcType;
      funcRef = W.structGet( info.$vtType, slotIndex,
                             W.structGet( info.$structType, Rt.fObjVt, lg( objWork ) ) );
   }
   let argReps = self.getRepList( methodType.$argTypeInfoList );
   foreach rep, index in argReps {
      args.insert( getArg( index, rep ) );
   }
   args.insert( funcRef );
   pre.insert( W.callRef( callFuncType, args ) );
   return W.seq( pre ), argReps, self.getRepList( methodType.$retTypeInfoList );
}

fn convFilter.lowerDeclClass( node:&Nodes.DeclClassNode, mut out:List<&W.Ins> ) mut {
   if node.isModule() {
      // Lua のモジュール (module ... require)。Lua 版と同じく、遅延ロードでなければ読み込む。
      // C のグルー (glue) のモジュールは wasm では読み込めないので、宣言の位置では読み込まない
      if node.$lazyLoad == .Off and not node.$gluePrefix {
         if! let modType = self.getExtModuleType( node.$expType ) {
            out.insert( W.drop( self.lowerExtModuleVal( node, modType ) ) );
         }
      }
      return;
   }
   if node.$expType.$kind == .IF {
      self.getIfInfo( node.$expType );
      return;
   }
   let info = self.registerClass( node );
   foreach field in node.$fieldList {
      switch field.$kind {
         case Nodes.NodeKind.$DeclMethod {
            self.compileMethodNode( field, (unwrap field@@@Nodes.DeclMethodNode).$declInfo );
         }
         case Nodes.NodeKind.$DeclConstr {
            self.compileMethodNode( field, (unwrap field@@@Nodes.DeclConstrNode).$declInfo );
         }
      }
   }
   if not node.hasUserInit() {
      self.compileDefaultCtor( node, info );
   }
   self.compileAccessors( node, info );
   self.compileAdvertise( node, info );
   // static メンバの初期化ブロック
   if! let initFunc = node.$initBlock.$func {
      if! let block = initFunc.$declInfo.$body {
         append( out, self.lowerBlock( block ) );
      }
   }
}

/**
インタフェースのメソッドの型 ifMethodType で、implMethodType の実装 impl を呼び出すアダプタを作る。

@return アダプタの関数インデックス
*/
fn convFilter.makeIfAdapter( ifMethodType:&Ast.TypeInfo, implMethodType:&Ast.TypeInfo,
                             impl:int ) mut : int
{
   let ifArgReps = self.getRepList( ifMethodType.$argTypeInfoList );
   let ifRetReps = self.getRepList( ifMethodType.$retTypeInfoList );
   let implArgReps = self.getRepList( implMethodType.$argTypeInfoList );
   let implRetReps = self.getRepList( implMethodType.$retTypeInfoList );
   let mut params:List<&W.ValType> = [ self.rt.$objType ];
   foreach rep in ifArgReps {
      params.insert( rep );
   }
   let index, mut func = self.mod.addFunc( params, ifRetReps );
   let mut args:List<&W.Ins> = [ lg( 0 ) ];
   foreach rep, argIndex in implArgReps {
      args.insert( self.coerceRep( lg( argIndex ), ifArgReps[ argIndex ], rep ) );
   }
   let mut body:List<&W.Ins> = [ W.call( impl, args ) ];
   if #implRetReps > 0 {
      let mut locals:List<int> = [];
      foreach rep in implRetReps {
         locals.insert( func.addLocal( rep ) );
      }
      for retIndex = #locals, 1, -1 {
         body.insert( ls( locals[ retIndex ], W.nop() ) );
      }
      foreach rep, retIndex in ifRetReps {
         body.insert( self.coerceRep( lg( locals[ retIndex ] ), implRetReps[ retIndex ], rep ) );
      }
   }
   func.setBody( body );
   return index;
}

/** vtable と itable を生成する処理を prologue に追加する */
/** 実行時の型の _toMap を呼ぶ関数 (anyref → Map) */
fn convFilter.fnToMapDyn() mut : int {
   if self.toMapDynIndex < 0 {
      let index, _ = self.mod.addFunc( [ W.typeAnyRef ], [ self.rt.$mapType ] );
      self.mod.setFuncName( index, "toMapDyn" );
      self.toMapDynIndex = index;
   }
   return self.toMapDynIndex;
}

/** クラスの継承の深さ */
fn getClassDepth( info:&ClassInfo ) : int {
   let mut depth = 0;
   let mut work = info.$parent;
   while true {
      let! parent = work {
         break;
      };
      depth = depth + 1;
      work = parent.$parent;
   }
   return depth;
}

/**
fnToMapDyn() の本体を生成する。

Mapping を実装するクラスを、派生クラスから順に ref.test で判定し、そのクラスの _toMap を呼ぶ。
*/
fn convFilter.buildToMapDyn() mut {
   let! node = self.toMapDynNode {
      return;
   };
   let mut func = self.mod.getFunc( self.toMapDynIndex );
   let mut body:List<&W.Ins> = [];
   // _toMap の生成でクラスが増えることがあるので、増えなくなるまで繰り返す
   let mut num = -1;
   while num ~= #self.classInfoList {
      num = #self.classInfoList;
      let mut infoList:List<&ClassInfo> = [];
      foreach info in self.classInfoList {
         if info.$typeInfo.$kind == .Class and
            info.$typeInfo.isInheritFrom( self.processInfo, Ast.builtinTypeMapping, nil )
         {
            infoList.insert( info );
         }
      }
      // 深さが同じクラスは、型の番号の順にする
      // (ソートは安定でなく、実装 (Lua 版、wasm 版など) によって順番が変わるので)
      infoList.sort( fn ( info1:&ClassInfo, info2:&ClassInfo ) : bool {
         let depth1 = getClassDepth( info1 );
         let depth2 = getClassDepth( info2 );
         if depth1 ~= depth2 {
            return depth1 > depth2;
         }
         return info1.$structType < info2.$structType;
      } );
      body = [];
      foreach info in infoList {
         body.insert( W.ifElse(
            W.refTest( info.$structType, lg( 0 ) ),
            [ W.ret( [ W.call( self.fnToMap( node, info ),
                               [ W.refCast( info.$structType, lg( 0 ) ) ] ) ] ) ],
            nil, nil ) );
      }
   }
   body.insert( self.rt.error( self.rt.strLiteral( "_toMap: not Mapping object" ) ) );
   func.setBody( body );
}

fn convFilter.finalizeClasses() mut {
   self.buildToMapDyn();
   foreach info in self.classInfoList {
      foreach ifType in info.$ifList {
         self.getIfInfo( ifType );
      }
   }
   foreach info in self.classInfoList {
      let mut itabs:List<&W.Ins> = [];
      foreach ifInfo in self.ifInfoList {
         let mut implemented = false;
         foreach ifType in info.$ifList {
            if ifType == ifInfo.$typeInfo {
               implemented = true;
            }
         }
         if implemented {
            let mut funcs:List<&W.Ins> = [];
            foreach name, index in ifInfo.$methodNames {
               let funcType = ifInfo.$methodFuncTypes[ index ];
               let mut ins:&W.Ins = W.refNull( funcType );
               if! let slotIndex = info.$name2slot[ name ] {
                  let slot = info.$slotList[ slotIndex ];
                  if slot.$impl >= 0 {
                     if slot.$funcType ~= funcType {
                        // generics のインタフェースを具体的な型で実装した場合、
                        // 型パラメータ (anyref) と実装の型 (i64 など) を変換するアダプタを登録する
                        let ifMethodType = unwrap self.getIfMethodType( ifInfo.$typeInfo, name );
                        ins = self.mod.refFunc(
                           self.makeIfAdapter( ifMethodType, slot.$methodType, slot.$impl ) );
                     } else {
                        ins = self.mod.refFunc( slot.$impl );
                     }
                  }
               }
               funcs.insert( ins );
            }
            itabs.insert( W.structNew( ifInfo.$itType, funcs ) );
         } else {
            itabs.insert( W.refNull( W.htAny ) );
         }
      }
      let mut vals:List<&W.Ins> = [ W.arrayNewFixed( self.rt.$tAnyArr, itabs ) ];
      foreach slot in info.$slotList {
         if slot.$impl >= 0 {
            vals.insert( self.mod.refFunc( slot.$impl ) );
         } else {
            vals.insert( W.refNull( slot.$funcType ) );
         }
      }
      self.prologue.insert( W.globalSet( info.$vtGlobal, W.structNew( info.$vtType, vals ) ) );
   }
}

/** クラス・alge・enum の宣言を集める */
fn convFilter.collectDecl( node:&Nodes.Node ) mut {
   let mut alreadySet:Set<&Nodes.Node> = (@);
   node.visit(
      fn ( workNode:&Nodes.Node, parent:&Nodes.Node, relation:str, depth:int )
         : Nodes.NodeVisitMode
      {
         if! let classNode = workNode@@@Nodes.DeclClassNode {
            self.classType2decl[ self.getGenSrc( classNode.$expType ) ] = classNode;
         }
         if! let algeNode = workNode@@@Nodes.DeclAlgeNode {
            self.algeType2decl[ algeNode.$algeType ] = algeNode;
         }
         if! let enumNode = workNode@@@Nodes.DeclEnumNode {
            self.enumType2decl[ enumNode.$enumType ] = enumNode;
         }
         switch workNode.$kind {
            case Nodes.NodeKind.$DeclMethod, Nodes.NodeKind.$ProtoMethod,
               Nodes.NodeKind.$DeclConstr
            {
               self.declaredMethodSet.add( workNode.$expType );
            }
         }
         return .Child;
      }, 0, alreadySet );
}

/** マクロを展開した文 (StmtExp の ExpMacroExp) なら、その ExpMacroExp。それ以外は nil */
fn getMacroExp( stmt:&Nodes.Node ) : &Nodes.ExpMacroExpNode! {
   if! let stmtExp = stmt@@@Nodes.StmtExpNode {
      return stmtExp.$exp@@@Nodes.ExpMacroExpNode;
   }
   return nil;
}

/** モジュールレベルの変数を、グローバル変数として登録する (関数から参照するため) */
fn convFilter.registerModuleVars( node:&Nodes.RootNode ) mut {
   self.registerModuleVarsIn( node.$children );
}
fn convFilter.registerModuleVarsIn( stmtList:&List<&Nodes.Node> ) mut {
   foreach child in stmtList {
      if! let macroNode = getMacroExp( child ) {
         // マクロを展開した文
         self.registerModuleVarsIn( macroNode.$stmtList );
      }
      if! let declNode = child@@@Nodes.DeclVarNode {
         foreach symbol in declNode.$symbolInfoList {
            let orgSym = symbol.getOrg();
            if self.isGlobalSym( orgSym ) {
               let rep = self.getRep( orgSym.$typeInfo );
               self.globalSym2loc[ orgSym ] =
                  VarLoc.Global( self.mod.addGlobal( rep, self.getDefaultVal( rep ) ) );
            }
         }
      }
   }
}

/**
provide しているモジュールを import した場合、モジュールのシンボルを provide しているシンボルに対応付ける。
*/
fn convFilter.registerImportAlias( node:&Nodes.RootNode ) mut {
   foreach child in node.$children {
      if! let importNode = child@@@Nodes.ImportNode {
         let info = importNode.$info;
         if! let provideSym = self.module2provide[ info.$modulePath ] {
            self.symAlias[ info.$symbolInfo.getOrg() ] = provideSym;
         }
         if info.$lazy ~= .Off {
            self.lazySym2module[ info.$symbolInfo.getOrg() ] = info.$modulePath;
         }
      }
   }
}

/**
node が import.l で遅延ロードするモジュールのシンボルなら、モジュールの初期化の呼び出しを返す。

Lua 版と同じく、モジュールは最初にアクセスした時に初期化する (初期化の関数は 2 回目以降は何もしない)。
*/
fn convFilter.getLazyInit( node:&Nodes.Node ) : &W.Ins! {
   let! refNode = node@@@Nodes.ExpRefNode {
      return nil;
   };
   let! modPath = self.lazySym2module[ refNode.$symbolInfo.getOrg() ] {
      return nil;
   };
   if! let initIndex = self.module2init[ modPath ] {
      return W.call( initIndex, [] );
   }
   return nil;
}

/** import したモジュールのシンボルを、provide しているシンボルにする */
fn convFilter.resolveSym( symbol:&Ast.SymbolInfo ) : &Ast.SymbolInfo {
   if! let provideSym = self.symAlias[ symbol ] {
      return provideSym;
   }
   return symbol;
}

/**
import したモジュールを変換する。

モジュールのトップレベルの処理は初期化の関数にし、import 文の位置で呼び出す。
Lua の require と同じく、初期化は最初の 1 回だけ行う。
*/
fn convFilter.lowerImportedModules() mut {
   let mainScope = self.moduleScope;
   let mainType = self.moduleTypeInfo;
   foreach ast in self.importAstList {
      let root = unwrap ast.$node@@@Nodes.RootNode;
      let moduleType = ast.$exportInfo.$moduleTypeInfo;
      self.moduleScope = unwrap moduleType.$scope;
      self.moduleTypeInfo = moduleType;
      self.moduleScopeSet.add( self.moduleScope );
      self.collectDecl( root );
      self.registerModuleVars( root );
      self.registerImportAlias( root );
      if! let provideNode = root.$provideNode@@@Nodes.ProvideNode {
         self.module2provide[ ast.$exportInfo.$fullName ] = provideNode.$symbol.getOrg();
      }

      let initIndex, mut initFunc = self.mod.addFunc( [], [] );
      self.mod.setFuncName( initIndex, "init:" .. ast.$exportInfo.$fullName );
      self.module2init[ ast.$exportInfo.$fullName ] = initIndex;
      let doneGlobal = self.mod.addGlobal( W.typeI32, W.i32Const( 0 ) );

      let mut saved = self.ctx;
      self.ctx = new FuncCtx( initFunc, [], [] );
      let mut body:List<&W.Ins> = [
         W.ifElse( W.globalGet( doneGlobal ), [ W.ret( [] ) ], nil, nil ),
         W.globalSet( doneGlobal, W.i32Const( 1 ) ) ];
      append( body, self.lowerStmtList( root.$children ) );
      initFunc.setBody( body );
      self.ctx = saved;
   }
   self.moduleScope = mainScope;
   self.moduleTypeInfo = mainType;
}

/** dynGetterNameSet に、node で宣言・委譲している getter の名前を追加する */
fn convFilter.collectDynGetters( node:&Nodes.Node ) mut {
   let mut alreadySet:Set<&Nodes.Node> = (@);
   node.visit(
      fn ( workNode:&Nodes.Node, parent:&Nodes.Node, relation:str, depth:int )
         : Nodes.NodeVisitMode
      {
         if! let methodNode = workNode@@@Nodes.DeclMethodNode {
            let name = methodNode.$expType.$rawTxt;
            if name.find( "^get_" ## ) {
               self.dynGetterNameSet.add( name );
            }
         }
         if! let classNode = workNode@@@Nodes.DeclClassNode {
            foreach advertiseInfo in classNode.$advertiseList {
               let memberType = self.getGenSrc( advertiseInfo.$member.$expType );
               foreach mtdName in Ast.getAllMethodName( memberType, .Object ).$list {
                  let name = advertiseInfo.$prefix .. mtdName;
                  if name.find( "^get_" ## ) {
                     self.dynGetterNameSet.add( name );
                  }
               }
            }
         }
         return .Child;
      }, 0, alreadySet );
}

pub override fn convFilter.processRoot( node: &Nodes.RootNode, opt: Opt ) mut
{
   foreach ast in self.importAstList {
      self.collectDynGetters( ast.$node );
   }
   self.collectDynGetters( node );
   self.lowerImportedModules();
   self.collectDecl( node );
   self.registerModuleVars( node );
   self.registerImportAlias( node );
   let mainBody = self.lowerStmtList( node.$children );
   self.finalizeClasses();
   let mut body:List<&W.Ins> = [];
   append( body, self.prologue );
   append( body, mainBody );
   if! let mainSym = self.moduleScope.$symbol2SymbolInfoMap[ "__main" ] {
      // Go 版と同じく、pub fn __main( argList ) : int があれば、
      // コマンドの引数 (先頭は wasm のパス) で呼び出し、戻り値を終了コードにする
      if mainSym.$kind == .Fun and mainSym.$accessMode == .Pub {
         if! let funcIndex = self.func2index[ mainSym.$typeInfo ] {
            body.insert( W.call( self.rt.fnOsExit(),
                                 [ W.call( funcIndex, [ W.refNull( self.rt.$tClo ),
                                                        W.call( self.rt.fnArgList(), [] ) ] ) ] ) );
         }
      }
   }
   let mut mainFunc = self.mod.getFunc( self.mainIndex );
   mainFunc.setBody( body );
   self.mod.exportFunc( "main", self.mainIndex );
   self.rt.finalizeLazyLua();
   self.stream.write( self.mod.encode() );
}

/**
@param importAstList import しているモジュール (間接的なものを含む) の AST。依存される側が先。
   wasm では、これらのモジュールも 1 つの wasm にまとめて出力する。
*/
/**
@param embedLuaList wasm に埋め込む Lua のモジュール (lnsc 自身を変換する場合)
@param bindLnsMap Depend.getBindLns で返す LuneScript のソース (モジュール名 → ソース)
*/
pub fn createFilter( streamName:str, stream:oStream, ast:&AstInfo.ASTInfo,
                     importAstList:&List<&AstInfo.ASTInfo>,
                     embedLuaList:&List<&EmbedLua>, bindLnsMap:&Map<str,str> ) : Nodes.Filter<Opt>
{
   return new convFilter( streamName, stream, ast, importAstList, embedLuaList, bindLnsMap );
}
